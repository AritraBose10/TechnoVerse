// Builds the neighbourhood around Techno India University (EM-4, Sector V, Salt Lake).
// Building outlines and roads come from OpenStreetMap (public/campus.json). The look of the
// university building, its entrance, the railing and the street lamps follows reference photos.
// Everything random uses a fixed seed, so every player gets exactly the same world.
import * as THREE from "three";
import { mergeGeometries } from "/vendor/jsm/utils/BufferGeometryUtils.js";
import { mergeStaticChunks } from "/chunks.js";
import { makeTrees } from "/trees.js";
import { addInstanceCull } from "/instcull.js";
import { buildTIU } from "/tiu.js";
import { buildOpposite } from "/opposite.js";
import { heritageLamps, streetLights } from "/street.js";
import { Sky } from "/vendor/jsm/objects/Sky.js";

const TIU_ID = 134101262; // the university building in OpenStreetMap
const FLOOR = 3.7; // metres per storey
const ROAD_WIDTH = { primary: 10.5, primary_link: 6, secondary: 7, secondary_link: 5.5, tertiary: 7, tertiary_link: 5.5, residential: 6, service: 4.2 };
const WORLD_HALF = 615; // the old map: a square from the Sector V metro station (north) to Meen Bhavan (south). Trees are still scattered only here.

// ---------- small helpers ----------
function seeded(seed) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const signedArea = (pts) => pts.reduce((s, p, i) => s + p[0] * pts[(i + 1) % pts.length][1] - pts[(i + 1) % pts.length][0] * p[1], 0) / 2;
const centroid = (pts) => [pts.reduce((s, p) => s + p[0], 0) / pts.length, pts.reduce((s, p) => s + p[1], 0) / pts.length];
function inPoly(x, z, pts) {
  let inside = false;
  for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
    const [xi, zi] = pts[i];
    const [xj, zj] = pts[j];
    if (zi > z !== zj > z && x < ((xj - xi) * (z - zi)) / (zj - zi) + xi) inside = !inside;
  }
  return inside;
}
function distToSegment(x, z, a, b) {
  const dx = b[0] - a[0];
  const dz = b[1] - a[1];
  const t = Math.max(0, Math.min(1, ((x - a[0]) * dx + (z - a[1]) * dz) / (dx * dx + dz * dz || 1)));
  return Math.hypot(x - a[0] - t * dx, z - a[1] - t * dz);
}
function distToPath(x, z, pts, closed = false) {
  let best = Infinity;
  for (let i = 0; i < pts.length - (closed ? 0 : 1); i++) best = Math.min(best, distToSegment(x, z, pts[i], pts[(i + 1) % pts.length]));
  return best;
}
const yawQuat = (a) => ({ x: 0, y: Math.sin(a / 2), z: 0, w: Math.cos(a / 2) });

export function buildWorld({ RAPIER, scene, world, renderer, campus, makeLabel }) {
  // The map's extent (metres from the university pin) comes from campus.json: a box around the Sector V boundary
  // polygon (tools/sector-v-boundary.json). Without `meta` it is the old 615 m square.
  const WB = campus.meta?.bounds || { xMin: -WORLD_HALF, xMax: WORLD_HALF, zMin: -WORLD_HALF, zMax: WORLD_HALF };
  const inWorld = (x, z, m = 0) => x > WB.xMin + m && x < WB.xMax - m && z > WB.zMin + m && z < WB.zMax - m;
  // Roads, paths and the metro line stop at the edge of the map: a way that leaves the box is
  // cut where it crosses the edge (and may come back in as a second piece).
  {
    const lo = [WB.xMin - 8, WB.zMin - 8];
    const hi = [WB.xMax + 8, WB.zMax + 8];
    const inside = (p) => p[0] >= lo[0] && p[0] <= hi[0] && p[1] >= lo[1] && p[1] <= hi[1];
    // the part of a-b inside the square, or null
    const cut = (a, b) => {
      let t0 = 0;
      let t1 = 1;
      const d = [b[0] - a[0], b[1] - a[1]];
      for (let k = 0; k < 2; k++) {
        for (const sgn of [-1, 1]) {
          const p = -sgn * d[k];
          const q = sgn < 0 ? hi[k] - a[k] : a[k] - lo[k];
          if (Math.abs(p) < 1e-9) {
            if (q < 0) return null;
          } else {
            const t = q / p;
            if (p < 0) t0 = Math.max(t0, t);
            else t1 = Math.min(t1, t);
          }
        }
      }
      if (t0 > t1) return null;
      return [[a[0] + d[0] * t0, a[1] + d[1] * t0], [a[0] + d[0] * t1, a[1] + d[1] * t1]];
    };
    const clip = (way) => {
      if (way.pts.every(inside)) return [way];
      const out = [];
      let cur = null;
      for (let i = 0; i < way.pts.length - 1; i++) {
        const seg = cut(way.pts[i], way.pts[i + 1]);
        if (!seg) {
          cur = null;
          continue;
        }
        if (!cur || Math.hypot(cur[cur.length - 1][0] - seg[0][0], cur[cur.length - 1][1] - seg[0][1]) > 0.01) {
          cur = [seg[0]];
          out.push({ ...way, pts: cur });
        }
        cur.push(seg[1]);
      }
      return out.filter((w) => w.pts.length > 1);
    };
    campus = { ...campus, roads: campus.roads.flatMap(clip), paths: (campus.paths || []).flatMap(clip), rail: (campus.rail || []).flatMap(clip) };
  }
  const rand = seeded(20261114);
  const pick = (list) => list[Math.floor(rand() * list.length)];
  const range = (a, b) => a + rand() * (b - a);
  const maxAniso = renderer.capabilities.getMaxAnisotropy();
  const places = [];
  const props = [];

  // ---------- textures drawn in code ----------
  function texture(w, h, draw, { repeat = true } = {}) {
    const c = document.createElement("canvas");
    c.width = w;
    c.height = h;
    draw(c.getContext("2d"), w, h);
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    if (repeat) t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.anisotropy = maxAniso;
    return t;
  }
  function speckle(g, w, h, count, colors, size = 2) {
    for (let i = 0; i < count; i++) {
      g.fillStyle = colors[(Math.random() * colors.length) | 0];
      g.globalAlpha = 0.15 + Math.random() * 0.35;
      const s = 1 + Math.random() * size;
      g.fillRect(Math.random() * w, Math.random() * h, s, s);
    }
    g.globalAlpha = 1;
  }
  const tex = {
    ground: texture(512, 512, (g, w, h) => {
      g.fillStyle = "#8b8a66";
      g.fillRect(0, 0, w, h);
      speckle(g, w, h, 9000, ["#6f7d4a", "#7c8a52", "#9a9070", "#a59a7a", "#5f6f42"], 5);
    }),
    grass: texture(512, 512, (g, w, h) => {
      g.fillStyle = "#5f8f3e";
      g.fillRect(0, 0, w, h);
      speckle(g, w, h, 12000, ["#4c7a30", "#6fa148", "#7fae52", "#557f36", "#8a9a50"], 3);
    }),
    asphalt: texture(512, 512, (g, w, h) => {
      g.fillStyle = "#4a4c50";
      g.fillRect(0, 0, w, h);
      speckle(g, w, h, 14000, ["#3c3e42", "#5a5c60", "#66686b", "#333538"], 2);
    }),
    // one carriageway, two lanes: u runs across the road, v along it (8 m per tile)
    mainRoad: texture(256, 512, (g, w, h) => {
      g.fillStyle = "#47494d";
      g.fillRect(0, 0, w, h);
      speckle(g, w, h, 9000, ["#3a3c40", "#57595d", "#626467", "#303235"], 2);
      g.fillStyle = "#d9d6c8";
      g.fillRect(8, 0, 5, h);
      g.fillRect(w - 13, 0, 5, h);
      g.fillRect(w / 2 - 3, 0, 6, h * 0.4);
    }),
    paver: texture(256, 256, (g, w, h) => {
      g.fillStyle = "#a79a8c";
      g.fillRect(0, 0, w, h);
      for (let y = 0; y < 8; y++)
        for (let x = 0; x < 8; x++) {
          g.fillStyle = ["#b3a394", "#a3917f", "#b89c8c", "#9c8f84"][(Math.random() * 4) | 0];
          g.fillRect(x * 32 + (y % 2 ? 16 : 0) + 1, y * 32 + 1, 30, 30);
          g.fillRect(x * 32 + (y % 2 ? 16 : 0) + 1 - 256, y * 32 + 1, 30, 30);
        }
      speckle(g, w, h, 2500, ["#7d7268", "#c4b6a6"], 2);
    }),
    // entrance floor: pale grey stone with dark joints, as in the entrance photo
    tile: texture(256, 256, (g, w, h) => {
      g.fillStyle = "#b9b6b0";
      g.fillRect(0, 0, w, h);
      speckle(g, w, h, 3000, ["#a9a6a0", "#c8c5bf", "#9f9c97"], 6);
      g.strokeStyle = "#3d3b39";
      g.lineWidth = 6;
      g.strokeRect(0, 0, w, h);
    }),
    // white wall tiles with round dimples, as on the entrance walls
    perforated: texture(128, 128, (g, w, h) => {
      g.fillStyle = "#ece9e2";
      g.fillRect(0, 0, w, h);
      g.strokeStyle = "#cfcbc2";
      g.lineWidth = 2;
      g.strokeRect(0, 0, w, h);
      for (let y = 0; y < 2; y++)
        for (let x = 0; x < 2; x++) {
          const grad = g.createRadialGradient(x * 64 + 30, y * 64 + 30, 2, x * 64 + 32, y * 64 + 32, 22);
          grad.addColorStop(0, "#c9c5bc");
          grad.addColorStop(1, "#f4f1ea");
          g.fillStyle = grad;
          g.beginPath();
          g.arc(x * 64 + 32, y * 64 + 32, 20, 0, 7);
          g.fill();
        }
    }),
    slats: texture(64, 64, (g, w, h) => {
      g.fillStyle = "#3a1712";
      g.fillRect(0, 0, w, h);
      g.fillStyle = "#7a2f22";
      for (let x = 0; x < w; x += 16) g.fillRect(x, 0, 10, h);
    }),
    brick: texture(256, 256, (g, w, h) => {
      g.fillStyle = "#8a8378";
      g.fillRect(0, 0, w, h);
      for (let y = 0; y < 16; y++)
        for (let x = -1; x < 8; x++) {
          g.fillStyle = ["#a4543a", "#98492f", "#b06246", "#8f4a34"][(Math.random() * 4) | 0];
          g.fillRect(x * 32 + (y % 2 ? 16 : 0) + 1, y * 16 + 1, 30, 14);
        }
    }),
    concrete: texture(256, 256, (g, w, h) => {
      g.fillStyle = "#9c9a94";
      g.fillRect(0, 0, w, h);
      speckle(g, w, h, 5000, ["#8a8882", "#aeaca6", "#7d7b76"], 5);
    }),
    // blue and white railing: one 3 m panel
    fence: texture(256, 128, (g, w, h) => {
      g.clearRect(0, 0, w, h);
      g.fillStyle = "#e9ecee";
      for (let x = 30; x < w; x += 14) g.fillRect(x, 26, 5, h - 30);
      g.fillStyle = "#2f7fc9";
      g.fillRect(0, 22, w, 8);
      g.fillRect(0, h - 22, w, 8);
      g.fillRect(4, 0, 18, h);
      g.fillRect(0, 0, 26, 12);
    }),
  };
  tex.water = texture(256, 256, (g, w, h) => {
    g.fillStyle = "#2f8fa8";
    g.fillRect(0, 0, w, h);
    g.strokeStyle = "rgba(220,245,250,0.35)";
    g.lineWidth = 2;
    for (let i = 0; i < 40; i++) {
      const x = Math.random() * w;
      const y = Math.random() * h;
      g.beginPath();
      g.moveTo(x, y);
      g.quadraticCurveTo(x + 10, y - 5, x + 22, y);
      g.stroke();
    }
    g.fillStyle = "rgba(10,60,80,0.35)"; // lane lines on the pool floor
    for (let x = 30; x < w; x += 64) g.fillRect(x, 0, 4, h);
  });
  tex.mainRoad.repeat.set(1, 1);

  // Building fronts. Each texture is one bay wide and one storey tall.
  function facade(draw) {
    return texture(256, 256, draw);
  }
  function glassGradient(g, x, y, w, h, top, bottom) {
    const grad = g.createLinearGradient(0, y, 0, y + h);
    grad.addColorStop(0, top);
    grad.addColorStop(1, bottom);
    g.fillStyle = grad;
    g.fillRect(x, y, w, h);
  }
  const facades = {
    // white piers with strips of blue-green glass and pale panels (the university's street face)
    tiuStrip: facade((g, w, h) => {
      g.fillStyle = "#f3f2ec";
      g.fillRect(0, 0, w, h);
      for (let i = 0; i < 3; i++) {
        const x = 62 + i * 64;
        glassGradient(g, x, 6, 58, 150, "#4f8fa6", "#7fb4c0");
        g.fillStyle = "#d3e4df";
        g.fillRect(x, 162, 58, 88);
      }
    }),
    // the curved glass corner
    tiuGlass: facade((g, w, h) => {
      g.fillStyle = "#eef0ec";
      g.fillRect(0, 0, w, h);
      for (let i = 0; i < 2; i++) {
        const x = 5 + i * 128;
        glassGradient(g, x, 5, 118, 150, "#4a8aa3", "#7bb0bd");
        g.fillStyle = "#cfe2dd";
        g.fillRect(x, 161, 118, 90);
      }
    }),
    // plain white wall with small windows (the back and side of the university building)
    tiuPlain: facade((g, w, h) => {
      g.fillStyle = "#f1efe8";
      g.fillRect(0, 0, w, h);
      g.fillStyle = "#dedbd2";
      g.fillRect(0, h - 6, w, 6);
      g.fillStyle = "#5b7482";
      g.fillRect(96, 70, 64, 96);
      g.fillStyle = "#e6e3da";
      g.fillRect(126, 70, 4, 96);
    }),
    glassTower: facade((g, w, h) => {
      g.fillStyle = "#2f3b44";
      g.fillRect(0, 0, w, h);
      for (let i = 0; i < 2; i++) glassGradient(g, 6 + i * 126, 6, 118, 190, "#567f99", "#84a9bb");
      g.fillStyle = "#3f5563";
      g.fillRect(6, 200, 244, 50);
    }),
    ribbon: facade((g, w, h) => {
      g.fillStyle = "#d8cfbd";
      g.fillRect(0, 0, w, h);
      glassGradient(g, 0, 60, w, 110, "#44606e", "#6f8d99");
      g.fillStyle = "#c9bfab";
      for (let x = 0; x < w; x += 64) g.fillRect(x, 60, 6, 110);
    }),
    punched: facade((g, w, h) => {
      g.fillStyle = "#cfd3d2";
      g.fillRect(0, 0, w, h);
      g.fillStyle = "#b9bdbc";
      g.fillRect(0, h - 10, w, 10);
      g.fillStyle = "#4d6470";
      g.fillRect(40, 60, 76, 110);
      g.fillRect(150, 60, 76, 110);
      g.fillStyle = "#e3e5e3";
      g.fillRect(132, 150, 40, 26); // an air conditioner
    }),
    // terracotta piers with tall blue glass panels (the EcoCentre tower on Street No. 13)
    terracotta: facade((g, w, h) => {
      g.fillStyle = "#b8664a";
      g.fillRect(0, 0, w, h);
      g.fillStyle = "#a95a40";
      for (let x = 0; x < w; x += 128) g.fillRect(x, 0, 18, h);
      for (let i = 0; i < 2; i++) glassGradient(g, 26 + i * 128, 0, 94, h - 26, "#4d79a6", "#7ea6c6");
      g.fillStyle = "#c98a6c";
      g.fillRect(0, h - 26, w, 26);
    }),
    // plain painted plaster with a small window: low blocks, sheds and shops
    plaster: facade((g, w, h) => {
      g.fillStyle = "#e4dccb";
      g.fillRect(0, 0, w, h);
      speckle(g, w, h, 900, ["#cfc6b3", "#efe8d8", "#bdb4a2"], 4);
      g.fillStyle = "#c8bea9";
      g.fillRect(0, h - 12, w, 12);
      g.fillStyle = "#56656b";
      g.fillRect(88, 78, 80, 84);
      g.fillStyle = "#3b4447";
      g.fillRect(84, 74, 88, 4);
    }),
    // corrugated sheet wall with a door: the single-storey classroom sheds
    shed: facade((g, w, h) => {
      g.fillStyle = "#e6e2d6";
      g.fillRect(0, 0, w, h);
      g.fillStyle = "#cfc9ba";
      for (let x = 0; x < w; x += 12) g.fillRect(x, 0, 4, h);
      g.fillStyle = "#4a5a66";
      g.fillRect(40, 70, 70, 60);
      g.fillStyle = "#6b4a33";
      g.fillRect(150, 60, 56, h - 60);
    }),
    ochre: facade((g, w, h) => {
      g.fillStyle = "#d9b982";
      g.fillRect(0, 0, w, h);
      g.fillStyle = "#c4a46e";
      g.fillRect(0, 0, w, 14);
      g.fillStyle = "#56646a";
      g.fillRect(56, 64, 144, 104);
      g.fillStyle = "#e9dcc0";
      g.fillRect(124, 64, 8, 104);
    }),
  };
  // Windows lit at night: a share of the window bays glow warm, picked by where they are on the
  // building, so each facade has its own pattern of people working late.
  const nightUniform = { value: 0 };
  const lightWindows = (mat) => {
    mat.onBeforeCompile = (sh) => {
      sh.uniforms.uNight = nightUniform;
      sh.vertexShader = sh.vertexShader.replace("#include <common>", "#include <common>\nvarying vec3 vWPos;").replace("#include <begin_vertex>", "#include <begin_vertex>\nvWPos = (modelMatrix * vec4(position, 1.0)).xyz;");
      sh.fragmentShader = sh.fragmentShader
        .replace("#include <common>", "#include <common>\nuniform float uNight;\nvarying vec3 vWPos;")
        .replace(
          "#include <emissivemap_fragment>",
          `#include <emissivemap_fragment>
          if (uNight > 0.01) {
            vec2 cell = floor(vec2(vWPos.x * 0.7 + vWPos.z * 0.7, vWPos.y) / vec2(3.6, 3.3));
            float pick = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453);
            float glassy = smoothstep(0.06, 0.22, diffuseColor.b - diffuseColor.r); // window glass is bluer than the walls
            totalEmissiveRadiance += vec3(1.0, 0.8, 0.52) * step(0.6, pick) * (0.5 + pick) * glassy * uNight * 1.5;
          }`
        );
    };
    return mat;
  };
  let sharedInfill = null;
  const makeInfill = () => {
    const t = tex.brick.clone();
    t.repeat.set(3, 2);
    t.needsUpdate = true;
    return new THREE.MeshStandardMaterial({ map: t, roughness: 1 });
  };
  const wallMat = (map, glassy) => lightWindows(new THREE.MeshStandardMaterial({ map, roughness: glassy ? 0.35 : 0.85, metalness: glassy ? 0.25 : 0, envMapIntensity: glassy ? 1.1 : 0.5 }));
  const mats = {
    tiuStrip: wallMat(facades.tiuStrip, true),
    tiuGlass: wallMat(facades.tiuGlass, true),
    tiuPlain: wallMat(facades.tiuPlain, false),
    glassTower: wallMat(facades.glassTower, true),
    ribbon: wallMat(facades.ribbon, false),
    punched: wallMat(facades.punched, false),
    ochre: wallMat(facades.ochre, false),
    terracotta: wallMat(facades.terracotta, true),
    plaster: wallMat(facades.plaster, false),
    shed: wallMat(facades.shed, false),
    white: new THREE.MeshStandardMaterial({ color: "#f2f0ea", roughness: 0.85 }),
    beige: new THREE.MeshStandardMaterial({ color: "#d9d2c2", roughness: 0.9 }),
    roof: new THREE.MeshStandardMaterial({ color: "#77736c", roughness: 1 }),
    dark: new THREE.MeshStandardMaterial({ color: "#1c2126", roughness: 0.25, metalness: 0.6 }),
    blue: new THREE.MeshStandardMaterial({ color: "#2f7fc9", roughness: 0.6 }),
    concrete: new THREE.MeshStandardMaterial({ map: tex.concrete, roughness: 1 }),
    brick: new THREE.MeshStandardMaterial({ map: tex.brick, roughness: 1 }),
    wood: new THREE.MeshStandardMaterial({ color: "#a8743c", roughness: 0.7 }),
    tank: new THREE.MeshStandardMaterial({ color: "#1d1d1f", roughness: 0.6 }),
  };

  // ---------- sky, haze and light from the sky ----------
  // A physically based sky (sunlight scattered by air and dust): deep blue overhead, pale and
  // hazy toward the horizon, bright around the sun. The same sky lights the scene and is what
  // glass and metal reflect, so everything sits in one consistent light.
  const sky = new Sky();
  sky.scale.setScalar(1500);
  const sunDir = new THREE.Vector3(55, 85, 35).normalize(); // matches the sun light in main.js
  Object.assign(sky.material.uniforms.turbidity, { value: 7.5 }); // Kolkata haze
  Object.assign(sky.material.uniforms.rayleigh, { value: 1.5 });
  Object.assign(sky.material.uniforms.mieCoefficient, { value: 0.008 });
  Object.assign(sky.material.uniforms.mieDirectionalG, { value: 0.82 });
  sky.material.uniforms.sunPosition.value.copy(sunDir);
  const pmrem = new THREE.PMREMGenerator(renderer);
  const skyScene = new THREE.Scene();
  const skyCopy = sky.clone();
  skyCopy.material = sky.material; // one sky, seen directly and as the light on everything
  skyScene.add(skyCopy);
  // the night sky: the city's glow near the horizon fading to deep blue overhead, laid over the
  // (black) scattering sky as the sun goes down
  const nightDome = new THREE.Mesh(
    new THREE.SphereGeometry(1400, 24, 12),
    new THREE.ShaderMaterial({
      side: THREE.BackSide,
      transparent: true,
      depthWrite: false,
      fog: false,
      uniforms: { k: { value: 0 } },
      vertexShader: "varying vec3 d; void main(){ d = normalize(position); gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }",
      fragmentShader: "uniform float k; varying vec3 d; void main(){ float h = clamp(d.y, 0.0, 1.0); vec3 c = mix(vec3(0.20, 0.155, 0.13), vec3(0.018, 0.028, 0.065), pow(h, 0.45)); gl_FragColor = vec4(c * 0.55, k); }",
    })
  );
  nightDome.renderOrder = -1;
  const domeCopy = nightDome.clone();
  skyScene.add(domeCopy);
  let skyTarget = pmrem.fromScene(skyScene, 0, 0.1, 4000);
  scene.environment = skyTarget.texture;
  scene.add(sky, nightDome);
  const haze = new THREE.Color("#b9c6cf");
  scene.background = haze;
  scene.fog = new THREE.FogExp2(haze, 0.0026);
  const skyControl = {
    haze,
    /** dir: unit vector to the sun; night: 0 by day .. 1 at night */
    set(dir, night) {
      sky.material.uniforms.sunPosition.value.copy(dir);
      nightDome.material.uniforms.k.value = night;
    },
    /** the light the sky casts on everything, worked out again (do this only now and then) */
    relight() {
      const old = skyTarget;
      skyTarget = pmrem.fromScene(skyScene, 0, 0.1, 4000);
      scene.environment = skyTarget.texture;
      old.dispose();
    },
  };

  // ---------- geometry helpers ----------
  const solidBox = (w, h, d, x, y, z, yaw = 0) => world.createCollider(RAPIER.ColliderDesc.cuboid(w / 2, h / 2, d / 2).setTranslation(x, y, z).setRotation(yawQuat(yaw)));
  // Static meshes from here are merged into 100 m chunks at the end (see chunks.js).
  const staticMeshes = [];
  function add(mesh, { cast = true, receive = true } = {}) {
    mesh.castShadow = cast;
    mesh.receiveShadow = receive;
    scene.add(mesh);
    staticMeshes.push(mesh);
    return mesh;
  }
  // Flat shape on the ground. `tile` is the size in metres of one texture repeat.
  function flat(pts, y, material, tile = 1) {
    const geo = new THREE.ShapeGeometry(new THREE.Shape(pts.map((p) => new THREE.Vector2(p[0], -p[1]))));
    const uv = geo.attributes.uv;
    for (let i = 0; i < uv.count; i++) uv.setXY(i, uv.getX(i) / tile, uv.getY(i) / tile);
    geo.rotateX(-Math.PI / 2);
    const m = new THREE.Mesh(geo, material);
    m.position.y = y;
    return add(m, { cast: false });
  }
  // A strip that follows a path: roads and footpaths.
  function ribbon(pts, width, y, material, tileLength) {
    const pos = [];
    const uv = [];
    const idx = [];
    let along = 0;
    for (let i = 0; i < pts.length; i++) {
      const a = pts[Math.max(0, i - 1)];
      const b = pts[Math.min(pts.length - 1, i + 1)];
      const len = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
      const nx = -(b[1] - a[1]) / len;
      const nz = (b[0] - a[0]) / len;
      if (i > 0) along += Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
      pos.push(pts[i][0] + (nx * width) / 2, y, pts[i][1] + (nz * width) / 2, pts[i][0] - (nx * width) / 2, y, pts[i][1] - (nz * width) / 2);
      uv.push(0, along / tileLength, 1, along / tileLength);
      if (i > 0) idx.push(i * 2 - 2, i * 2, i * 2 - 1, i * 2 - 1, i * 2, i * 2 + 1); // wound to face up
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
    geo.setAttribute("uv", new THREE.Float32BufferAttribute(uv, 2));
    geo.setIndex(idx);
    geo.computeVertexNormals();
    const m = new THREE.Mesh(geo, material);
    return add(m, { cast: false });
  }
  // Collects wall panels, then makes one mesh per material.
  const wallBatches = new Map();
  function wall(a, b, y0, y1, material, bay = 4, storey = FLOOR, nx = 0, nz = 0) {
    // one batch per material per 100 m cell: a single mesh for the whole map is never culled (it is always in view)
    const key = material.uuid + "|" + Math.floor((a[0] + b[0]) / 200) + "|" + Math.floor((a[1] + b[1]) / 200);
    let batch = wallBatches.get(key);
    if (!batch) wallBatches.set(key, (batch = { material, pos: [], uv: [], nor: [] }));
    const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
    const u = Math.max(1, Math.round(len / bay));
    const v = Math.max(1, Math.round((y1 - y0) / storey));
    batch.pos.push(a[0], y0, a[1], b[0], y1, b[1], b[0], y0, b[1], a[0], y0, a[1], a[0], y1, a[1], b[0], y1, b[1]);
    batch.uv.push(0, 0, u, v, u, 0, 0, 0, 0, v, u, v);
    for (let i = 0; i < 6; i++) batch.nor.push(nx, 0, nz);
  }
  function flushWalls() {
    for (const b of wallBatches.values()) {
      const geo = new THREE.BufferGeometry();
      geo.setAttribute("position", new THREE.Float32BufferAttribute(b.pos, 3));
      geo.setAttribute("uv", new THREE.Float32BufferAttribute(b.uv, 2));
      geo.setAttribute("normal", new THREE.Float32BufferAttribute(b.nor, 3));
      add(new THREE.Mesh(geo, b.material));
    }
  }
  // Outline wound so that (dz, -dx) of each edge points out of the building.
  const outward = (pts) => (signedArea(pts) > 0 ? pts : [...pts].reverse());
  function edgesOf(pts) {
    return pts.map((a, i) => {
      const b = pts[(i + 1) % pts.length];
      const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
      return { a, b, len, nx: (b[1] - a[1]) / len, nz: -(b[0] - a[0]) / len };
    });
  }
  function edgeCollider(e, height, inset = 0.4) {
    const yaw = Math.atan2(-(e.b[1] - e.a[1]), e.b[0] - e.a[0]);
    solidBox(e.len, height, inset * 2, (e.a[0] + e.b[0]) / 2 - e.nx * inset, height / 2, (e.a[1] + e.b[1]) / 2 - e.nz * inset, yaw);
  }

  // ---------- ground ----------
  const GW = WB.xMax - WB.xMin + 2200; // the map's box plus 1.1 km all round, as before (2800 m around a 600 m map)
  const GD = WB.zMax - WB.zMin + 2200;
  tex.ground.repeat.set(GW / 10, GD / 10);
  const ground = new THREE.Mesh(new THREE.PlaneGeometry(GW, GD), new THREE.MeshStandardMaterial({ map: tex.ground, roughness: 1 }));
  ground.rotation.x = -Math.PI / 2;
  ground.position.set((WB.xMin + WB.xMax) / 2, 0, (WB.zMin + WB.zMax) / 2);
  add(ground, { cast: false });
  // The walkable ground is a grid of slabs: one huge slab makes collision checks imprecise.
  const SLAB = WB.xMax - WB.xMin > 1500 ? 100 : 50; // a long map would need thousands of 50 m slabs
  for (let gx = WB.xMin - 5; gx < WB.xMax + 5; gx += SLAB) for (let gz = WB.zMin - 5; gz < WB.zMax + 5; gz += SLAB) solidBox(SLAB, 2, SLAB, gx + SLAB / 2, -1, gz + SLAB / 2);
  const wx = (WB.xMin + WB.xMax) / 2, wz = (WB.zMin + WB.zMax) / 2, ww = WB.xMax - WB.xMin + 10, wd = WB.zMax - WB.zMin + 10;
  for (const [x, z, w, d] of [[wx, WB.zMin, ww, 2], [wx, WB.zMax, ww, 2], [WB.xMin, wz, 2, wd], [WB.xMax, wz, 2, wd]]) solidBox(w, 40, d, x, 20, z);

  const layer = (map, offset, extra = {}) => new THREE.MeshStandardMaterial({ map, roughness: 1, polygonOffset: true, polygonOffsetFactor: -offset, polygonOffsetUnits: -offset, ...extra });
  const grassMat = layer(tex.grass, 1);
  for (const g of campus.grass) flat(g.pts, 0.02, grassMat, 6);
  const pitchLines = new THREE.LineBasicMaterial({ color: "#f4f4f0" });
  for (const p of campus.pitches) {
    flat(p.pts, 0.03, layer(tex.grass, 2, { color: "#b9e0a0" }), 5);
    const c = centroid(p.pts);
    const ring = [...p.pts, p.pts[0]].map(([x, z]) => new THREE.Vector3(c[0] + (x - c[0]) * 0.94, 0.08, c[1] + (z - c[1]) * 0.94));
    scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(ring), pitchLines));
  }
  if (campus.pitches.length) {
    const c = centroid(campus.pitches[campus.pitches.length - 1].pts);
    places.push({ name: "Sports ground", x: c[0], z: c[1] });
  }

  // ---------- roads ----------
  const mainRoads = campus.roads.filter((r) => ["primary", "secondary", "secondary_link", "tertiary"].includes(r.kind));
  const paverMat = layer(tex.paver, 3);
  const mainRoadMat = layer(tex.mainRoad, 6);
  const laneMat = layer(tex.asphalt, 5);
  for (const r of mainRoads) if (r.pts.length > 1) ribbon(r.pts, ROAD_WIDTH[r.kind] + 4.4, 0.006, paverMat, 3);
  for (const r of campus.roads) {
    if (r.pts.length < 2) continue;
    const width = ROAD_WIDTH[r.kind] || 3.5;
    if (r.kind === "secondary" || r.kind === "primary" || r.kind === "tertiary") ribbon(r.pts, width, 0.014, mainRoadMat, 8);
    else ribbon(r.pts, width, 0.01, laneMat, 6);
  }
  const roadClear = (x, z, margin) => campus.roads.every((r) => r.pts.length < 2 || distToPath(x, z, r.pts) > (ROAD_WIDTH[r.kind] || 3.5) / 2 + margin);

  // ---------- the university complex (see tiu.js) ----------
  const tiu = campus.buildings.find((b) => b.id === TIU_ID);
  const tiuPts = outward(tiu.pts);
  const front = edgesOf(tiuPts).filter((e) => e.nx > 0.5).sort((a, b) => b.len - a.len)[0]; // the long face on the main road
  const mid = [(front.a[0] + front.b[0]) / 2, (front.a[1] + front.b[1]) / 2];
  const phi = Math.atan2(front.nx, front.nz); // turn that points local +z out of the entrance
  const cosP = Math.cos(phi);
  const sinP = Math.sin(phi);
  // "Local" positions are measured from the middle of the street face: x along the face, z out toward the road.
  const local = (x, z) => [mid[0] + x * cosP + z * sinP, mid[1] - x * sinP + z * cosP];
  const toLocal = (wx, wz) => [(wx - mid[0]) * cosP - (wz - mid[1]) * sinP, (wx - mid[0]) * sinP + (wz - mid[1]) * cosP];
  const tiuModel = buildTIU({ RAPIER, world, scene, renderer, mid, phi, places });
  const tiuHeight = tiuModel.height;
  const FENCE_Z = tiuModel.fenceZ;
  const stripEnd = tiuModel.stripEnd;
  const beds = tiuModel.beds;

  // ---------- raised painted kerb along both sides of the main roads ----------
  // Granite-style kerbstones, 2.4 m each, half black and half white, 14 cm high at the outer edge of the pavement strip
  // (the painted band in look.js sits right under them). Skipped across side roads and in front of the university,
  // which has its own pavement.
  {
    const kerbTexM = texture(128, 32, (g, w, h) => {
      g.fillStyle = "#e8e6de";
      g.fillRect(0, 0, w, h);
      g.fillStyle = "#1d1d1f";
      g.fillRect(0, 0, w / 2, h);
      speckle(g, w, h, 600, ["rgba(120,110,95,0.3)", "rgba(255,255,255,0.22)", "rgba(30,30,30,0.25)"], 2);
    });
    kerbTexM.repeat.set(2, 1); // 2.4 m stones carry two black/white pairs: half the instances of 1.2 m ones
    const kerbGeo = new THREE.BoxGeometry(2.4, 0.14, 0.3);
    const kerbMatM = new THREE.MeshStandardMaterial({ map: kerbTexM, roughness: 0.8 });
    const spotsK = [];
    // a grid of road segments, so "does a side road cross here?" costs a few tests per kerbstone instead of one per road on the map
    const KC = 16, kgrid = new Map();
    for (const r of campus.roads) {
      if (r.pts.length < 2) continue;
      const hw = (ROAD_WIDTH[r.kind] || 3.5) / 2 + 1.4;
      for (let i = 0; i < r.pts.length - 1; i++) {
        const a = r.pts[i], b = r.pts[i + 1];
        const x0 = Math.floor((Math.min(a[0], b[0]) - hw) / KC), x1 = Math.floor((Math.max(a[0], b[0]) + hw) / KC);
        const z0 = Math.floor((Math.min(a[1], b[1]) - hw) / KC), z1 = Math.floor((Math.max(a[1], b[1]) + hw) / KC);
        for (let xi = x0; xi <= x1; xi++) for (let zj = z0; zj <= z1; zj++) {
          const k = xi * 100003 + zj;
          let l = kgrid.get(k);
          if (!l) kgrid.set(k, (l = []));
          l.push(a, b, hw);
        }
      }
    }
    const crossed = (x, z) => {
      const l = kgrid.get(Math.floor(x / KC) * 100003 + Math.floor(z / KC));
      if (!l) return false;
      for (let q = 0; q < l.length; q += 3) {
        const a = l[q], b = l[q + 1], dx = b[0] - a[0], dz = b[1] - a[1];
        const t = Math.max(0, Math.min(1, ((x - a[0]) * dx + (z - a[1]) * dz) / (dx * dx + dz * dz || 1)));
        if (Math.hypot(x - a[0] - dx * t, z - a[1] - dz * t) < l[q + 2]) return true;
      }
      return false;
    };
    for (const r of mainRoads) {
      if (r.pts.length < 2) continue;
      const half = (ROAD_WIDTH[r.kind] + 4.4) / 2 - 0.15;
      for (let i = 0; i < r.pts.length - 1; i++) {
        const a = r.pts[i], b = r.pts[i + 1];
        const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
        if (len < 1) continue;
        const ux = (b[0] - a[0]) / len, uz = (b[1] - a[1]) / len;
        for (let d = 1.2; d < len - 0.6; d += 2.4) {
          for (const sg of [-1, 1]) {
            const x = a[0] + ux * d + (-uz) * half * sg;
            const z = a[1] + uz * d + ux * half * sg;
            if (!inWorld(x, z, 4) || Math.abs(x - mid[0]) > 1100 || Math.abs(z - mid[1]) > 1100 || crossed(x, z)) continue; // 1.1 km round the university: every kerbstone in the 8 km map was 94,000 instances
            const [lx, lz] = toLocal(x, z);
            if (Math.abs(lx) < stripEnd + 14 && lz > -14 && lz < FENCE_Z + 8) continue; // the university has its own pavement
            if (lx > -592 && lx < 133 && lz > 9 && lz < 26) continue; // the median street in front of it
            spotsK.push({ x, z, yaw: Math.atan2(-uz, ux) });
          }
        }
      }
    }
    if (spotsK.length) {
      const imK = new THREE.InstancedMesh(kerbGeo, kerbMatM, spotsK.length);
      const dm = new THREE.Object3D();
      spotsK.forEach((sp, i) => {
        dm.position.set(sp.x, 0.07, sp.z);
        dm.rotation.set(0, sp.yaw, 0);
        dm.updateMatrix();
        imK.setMatrixAt(i, dm.matrix);
      });
      imK.castShadow = false;
      imK.receiveShadow = true;
      scene.add(imK);
      addInstanceCull(imK, spotsK.map((q) => q.x), spotsK.map((q) => q.z), { radius: 2.4, cy: 0.1, maxDist: 160, nearDist: 20 });
    }
  }

  // ---------- other buildings ----------
  // Floors, facade and roof colour come from the map data where they are known (OpenStreetMap
  // tags or the street-level survey in tools/survey.json). Otherwise they are guessed from the
  // size of the footprint: in this part of Salt Lake small outlines are sheds, stalls and houses,
  // and only the large office plots carry glass towers.
  const styles = {
    glassTower: { mat: mats.glassTower, bay: 3.6 },
    ribbon: { mat: mats.ribbon, bay: 4 },
    punched: { mat: mats.punched, bay: 4 },
    ochre: { mat: mats.ochre, bay: 4 },
    terracotta: { mat: mats.terracotta, bay: 3.6 },
    plaster: { mat: mats.plaster, bay: 4 },
    sheds: { mat: mats.shed, bay: 4 },
  };
  const roofMats = new Map();
  const roofMat = (color) => {
    if (!color) return mats.roof;
    if (!roofMats.has(color)) roofMats.set(color, new THREE.MeshStandardMaterial({ color, roughness: 0.9 }));
    return roofMats.get(color);
  };
  function guess(b) {
    const a = b.area || Math.abs(signedArea(b.pts));
    if (/office|pwc|ibm|tcs|wipro|tower|tech park|it park|millen/i.test(b.name || "")) return { floors: Math.round(range(9, 14)), style: "glassTower" };
    if (a < 60) return { floors: 1, style: "plaster" };
    if (a < 180) return { floors: Math.round(range(1, 2)), style: "plaster" };
    if (a < 500) return { floors: Math.round(range(2, 4)), style: pick(["plaster", "ochre", "punched"]) };
    if (a < 1500) return { floors: Math.round(range(3, 6)), style: pick(["punched", "ochre", "ribbon"]) };
    const st = pick(["ribbon", "glassTower", "glassTower", "punched"]);
    return { floors: Math.round(st === "glassTower" ? range(8, 14) : range(5, 9)), style: st };
  }
  // A row of single-storey classrooms with red pitched roofs, filling the outline.
  function shedRow(pts, roofColor) {
    const e = edgesOf(pts).sort((p, q) => q.len - p.len)[0];
    const ux = (e.b[0] - e.a[0]) / e.len;
    const uz = (e.b[1] - e.a[1]) / e.len;
    const along = pts.map((p) => p[0] * ux + p[1] * uz);
    const across = pts.map((p) => -p[0] * uz + p[1] * ux);
    const [a0, a1, c0, c1] = [Math.min(...along), Math.max(...along), Math.min(...across), Math.max(...across)];
    const at = (s, t) => [s * ux - t * uz, s * uz + t * ux];
    const yaw = Math.atan2(-uz, ux);
    const red = roofMat(roofColor || "#a63a2a");
    const cols = Math.max(1, Math.round((a1 - a0) / 11));
    const rows = Math.max(1, Math.round((c1 - c0) / 9));
    const cw = (a1 - a0) / cols;
    const rw = (c1 - c0) / rows;
    for (let i = 0; i < cols; i++)
      for (let j = 0; j < rows; j++) {
        const [x, z] = at(a0 + (i + 0.5) * cw, c0 + (j + 0.5) * rw);
        if (!inPoly(x, z, pts)) continue;
        const w = cw - 1.2;
        const d = rw - 1.6;
        const body = new THREE.Mesh(new THREE.BoxGeometry(w, 3.4, d), mats.shed);
        body.position.set(x, 1.7, z);
        body.rotation.y = yaw;
        add(body);
        // gable roof: a prism along the shed's length
        const roofShape = new THREE.Shape([new THREE.Vector2(-d / 2 - 0.4, 0), new THREE.Vector2(d / 2 + 0.4, 0), new THREE.Vector2(0, 1.5)]);
        const roofGeo = new THREE.ExtrudeGeometry(roofShape, { depth: w + 0.6, bevelEnabled: false });
        roofGeo.translate(0, 0, -(w + 0.6) / 2);
        roofGeo.rotateY(Math.PI / 2);
        const roof = new THREE.Mesh(roofGeo, red);
        roof.position.set(x, 3.4, z);
        roof.rotation.y = yaw;
        add(roof);
        solidBox(w, 4.9, d, x, 2.45, z, yaw);
      }
  }
  // A name board fixed to the wall that faces the nearest road, as the real signs are.
  function nameSign(name, pts, h) {
    const edges = edgesOf(pts).filter((e) => e.len >= 4);
    if (!edges.length) return;
    const roadDist = (e) => {
      const x = (e.a[0] + e.b[0]) / 2 + e.nx * 3;
      const z = (e.a[1] + e.b[1]) / 2 + e.nz * 3;
      return Math.min(...campus.roads.filter((r) => r.pts.length > 1).map((r) => distToPath(x, z, r.pts)));
    };
    const e = edges.reduce((best, f) => (roadDist(f) < roadDist(best) ? f : best));
    const size = 56;
    const c = document.createElement("canvas");
    const g = c.getContext("2d");
    const font = `700 ${size}px system-ui, sans-serif`;
    g.font = font;
    c.width = Math.ceil(g.measureText(name).width) + size * 1.2;
    c.height = Math.ceil(size * 1.7);
    g.font = font;
    g.fillStyle = "#13233f";
    g.fillRect(0, 0, c.width, c.height);
    g.strokeStyle = "#d8b45a";
    g.lineWidth = 6;
    g.strokeRect(3, 3, c.width - 6, c.height - 6);
    g.fillStyle = "#f6f1e3";
    g.textAlign = "center";
    g.textBaseline = "middle";
    g.fillText(name, c.width / 2, c.height / 2 + 2);
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    t.anisotropy = maxAniso;
    const boardH = 1.1;
    let boardW = (boardH * c.width) / c.height;
    const scale = Math.min(1, (e.len * 0.9) / boardW);
    boardW *= scale;
    const sign = new THREE.Mesh(new THREE.PlaneGeometry(boardW, boardH * scale), new THREE.MeshStandardMaterial({ map: t, roughness: 0.6 }));
    sign.position.set((e.a[0] + e.b[0]) / 2 + e.nx * 0.08, Math.min(h - 0.8, 6.5), (e.a[1] + e.b[1]) / 2 + e.nz * 0.08);
    sign.rotation.y = Math.atan2(e.nx, e.nz);
    add(sign, { cast: false });
  }
  // ~1,000 named buildings: a board each is a mesh, material and texture apiece, so build it only when the player is near
  const pendingSigns = [];
  function lazySign(name, pts, h) {
    const c = centroid(pts);
    pendingSigns.push({ x: c[0], z: c[1], name, pts, h });
  }
  function updateSigns(px, pz, range = 300) {
    for (let i = pendingSigns.length - 1; i >= 0; i--) {
      const s = pendingSigns[i];
      if (Math.hypot(s.x - px, s.z - pz) > range) continue;
      pendingSigns.splice(i, 1);
      nameSign(s.name, s.pts, s.h);
    }
  }
  const footprints = [tiuPts, tiuModel.footprint];
  // All 11 approved T-007 Landmarks replaced by faithful GLB models
  const LANDMARKS = new Set([535333512, 193308962, 134101085, "ov332", "ov582", 382403604, "sv4", "ov240", 238285653, "ov359", "ov325"].map(String));
  for (const b of campus.buildings) {
    if (b.id === TIU_ID || LANDMARKS.has(String(b.id))) continue;
    const pts = outward(b.pts);
    footprints.push(pts);
    if (b.style === "sheds") {
      shedRow(pts, b.roof);
      if (b.name) {
        lazySign(b.name, pts, 3.6);
        const c = centroid(pts);
        places.push({ name: b.name, x: c[0], z: c[1] });
      }
      continue;
    }
    const g = guess(b);
    const style = styles[b.style] || styles[g.style];
    const floors = b.floors || g.floors;
    const storey = floors === 1 ? 3.4 : FLOOR;
    const h = floors * storey;
    const parapet = floors <= 2 ? 0.6 : 1;
    for (const e of edgesOf(pts)) {
      if (e.len < 0.5) continue;
      wall(e.a, e.b, 0, h, style.mat, style.bay, storey, e.nx, e.nz);
      wall(e.a, e.b, h, h + parapet, floors <= 2 ? mats.white : mats.beige, 4, parapet, e.nx, e.nz);
      edgeCollider(e, h, Math.min(0.4, Math.sqrt(b.area || 100) / 10));
    }
    flat(pts, h + 0.1, roofMat(b.roof), 4);
    const c = centroid(pts);
    // black rooftop water tanks, as on nearly every roof here
    const tanks = floors >= 2 ? Math.min(3, Math.ceil((b.area || 200) / 600)) : 0;
    for (let i = 0; i < tanks; i++) {
      const spread = Math.min(4, Math.sqrt(b.area || 100) / 5);
      const tx = c[0] + range(-spread, spread);
      const tz = c[1] + range(-spread, spread);
      if (!inPoly(tx, tz, pts)) continue;
      const tank = new THREE.Mesh(new THREE.CylinderGeometry(1.1, 1.1, 1.8, 12), mats.tank);
      tank.position.set(tx, h + 1, tz);
      add(tank);
    }
    // lift/stair head and AC condensers on the roof of anything of some size
    if (floors >= 3 && (b.area || 200) > 150) {
      const lw = Math.min(5, Math.sqrt(b.area || 100) / 4), lx2 = c[0] + range(-1, 1) * lw * 0.6, lz2 = c[1] + range(-1, 1) * lw * 0.6;
      if (inPoly(lx2, lz2, pts) && inPoly(lx2 + lw / 2, lz2 + lw / 2, pts) && inPoly(lx2 - lw / 2, lz2 - lw / 2, pts)) {
        const head = new THREE.Mesh(new THREE.BoxGeometry(lw, 2.6, lw * 0.8), mats.beige);
        head.position.set(lx2, h + 1.4, lz2);
        add(head);
        const cap = new THREE.Mesh(new THREE.BoxGeometry(lw + 0.3, 0.2, lw * 0.8 + 0.3), mats.white);
        cap.position.set(lx2, h + 2.8, lz2);
        add(cap);
      }
      for (let k = 0; k < Math.min(4, floors); k++) {
        const ax = c[0] + range(-1, 1) * Math.sqrt(b.area || 100) / 3.2, az = c[1] + range(-1, 1) * Math.sqrt(b.area || 100) / 3.2;
        if (!inPoly(ax, az, pts) || !inPoly(ax + 0.9, az + 0.6, pts)) continue;
        const ac = new THREE.Mesh(new THREE.BoxGeometry(1.8, 1.1, 1.2), mats.concrete);
        ac.position.set(ax, h + 0.65, az);
        add(ac, { cast: false });
      }
    }
    if (b.name) {
      lazySign(b.name, pts, h);
      if (floors >= 8) {
        // landmark towers also carry their name on the roof, readable from a distance
        const label = makeLabel(b.name, { height: 2.4 });
        label.position.set(c[0], h + 5, c[1]);
        scene.add(label);
      }
      places.push({ name: b.name, x: c[0], z: c[1] });
    }
  }

  // ---------- swimming pool ----------
  for (const w of campus.water || []) {
    const pts = outward(w.pts);
    // stone deck a little wider than the water, the water just below it, and a railing round it
    const deck = pts.map(([x, z]) => {
      const c = centroid(pts);
      const d = Math.hypot(x - c[0], z - c[1]) || 1;
      return [x + ((x - c[0]) / d) * 1.6, z + ((z - c[1]) / d) * 1.6];
    });
    flat(deck, 0.12, layer(tex.tile, 3, { color: "#e8e3d8" }), 2);
    flat(pts, 0.14, layer(tex.water, 4, { roughness: 0.15, metalness: 0.1, envMapIntensity: 1.2 }), 6);
    for (const e of edgesOf(deck)) {
      const geo = new THREE.BoxGeometry(e.len, 0.06, 0.06);
      for (const y of [0.55, 1.05]) {
        const rail = new THREE.Mesh(geo, mats.white);
        rail.position.set((e.a[0] + e.b[0]) / 2, y, (e.a[1] + e.b[1]) / 2);
        rail.rotation.y = Math.atan2(-(e.b[1] - e.a[1]), e.b[0] - e.a[0]);
        add(rail);
      }
      for (let t = 0; t <= e.len; t += 2) {
        const post = new THREE.Mesh(new THREE.BoxGeometry(0.06, 1.1, 0.06), mats.white);
        post.position.set(e.a[0] + (e.b[0] - e.a[0]) * (t / e.len), 0.55, e.a[1] + (e.b[1] - e.a[1]) * (t / e.len));
        add(post);
      }
      edgeCollider(e, 1.1, 0.05);
    }
    footprints.push(deck);
    if (w.name) places.push({ name: w.name, x: centroid(pts)[0], z: centroid(pts)[1] });
  }
  for (const l of campus.labels) if (!/^techno india university$/i.test(l.name)) places.push({ name: l.name, x: l.x, z: l.z });

  // Far-off blocks so the horizon is not empty. Purely scenery.
  for (let i = 0; i < 70; i++) {
    const a = rand() * Math.PI * 2;
    const r = range(290, 520);
    const w = range(24, 60);
    const d = range(24, 60);
    const h = Math.round(range(4, 16)) * FLOOR;
    const x = Math.sin(a) * r;
    const z = Math.cos(a) * r;
    const style = pick([styles.glassTower, styles.ribbon, styles.punched, styles.ochre, styles.terracotta]);
    const corners = [[x - w / 2, z - d / 2], [x + w / 2, z - d / 2], [x + w / 2, z + d / 2], [x - w / 2, z + d / 2]];
    for (const e of edgesOf(outward(corners))) wall(e.a, e.b, 0, h, style.mat, style.bay, FLOOR, e.nx, e.nz);
    flat(corners, h, mats.roof, 4);
  }

  // ---------- building under construction next door ----------
  const nearEntrance = (x, z, margin = 0) => {
    const [lx, lz] = toLocal(x, z);
    return Math.abs(lx) < stripEnd + 2 + margin && lz > -12 && lz < FENCE_Z + 3 + margin;
  };
  const freeSpot = (x, z, r) => roadClear(x, z, r) && footprints.every((f) => !inPoly(x, z, f) && distToPath(x, z, f, true) > r) && !nearEntrance(x, z, r);
  {
    const options = [];
    for (const site of campus.construction) {
      const c = centroid(site.pts);
      for (let i = 0; i < 400; i++) {
        const x = c[0] + range(-80, 80);
        const z = c[1] + range(-70, 70);
        if (inPoly(x, z, site.pts) && freeSpot(x, z, 17)) options.push([x, z]);
      }
    }
    options.sort((a, b) => Math.hypot(a[0] - mid[0], a[1] - mid[1]) - Math.hypot(b[0] - mid[0], b[1] - mid[1]));
    const spot = options[0];
    if (spot) {
      const site = new THREE.Group();
      site.position.set(spot[0], 0, spot[1]);
      site.rotation.y = phi;
      scene.add(site);
      const part = (w, h, d, x, y, z, material) => {
        const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), material);
        m.position.set(x, y, z);
        m.castShadow = m.receiveShadow = true;
        site.add(m);
      };
      const W = 24;
      const D = 16;
      const levels = 5;
      for (let l = 1; l <= levels; l++) part(W, 0.3, D, 0, l * 3.6, 0, mats.concrete);
      for (let ix = 0; ix <= 4; ix++)
        for (let iz = 0; iz <= 2; iz++) {
          const x = -W / 2 + 0.4 + (ix * (W - 0.8)) / 4;
          const z = -D / 2 + 0.4 + (iz * (D - 0.8)) / 2;
          part(0.6, levels * 3.6, 0.6, x, (levels * 3.6) / 2, z, mats.concrete);
          for (let k = 0; k < 4; k++) part(0.05, 1.6, 0.05, x + (k % 2 ? 0.2 : -0.2), levels * 3.6 + 0.9, z + (k < 2 ? 0.2 : -0.2), mats.tank); // bare steel bars
        }
      const infill = sharedInfill ||= makeInfill(); // one material for every building: they can merge
      for (let l = 0; l < 3; l++)
        for (let ix = 0; ix < 4; ix++) {
          if ((ix + l) % 3 === 2) continue;
          part((W - 0.8) / 4 - 0.6, 3.3, 0.25, -W / 2 + 0.4 + ((ix + 0.5) * (W - 0.8)) / 4, l * 3.6 + 1.8, D / 2 - 0.4, infill);
          part((W - 0.8) / 4 - 0.6, 3.3, 0.25, -W / 2 + 0.4 + ((ix + 0.5) * (W - 0.8)) / 4, l * 3.6 + 1.8, -D / 2 + 0.4, infill);
        }
      solidBox(W, levels * 3.6, D, spot[0], (levels * 3.6) / 2, spot[1], phi);
      footprints.push([[-W / 2, -D / 2], [W / 2, -D / 2], [W / 2, D / 2], [-W / 2, D / 2]].map(([x, z]) => [spot[0] + x * cosP + z * sinP, spot[1] - x * sinP + z * cosP]));
      places.push({ name: "Construction site", x: spot[0], z: spot[1] });
    }
  }

  // ---------- trees, palms and shrubs ----------
  // Street trees of Salt Lake: rain trees and neem along the roads, gulmohar for colour, tall
  // ashoka columns, coconut palms, and flowering hedges in the beds (see trees.js).
  const forest = makeTrees({ scene, renderer });
  function broadleaf(x, z, y = 0, flowering = false, collide = true) {
    const roll = rand();
    const kind = flowering ? "gulmohar" : roll < 0.4 ? "rain" : roll < 0.78 ? "neem" : "ashoka";
    const scale = range(0.8, 1.1);
    const h = forest.add(kind, x, y, z, { yaw: rand() * Math.PI * 2, scale, variant: Math.floor(rand() * 2) });
    if (collide) world.createCollider(RAPIER.ColliderDesc.cylinder(h / 2, kind === "ashoka" ? 0.25 : 0.4 * scale).setTranslation(x, y + h / 2, z));
  }
  function palm(x, z, y = 0, collide = true) {
    const h = forest.add("palm", x, y, z, { yaw: rand() * Math.PI * 2, scale: range(0.9, 1.1), variant: Math.floor(rand() * 2) });
    if (collide) world.createCollider(RAPIER.ColliderDesc.cylinder(Math.min(h, 3) / 2, 0.3).setTranslation(x, y + Math.min(h, 3) / 2, z));
  }
  function shrub(x, z, y, flowers) {
    forest.add(flowers ? (rand() < 0.5 ? "shrubRed" : "shrubWhite") : "shrub", x, y, z, { yaw: rand() * Math.PI * 2, scale: range(0.8, 1.2) });
  }
  // the far side of the street, opposite the main gate (see opposite.js)
  const opposite = buildOpposite({ RAPIER, world, scene, mid, phi, M: tiuModel.materials, forest, places });
  footprints.push(opposite.footprint);
  const planted = [];
  const tryTree = (x, z, gap) => {
    if (!inWorld(x, z, 6) || !freeSpot(x, z, 1.6)) return;
    if (campus.pitches.some((p) => inPoly(x, z, p.pts))) return;
    if (planted.some((p) => Math.hypot(p[0] - x, p[1] - z) < gap)) return;
    planted.push([x, z]);
    const kind = rand();
    if (kind < 0.2) palm(x, z);
    else broadleaf(x, z, 0, kind > 0.9); // gulmohar is a splash of colour, not the rule
  };
  // along the main road
  for (const r of mainRoads) {
    for (let i = 0; i < r.pts.length - 1; i++) {
      const a = r.pts[i];
      const b = r.pts[i + 1];
      const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
      for (let s = 6; s < len; s += 15) {
        const side = ROAD_WIDTH[r.kind] / 2 + 3.4;
        for (const sign of [-1, 1]) {
          const x = a[0] + ((b[0] - a[0]) * s) / len + ((-(b[1] - a[1]) / len) * side + range(-0.6, 0.6)) * sign;
          const z = a[1] + ((b[1] - a[1]) * s) / len + (((b[0] - a[0]) / len) * side + range(-0.6, 0.6)) * sign;
          if (mainRoads.every((o) => o.pts.length < 2 || distToPath(x, z, o.pts) > 5.8)) tryTree(x, z, 9);
        }
      }
    }
  }
  // scattered around the neighbourhood
  for (let i = 0; i < 1500; i++) tryTree(range(-WORLD_HALF, WORLD_HALF), range(-WORLD_HALF, WORLD_HALF), 7);
  // the rest of the (larger) map: sparser, trees only where there is room (freeSpot checks buildings and roads)
  if (WB.xMax - WB.xMin > 2 * WORLD_HALF + 100) for (let i = 0; i < 2500; i++) tryTree(range(WB.xMin, WB.xMax), range(WB.zMin, WB.zMax), 9);
  // lush planting in the beds behind the railing, as in the street photos
  for (const [x0, x1] of beds) {
    for (let x = x0 + 1.2; x < x1 - 0.8; x += 1.5) {
      for (const z of [2.1, 3.3, 4.5]) {
        const [wx, wz] = local(x + range(-0.3, 0.3), z + range(-0.3, 0.3));
        shrub(wx, wz, 0.4, rand() < 0.6);
      }
    }
    for (let x = x0 + 3; x < x1 - 2; x += 7.5) {
      const [wx, wz] = local(x, 3);
      if (rand() < 0.5) palm(wx, wz, 0.4, false);
      else broadleaf(wx, wz, 0.4, rand() < 0.5, false);
    }
  }
  forest.finish();

  // ---------- medians on the other dual carriageways ----------
  // Wherever two one-way main roads run side by side (Street No. 13 past Burger King and the
  // Millennium City tower, for one), the strip between them gets what the street view shows there:
  // a raised kerb painted in blue and white, and a white railing on blue posts.
  {
    const oneway = mainRoads.filter((r) => r.oneway && r.pts.length > 1);
    const nearest = (x, z, pts) => {
      let best = null;
      for (let i = 0; i < pts.length - 1; i++) {
        const a = pts[i];
        const b = pts[i + 1];
        const dx = b[0] - a[0];
        const dz = b[1] - a[1];
        const t = Math.max(0, Math.min(1, ((x - a[0]) * dx + (z - a[1]) * dz) / (dx * dx + dz * dz || 1)));
        const px = a[0] + dx * t;
        const pz = a[1] + dz * t;
        const d = Math.hypot(x - px, z - pz);
        if (!best || d < best.d) best = { d, x: px, z: pz };
      }
      return best;
    };
    const seen = new Set();
    const spots = [];
    for (const r of oneway) {
      for (let i = 0; i < r.pts.length - 1; i++) {
        const a = r.pts[i];
        const b = r.pts[i + 1];
        const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
        for (let d = 1.1; d < len; d += 2.2) {
          const x = a[0] + ((b[0] - a[0]) * d) / len;
          const z = a[1] + ((b[1] - a[1]) * d) / len;
          let other = null;
          for (const o of oneway) {
            if (o === r) continue;
            const n = nearest(x, z, o.pts);
            if (n && n.d > 8 && n.d < 15 && (!other || n.d < other.d)) other = n;
          }
          if (!other) continue;
          const mx = (x + other.x) / 2;
          const mz = (z + other.z) / 2;
          const [lx, lz] = toLocal(mx, mz);
          if (lx > -592 && lx < 133 && lz > 9 && lz < 26) continue; // the university's street has its own
          if (!inWorld(mx, mz, 4)) continue;
          const key = Math.round(mx / 1.6) + ":" + Math.round(mz / 1.6);
          if (seen.has(key)) continue;
          // not across a junction: every road must be at least a lane away
          if (!campus.roads.every((q) => q.pts.length < 2 || distToPath(mx, mz, q.pts) > (ROAD_WIDTH[q.kind] || 3.5) / 2 + 0.7)) continue;
          seen.add(key);
          spots.push({ x: mx, z: mz, yaw: Math.atan2(-(b[1] - a[1]), b[0] - a[0]), w: Math.min(2.6, other.d - 7.4) });
        }
      }
    }
    if (spots.length) {
      const kerbTex = texture(128, 32, (g, w, h) => {
        g.fillStyle = "#e9e7df";
        g.fillRect(0, 0, w, h);
        g.fillStyle = "#2b4fa3";
        g.fillRect(0, 0, w / 2, h);
        speckle(g, w, h, 500, ["rgba(90,80,70,0.35)", "rgba(255,255,255,0.25)", "rgba(40,40,40,0.25)"], 2);
      });
      const kerb = new THREE.BoxGeometry(2.25, 0.3, 1);
      const posts = [];
      for (const px of [-1.05, 0, 1.05]) {
        const g = new THREE.BoxGeometry(0.07, 0.95, 0.07).toNonIndexed();
        g.translate(px, 0.77, 0);
        posts.push(g);
      }
      const rails = [];
      for (const y of [0.55, 0.85, 1.15]) {
        const g = new THREE.BoxGeometry(2.25, 0.045, 0.045).toNonIndexed();
        g.translate(0, y, 0);
        rails.push(g);
      }
      for (let px = -0.9; px < 1; px += 0.3) {
        const g = new THREE.BoxGeometry(0.025, 0.6, 0.025).toNonIndexed();
        g.translate(px, 0.85, 0);
        rails.push(g);
      }
      const parts = [
        [kerb, new THREE.MeshStandardMaterial({ map: kerbTex, roughness: 0.85 })],
        [mergeGeometries(posts), new THREE.MeshStandardMaterial({ color: "#2b4fa3", roughness: 0.6, metalness: 0.3 })],
        [mergeGeometries(rails), new THREE.MeshStandardMaterial({ color: "#e6e6e2", roughness: 0.55, metalness: 0.3 })],
      ];
      const dummy = new THREE.Object3D();
      for (const [geo, mat] of parts) {
        const im = new THREE.InstancedMesh(geo, mat, spots.length);
        spots.forEach((sp, i) => {
          dummy.position.set(sp.x, geo === kerb ? 0.15 : 0, sp.z);
          dummy.rotation.set(0, sp.yaw, 0);
          dummy.scale.set(1, 1, geo === kerb ? Math.max(0.6, sp.w) : 1);
          dummy.updateMatrix();
          im.setMatrixAt(i, dummy.matrix);
        });
        im.castShadow = im.receiveShadow = true;
        scene.add(im);
        addInstanceCull(im, spots.map((sp) => sp.x), spots.map((sp) => sp.z), { radius: 4, cy: 1 });
      }
      for (const sp of spots) solidBox(2.25, 1.2, 0.5, sp.x, 0.6, sp.z, sp.yaw);
    }
  }

  // ---------- the metro viaduct (Green Line) ----------
  // Concrete deck on single piers, about 9 m up, with parapet walls, along the mapped track.
  {
    // weathered concrete with its grain, the same material as the university's concrete
    const conc = tiuModel.materials.concrete;
    const dark = tiuModel.materials.concrete.clone();
    dark.color.multiplyScalar(0.8);
    const inside = (p) => inWorld(p[0], p[1], 4);
    const concParts = [];
    const darkParts = [];
    for (const r of campus.rail || []) {
      const pts = r.pts.filter(inside);
      if (pts.length < 2) continue;
      for (let i = 0; i < pts.length - 1; i++) {
        const a = pts[i];
        const b = pts[i + 1];
        const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
        if (len < 0.5) continue;
        const yaw = Math.atan2(-(b[1] - a[1]), b[0] - a[0]);
        const cx = (a[0] + b[0]) / 2;
        const cz = (a[1] + b[1]) / 2;
        const part = (w, h, d, y, off, mat) => {
          const g = new THREE.BoxGeometry(w, h, d);
          const uv = g.attributes.uv; // the concrete's grain is sized in metres
          for (let k = 0; k < uv.count; k++) uv.setXY(k, (uv.getX(k) * w) / 3, (uv.getY(k) * Math.max(h, d)) / 3);
          g.rotateY(yaw);
          g.translate(cx + Math.sin(yaw) * off, y, cz + Math.cos(yaw) * off);
          (mat === conc ? concParts : darkParts).push(g);
        };
        part(len + 0.3, 1.5, 4.6, 8.6, 0, conc); // box girder
        part(len + 0.3, 0.3, 5.4, 9.5, 0, conc); // deck
        part(len + 0.3, 1.0, 0.18, 10.1, 2.6, dark); // parapets
        part(len + 0.3, 1.0, 0.18, 10.1, -2.6, dark);
      }
      // piers every 25 m or so
      let carry = 12;
      for (let i = 0; i < pts.length - 1; i++) {
        const a = pts[i];
        const b = pts[i + 1];
        const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
        for (let d = carry; d < len; d += 25) {
          const x = a[0] + ((b[0] - a[0]) * d) / len;
          const z = a[1] + ((b[1] - a[1]) * d) / len;
          const pier = new THREE.CylinderGeometry(0.9, 0.9, 7.2, 14).toNonIndexed();
          pier.translate(x, 3.6, z);
          const cap = new THREE.BoxGeometry(4.2, 0.9, 2.2).toNonIndexed();
          cap.rotateY(Math.atan2(-(b[1] - a[1]), b[0] - a[0]) + Math.PI / 2);
          cap.translate(x, 7.5, z);
          concParts.push(pier, cap);
          world.createCollider(RAPIER.ColliderDesc.cylinder(3.6, 0.9).setTranslation(x, 3.6, z));
        }
        carry = (carry - len) % 25;
        if (carry < 0) carry += 25;
      }
    }
    for (const [list, mat] of [[concParts, conc], [darkParts, dark]]) {
      if (!list.length) continue;
      const m = new THREE.Mesh(mergeGeometries(list.map((g) => (g.index ? g.toNonIndexed() : g))), mat);
      m.castShadow = m.receiveShadow = true;
      scene.add(m);
    }
  }

  // ---------- lamps (see street.js) ----------
  const poles = []; // their feet in the street's frame, for people to walk round
  const lamps = { materials: [], spots: [] }; // what lights up at night: [material, day glow, night glow], and where the light falls
  {
    // three-lantern posts along the university's railing
    const posts = [-45, -27, -9, 4, 20, 31.5, 45].map((x) => {
      const [wx, wz] = local(x, FENCE_Z + 0.9);
      return { x: wx, z: wz, yaw: phi };
    });
    const lanternGlass = heritageLamps(scene, posts);
    // tall street lights along the carriageways, arms reaching over the road
    const tall = [];
    for (const r of mainRoads) {
      for (let i = 0; i < r.pts.length - 1; i++) {
        const a = r.pts[i];
        const b = r.pts[i + 1];
        const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
        for (let s = 14; s < len; s += 30) {
          const side = ROAD_WIDTH[r.kind] / 2 + 1.2;
          const nxr = -(b[1] - a[1]) / len;
          const nzr = (b[0] - a[0]) / len;
          const x = a[0] + ((b[0] - a[0]) * s) / len + nxr * side;
          const z = a[1] + ((b[1] - a[1]) * s) / len + nzr * side;
          if (!nearEntrance(x, z, 4) && footprints.every((f) => !inPoly(x, z, f)) && inWorld(x, z)) tall.push({ x, z, yaw: Math.atan2(nzr, -nxr) });
        }
      }
    }
    const ledLens = streetLights(scene, tall);
    lamps.materials.push([lanternGlass, 0.3, 5], [ledLens, 0.25, 7]);
    for (const s of posts) lamps.spots.push({ x: s.x, y: 4.6, z: s.z, r: 5.5, warm: true });
    for (const s of tall) lamps.spots.push({ x: s.x + Math.cos(s.yaw) * 2.4, y: 9.2, z: s.z - Math.sin(s.yaw) * 2.4, r: 13, warm: false });
    for (const s of [...posts, ...tall]) {
      world.createCollider(RAPIER.ColliderDesc.cylinder(3, 0.13).setTranslation(s.x, 3, s.z));
      poles.push(toLocal(s.x, s.z));
    }
  }

  // Cars, parked and moving, are in traffic.js.
  {
    const [x, z] = local(-22, FENCE_Z + 0.8);
    const signTex = texture(128, 128, (g) => {
      g.fillStyle = "#2f6fc0";
      g.beginPath();
      g.arc(64, 64, 60, 0, 7);
      g.fill();
      g.strokeStyle = "#d8242c";
      g.lineWidth = 14;
      g.beginPath();
      g.arc(64, 64, 52, 0, 7);
      g.moveTo(26, 26);
      g.lineTo(102, 102);
      g.stroke();
    }, { repeat: false });
    const disc = new THREE.Mesh(new THREE.CircleGeometry(0.45, 24), new THREE.MeshStandardMaterial({ map: signTex, transparent: true, side: THREE.DoubleSide, roughness: 0.5 }));
    disc.position.set(x, 2.9, z);
    disc.rotation.y = phi;
    const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 3.2, 8), mats.blue);
    pole.position.set(x, 1.6, z);
    pole.castShadow = true;
    scene.add(disc, pole);
  }

  // ---------- loose objects moved by physics ----------
  function prop(mesh, colliderDesc, x, y, z) {
    const rigid = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, y, z).setLinearDamping(0.3).setAngularDamping(0.6));
    world.createCollider(colliderDesc, rigid);
    mesh.castShadow = mesh.receiveShadow = true;
    scene.add(mesh);
    props.push({ mesh, body: rigid, home: { x, y, z } });
  }
  const ballSpots = [local(2.5, 5.4)];
  if (campus.pitches.length) {
    const c = centroid(campus.pitches[campus.pitches.length - 1].pts);
    ballSpots.push([c[0], c[1]], [c[0] + 4, c[1] - 3], [c[0] - 5, c[1] + 4]);
  }
  for (const [x, z] of ballSpots) {
    const ball = new THREE.Mesh(new THREE.IcosahedronGeometry(0.35, 1), new THREE.MeshStandardMaterial({ color: "#f4f4f4", flatShading: true, roughness: 0.5 }));
    prop(ball, RAPIER.ColliderDesc.ball(0.35).setRestitution(0.7).setFriction(0.6).setDensity(0.4), x, 0.4, z);
  }
  const crateMat = new THREE.MeshStandardMaterial({ color: "#b98646", roughness: 1 });
  for (const [lx, y, lz] of [[22.6, 0.4, 5.6], [23.5, 0.4, 5.6], [23.05, 1.2, 5.6]]) {
    const [x, z] = local(lx, lz);
    prop(new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.8, 0.8), crateMat), RAPIER.ColliderDesc.cuboid(0.4, 0.4, 0.4).setFriction(0.8).setDensity(0.5), x, y, z);
  }

  flushWalls();
  // the opposite side's stalls, trees and walls are static too (their group is flagged in opposite.js)
  for (const g of scene.children.filter((c) => c.userData.staticGroup)) {
    g.updateMatrixWorld(true);
    g.traverse((o) => {
      if (o.isMesh) staticMeshes.push(o);
    });
  }
  const chunks = mergeStaticChunks(scene, staticMeshes, { size: 300 }); // 8.5k buildings x ~15 materials: 100 m cells left thousands of lone meshes; 300 m cells cut gate-view draw calls 1279 -> 476

  return {
    updateSigns,
    chunks,
    places,
    props,
    // where the fly-over camera looks, and which way a new arrival faces (toward the entrance)
    focus: { x: mid[0], z: mid[1], height: tiuHeight },
    entranceYaw: phi,
    entrance: { x: local(tiuModel.porchX, 0)[0], z: local(tiuModel.porchX, 0)[1] },
    // Glass and metal on the university building reflect the real surroundings (street, trees,
    // the buildings opposite), captured once from in front of it with the building itself hidden.
    captureReflections() {
      const target = new THREE.WebGLCubeRenderTarget(256, { type: THREE.HalfFloatType, generateMipmaps: true, minFilter: THREE.LinearMipmapLinearFilter });
      const cube = new THREE.CubeCamera(0.5, 900, target);
      const [x, z] = local(26, 9);
      cube.position.set(x, 11, z);
      tiuModel.group.visible = false;
      cube.update(renderer, scene);
      tiuModel.group.visible = true;
      for (const m of tiuModel.reflective) {
        m.envMap = target.texture;
        m.needsUpdate = true;
      }
    },
    tiu: tiuModel,
    animate: (seconds) => forest.animate(seconds),
    local,
    toLocal,
    phi,
    sky: skyControl,
    lamps,
    nightUniform,
    // where people stand, sit, walk round and go in (see people.js)
    spots: { ...opposite.spots, poles: [...poles, [-22, FENCE_Z + 0.8]], fenceZ: FENCE_Z, porchX: tiuModel.porchX },
  };
}

// ---------- loading ----------
// The name form is on screen from the start, with a progress bar in it and the button off. Behind it the
// canvas stays hidden until the characters, the cars and the shirts have loaded and the shaders are compiled;
// then the drone shot fades in and the button turns on, so it starts smooth instead of stuttering in view.
let appReady = false;
(function loading() {
  const bar = $("#loadBar"), txt = $("#loadText"), pct = $("#loadPct"), tipEl = $("#loadTip"), btn = $("#enterBtn");
  const jobs = [
    ["the people", kitLoading],
    ["the crowd", bodiesLoading],
    ["your avatar", Promise.allSettled([playerKitLoading, avatarLoading, avatarKit("sof")])],
    ["the traffic", streetLife ? vehiclesReady() : null],
    ["the shirts", Promise.allSettled(["tiu", "reboot", "sof"].map((s) => loadPolo(s)))],
  ].filter(([, p]) => p);
  const total = jobs.length + 1; // and the graphics warm-up
  let done = 0;
  const show = (n) => {
    const v = Math.max(4, Math.min(100, Math.round(n * 100)));
    bar.style.width = v + "%";
    pct.textContent = v + "%";
  };
  txt.textContent = "Loading the campus…";
  const tick = (label) => {
    done++;
    show(done / total);
    if (label) txt.textContent = label;
  };
  // a line of advice under the bar, changing every few seconds
  const TIPS = [
    "Press <b>T</b> to step through the day, from dawn to midnight.",
    "Say hello with <b>1</b> (nomoshkar), <b>2</b> (wave) or <b>3</b> (handshake).",
    "Hold <b>V</b> to talk to whoever is standing near you.",
    "Autos and buses stop at the kerb to pick people up and drop them off.",
    "Stand in a car's way for a few seconds and the driver will get out to argue.",
    "Chat reaches everyone within 15 metres.",
  ];
  let tipAt = Math.floor(Math.random() * TIPS.length);
  tipEl.innerHTML = TIPS[tipAt];
  const tipTimer = setInterval(() => {
    tipEl.style.opacity = 0;
    setTimeout(() => {
      tipAt = (tipAt + 1) % TIPS.length;
      tipEl.innerHTML = TIPS[tipAt];
      tipEl.style.opacity = 1;
    }, 450);
  }, 4200);
  const reveal = () => {
    if (appReady) return;
    appReady = true;
    clearInterval(tipTimer);
    document.body.classList.remove("booting"); // the loader fades out, the join screen fades in
    btn.disabled = false;
    setTimeout(() => $("#name").focus(), 400);
  };
  Promise.all(jobs.map(([name, p]) => Promise.resolve(p).catch(() => {}).then(() => tick(`Loaded ${name}`))))
    .then(async () => {
      txt.textContent = "Getting the graphics ready…";
      await new Promise((r) => requestAnimationFrame(r));
      try {
        camera.position.set(focus.x, 55, focus.z + 120);
        camera.lookAt(focus.x, focus.height * 0.4, focus.z);
        camera.updateMatrixWorld(true);
        if (renderer.compileAsync) await renderer.compileAsync(scene, camera);
        else renderer.compile(scene, camera);
        draw(); // two real frames: shaders, shadow map and the AO buffers are made here, hidden, so the first frame in the game is smooth
        draw();
      } catch (e) {
        console.warn("warm-up failed", e);
      }
      tick("Ready");
    })
    .then(() => new Promise((r) => setTimeout(r, 450)))
    .then(reveal);
  setTimeout(reveal, 45000); // never hang on a failed download
})();
frame();

// Small handle for automated tests and debugging in the console.
window.__tiu = {
  get nav() {
    return nav;
  },
  world,
  RAPIER,
  toLocal: worldInfo.toLocal,
  local: worldInfo.local,
  spots: worldInfo.spots,
  // free camera for screenshots: __tiu.cam(x, y, z, lookX, lookY, lookZ); __tiu.cam() to go back
  bikes: () => bikes.map((b) => ({ x: b.x, y: b.y, z: b.z, heading: b.heading, kind: b.model.kind, design: b.model.design })),
  // move a parked machine somewhere (street frame), for testing: __tiu.moveBike(i, lx, lz, turn)
  moveBike(i, lx, lz, turn = Math.PI / 2) {
    const b = bikes[i];
    world.removeCollider(b.collider, true);
    unbikeObstacle(b);
    scene.remove(b.stand);
    const [x, z] = worldInfo.local(lx, lz);
    parkBike(b, x, 0, z, entranceYaw + turn);
    return { x: b.x, z: b.z, heading: b.heading };
  },
  rideInfo: () => riding && { v: +riding.r.v.toFixed(2), kmh: +(riding.r.v * 3.6).toFixed(1), rpm: Math.round(riding.r.rpm), gear: riding.r.gearNo, design: riding.bike.model.design, heading: riding.r.heading, steer: +riding.r.steer.toFixed(3), lean: +riding.r.lean.toFixed(3), footDown: +riding.r.footDown.toFixed(2), grade: +rideGrade.toFixed(3) },
  slow(k = 1) {
    timeScale = k;
  },
  cam(...v) {
    debugCam = v.length === 6 ? v : null;
  },
  get me() {
    return me && { id: me.id, x: me.group.position.x, y: me.group.position.y, z: me.group.position.z, grounded: body.grounded, jump: jumpState.phase, crouch: jumpState.crouch, vy: body.vy };
  },
  players: () => [...players.values()].map((a) => ({ id: a.id, name: a.name, x: a.tx, y: a.ty, z: a.tz, dist: a.dist, voice: a.voice, speaking: a.speaking })),
  peers: () => [...peers].map(([id, p]) => ({ id, state: p.pc.connectionState, audio: Boolean(p.panner) })),
  props: () => props.map((p) => p.body.translation()),
  view(yaw, pitch = camPitch, dist = camDist) {
    camYaw = yaw;
    camPitch = pitch;
    camDist = dist;
  },
  entranceYaw,
  hero: () => Boolean(hero),
  // push the player (impulse in N*s, world x/z): __tiu.push(60, 0) is a shoulder bump
  push: (jx, jz) => pushHuman(human, jx, jz),
  body: () => ({ v: +Math.hypot(human.vx, human.vz).toFixed(2), state: human.state, stamina: +human.stamina.toFixed(2), leanFwd: +human.leanFwd.toFixed(3), leanSide: +human.leanSide.toFixed(3), fallen: +human.fallen.toFixed(2), th: +fall.th.toFixed(2) }),
  // run the getting-on/off sequence ahead without drawing: __tiu.advance(1.5); returns the step
  advance(seconds) {
    for (let t = 0; t < seconds && seq; t += 1 / 30) seqFrame(1 / 30);
    if (!seq && !riding) for (let t = 0; t < seconds; t += 1 / 30) walkFrame(1 / 30, performance.now());
    return seq ? seq.steps[seq.i]?.name : riding ? "riding" : "walking";
  },
  ride: () => riding && { v: +riding.r.v.toFixed(2), heading: riding.r.heading, design: riding.bike.model.design },
  greet,
  // +1 when the character's face points the way the body is travelling, -1 when it is backwards
  facingCheck() {
    const eye = hero.model.getObjectByName("LeftEye").getWorldPosition(new THREE.Vector3());
    const head = hero.model.getObjectByName("Neck").getWorldPosition(new THREE.Vector3());
    const ry = me.group.rotation.y;
    const d = Math.hypot(eye.x - head.x, eye.z - head.z);
    return { dot: +(((eye.x - head.x) * -Math.sin(ry) + (eye.z - head.z) * -Math.cos(ry)) / d).toFixed(2), holderY: hero.model.rotation.y };
  },
  vehicleModels: () => traffic && traffic.vehicles.map((v) => ({ kind: v.kind, model: v.mesh.userData.model || "procedural", x: +v.x.toFixed(1), lat: +v.lat.toFixed(1), state: v.state, real: Boolean(v.mesh.userData.occupants && v.mesh.userData.occupants.hasReal), vis: v.mesh.visible, parent: Boolean(v.mesh.parent) })),
  // Where do the triangles and milliseconds go? Run while playing: __tiu.cost()  (takes a few seconds)
  cost() {
    const gl = renderer.getContext();
    const run = () => { const t = []; let tris = 0, calls = 0; for (let i = 0; i < 4; i++) { const t0 = performance.now(); renderer.render(scene, camera); gl.finish(); t.push(performance.now() - t0); tris = renderer.info.render.triangles; calls = renderer.info.render.calls; } t.sort((x, y) => x - y); return { ms: +((t[1] + t[2]) / 2).toFixed(1), tris, calls }; };
    const once = () => { renderer.render(scene, camera); return renderer.info.render.triangles; };
    const saved = composer; composer = null; // measure the plain scene render
    run();
    const base = run();
    const out = { base, tests: {} };
    const hide = (list, get) => { const saved = list.map((o) => [o, get(o).visible]); list.forEach((o) => (get(o).visible = false)); return () => saved.forEach(([o, v]) => (get(o).visible = v)); };
    let restore = () => {};
    const test = (name, off, on) => { restore = off() || (() => {}); run(); out.tests[name] = run(); restore(); if (on) on(); };
    out.sunCastShadow = sun.castShadow; out.governorLevel = perf.level;
    test("shadow pass skipped", () => { renderer.shadowMap.autoUpdate = false; }, () => { renderer.shadowMap.autoUpdate = perf.shadowEvery === 1; });
    if (traffic) {
      test("no traffic", () => hide(traffic.vehicles, (v) => v.mesh));
    }
    if (crowd) {
      test("no crowd", () => hide(crowd.people.filter((p) => p.group), (p) => p.group));
    }
    test("no other players", () => hide([...players.values()], (p) => p.group));
    const rows = [];
    for (const c of scene.children) {
      if (c.isLight) continue;
      const was = c.visible; c.visible = false;
      const tris = once();
      c.visible = was;
      let info = "";
      if (c.geometry) { const g = c.geometry; g.boundingBox || g.computeBoundingBox(); const bb = g.boundingBox; const ctr = bb.getCenter(new THREE.Vector3()).add(c.position); const sz = bb.getSize(new THREE.Vector3()); info = ` ${(g.index ? g.index.count : g.attributes.position.count) / 3 | 0}t @(${ctr.x | 0},${ctr.y | 0},${ctr.z | 0}) size(${sz.x | 0}x${sz.y | 0}x${sz.z | 0}) mat=${c.material.name || c.material.type}${c.material.map ? "+map" : ""} cast=${c.castShadow ? 1 : 0}`; }
      rows.push({ child: `${c.name || c.type} [${c.children.length}]${info}`, trisSaved: base.tris - tris, obj: c });
    }
    rows.sort((x, y) => y.trisSaved - x.trisSaved);
    composer = saved;
    out.topSceneChildren = rows.slice(0, 14);
    console.table(Object.entries(out.tests).map(([k, v]) => ({ test: k, ms: v.ms, tris: v.tris, msSaved: +(base.ms - v.ms).toFixed(1), trisSaved: base.tris - v.tris })));
    console.table(out.topSceneChildren.map(({ child, trisSaved }) => ({ child, trisSaved })));
    return out;
  },
  spawnHitches: () => perf.hitches.slice().sort((x, y) => x.at - y.at),
  renderInfo: () => ({ treesDrawn: scene.userData.treesShown, calls: renderer.info.render.calls, triangles: renderer.info.render.triangles, textures: renderer.info.memory.textures, geometries: renderer.info.memory.geometries }),
  // adds a stand-in person at a spot, to test looking at people without a second browser
  standIn(x, z) {
    const a = makeAvatar({ id: "stand-in", name: "Riya", dept: "", color: "#2ec4a6", x, y: 0, z, ry: 0, voice: false });
    players.set("stand-in", a);
    attachCharacter(a);
    return a.id;
  },
  stride: () => hero && hero.stride,
  // run the street on its own for a while (traffic and people only), to check how it behaves
  simulate(seconds, step = 0.1) {
    const pos = me.group.position;
    for (let i = 0; i < seconds / step; i++) updateStreet(step, pos);
  },
  traffic: () => traffic && traffic.vehicles.map((v) => ({ kind: v.kind, road: v.road, x: +v.x.toFixed(1), lat: +v.lat.toFixed(2), v: +v.v.toFixed(2), state: v.state, ind: v.ind })),
  crowd: () => crowd && crowd.people.map((p) => ({ role: p.role, x: +p.x.toFixed(1), z: +p.z.toFixed(2), task: p.tasks[0]?.type, act: p.tasks[0]?.act, left: p.tasks.length, sp: +p.speed.toFixed(2), body: p.bodyName })),
  crowdStats: () => crowd && { ...crowd.stats, crashes: traffic ? traffic.crashCount : 0, arguing: crowd.people.filter((p) => p.tasks[0]?.type === "argue").length },
  forceCrash: () => traffic && traffic.forceCrash(),
  crashes: () => traffic && traffic.crashes.map((c) => ({ a: c.a.kind, b: c.b && c.b.kind, x: +c.x.toFixed(1), road: c.road, t: +c.t.toFixed(1), done: c.done, player: Boolean(c.player) })),
  crowdObj: () => crowd, // the whole street-life object (queues, stops, the aisle): tests
  people: () => crowd && crowd.people, // the live person objects (tests)
  deals: () => crowd && crowd.deals(),
  bodies: () => crowdBodies.map((b) => b.name),
  vehicleDetail: () => traffic && traffic.vehicles.filter((v) => v.state !== "parked" && v.state !== "drive").map((v) => ({ kind: v.kind, road: v.road, state: v.state, x: +v.x.toFixed(2), lat: +v.lat.toFixed(2), latT: +v.latTarget.toFixed(2), v: +v.v.toFixed(2), slot: v.slot && v.slot.x, stopX: v.stopX })),
  // the clock: __tiu.time("19:30") sets the time of day (it no longer follows the real time)
  time(t) {

      },
    });
  }
  if (motor) {
    steps.push({
      name: "key", dur: 1.0,
      run(k) {
        const w = span(k, 0, 0.35) * (1 - span(k, 0.7, 1));
        P.handR = V().copy(_m.gripR).addScaledVector(_m.back, 0.05).lerp(V().copy(_m.key).addScaledVector(_m.back, 0.04).addScaledVector(UPV, 0.02), w);
        if (k > 0.5 && !this.done) {
          this.done = true;

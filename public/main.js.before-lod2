}
function stepsOff(bike) {
  const m = bike.model;
  const motor = m.spec.motor;
  const lean0 = m.spec.parkLean;
  const hung = m.hung;
  const steps = [];
  const P = {};
  if (motor) {
    steps.push({
      name: "key off", dur: 0.9,
      run(k) {
        const w = span(k, 0, 0.35) * (1 - span(k, 0.7, 1));

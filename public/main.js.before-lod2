      leanSide: human.leanSide,
      down: fall.th,
      stagger: human.stagger > 0 || limp > 0,
      facing: me.group.rotation.y,
      lookAt: nearest ? lookTarget.set(nearest.group.position.x, nearest.group.position.y + 1.8, nearest.group.position.z) : null,

// People: a detailed rigged human, shared by the player, other players and everyone on the street.
//  - Motion-captured idle, walk and run, blended by ground speed with the stride matched to the
//    speed so the feet do not slide.
//  - Feet are placed on the real ground (steps, kerbs) with leg IK; knees bend only as a hinge.
//  - Head and eyes turn toward people nearby, within the limits of a human neck.
//  - Face: smile and mouth movement (the model has those two face controls; it has no blink).
//  - Outfit: navy and white diagonal polo with a red chest logo, dark trousers.
// The body is models/avatar.glb. The animations come from models/anims.glb, which has the same
// bones in a different resting pose, so each animation is converted when it loads.
import * as THREE from "three";
import { makeHelmet } from "/helmet.js";
import { rebootPrints } from "/shirt.js";
import { GLTFLoader } from "/vendor/jsm/loaders/GLTFLoader.js";
import { clone as cloneSkinned } from "/vendor/jsm/utils/SkeletonUtils.js";

const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const smoothstep = (a, b, v) => {
  const t = clamp((v - a) / (b - a), 0, 1);
  return t * t * (3 - 2 * t);
};
const ease = (dt, rate) => 1 - Math.exp(-dt * rate);
const lerpN = (a, b, t) => a + (b - a) * t;
const wrapAngle = (a) => Math.atan2(Math.sin(a), Math.cos(a));
const cleanName = (n) => n.replace(/^mixamorig:?/, "");

// Which child a bone "points at". Used to line up the two skeletons' resting poses.
const POINTS_AT = { Hips: "Spine", Spine: "Spine1", Spine1: "Spine2", Spine2: "Neck", Neck: "Head", Head: "HeadTop_End", LeftHand: "LeftHandMiddle1", RightHand: "RightHandMiddle1" };

function dressInUniform(model, shirt = "tiu") {
  const reboot = shirt === "reboot";
  model.traverse((o) => {
    if (!o.isMesh) return;
    const name = o.material.name;
    if (name === "Wolf3D_Headwear" || name === "Wolf3D_Beard") o.visible = false;
    if (name === "Wolf3D_Outfit_Bottom") {
      o.material.map = null;
      o.material.color.set(reboot ? "#2a2c31" : "#1d212b");
      o.material.roughness = 0.85;
    }
    if (name === "Wolf3D_Outfit_Top") {
      // Colours are decided from where each point sits on the body in its resting pose, so the
      // diagonal stays put on the shirt while the character moves.
      const m = o.material.clone(); // each wearer's shirt is their own
      o.material = m;
      m.map = null;
      m.color.set("#ffffff");
      m.roughness = 0.9;
      m.metalness = 0;
      if (reboot) {
        // The School of the Future polo: black cotton pique (a fine knit you can just see), the
        // chest print on the wearer's left (10.5 x 3.2 cm), the big print on the back (25 x 42 cm,
        // its top 8 cm below the collar). Prints are slightly raised and less rough than the knit.
        const pr = rebootPrints();
        m.roughness = 0.92;
        m.onBeforeCompile = (shader) => {
          shader.uniforms.uFront = { value: pr.front };
          shader.uniforms.uBack = { value: pr.back };
          shader.vertexShader = shader.vertexShader
            .replace("#include <common>", "#include <common>\nvarying vec3 vRestPos;")
            .replace("#include <begin_vertex>", "#include <begin_vertex>\nvRestPos = position;");
          shader.fragmentShader = shader.fragmentShader
            .replace("#include <common>", "#include <common>\nvarying vec3 vRestPos;\nuniform sampler2D uFront; uniform sampler2D uBack;")
            .replace(
              "#include <map_fragment>",
              `
              if (vRestPos.y < 0.9 && abs(vRestPos.x) < 0.3) discard; // shirt hem at the hips
              // pique knit: tiny alternating cells
              vec2 k = floor(vec2(vRestPos.x + vRestPos.z, vRestPos.y) * 900.0);
              float knit = mod(k.x + k.y, 2.0);
              vec3 shirt = vec3(0.016, 0.016, 0.018) * (0.9 + 0.2 * knit);
              // chest print (wearer's left is +x; seen from the front, u runs with +x)
              if (vRestPos.z > 0.03) {
                vec2 uv = vec2((vRestPos.x - 0.032) / 0.105, (vRestPos.y - 1.355) / 0.032);
                if (uv.x > 0.0 && uv.x < 1.0 && uv.y > 0.0 && uv.y < 1.0) {
                  vec4 p = texture2D(uFront, uv);
                  shirt = mix(shirt, p.rgb, p.a);
                }
              }
              // back print (seen from behind, u runs with -x)
              if (vRestPos.z < -0.02) {
                vec2 uv = vec2((0.125 - vRestPos.x) / 0.25, (vRestPos.y - 1.03) / 0.42);
                if (uv.x > 0.0 && uv.x < 1.0 && uv.y > 0.0 && uv.y < 1.0) {
                  vec4 p = texture2D(uBack, uv);
                  shirt = mix(shirt, p.rgb, p.a);
                }
              }
              diffuseColor.rgb = shirt;
              `,
            );
        };
        m.customProgramCacheKey = () => "shirt-reboot";
        m.needsUpdate = true;
        return;
      }
      m.onBeforeCompile = (shader) => {
        shader.vertexShader = shader.vertexShader
          .replace("#include <common>", "#include <common>\nvarying vec3 vRestPos;")
          .replace("#include <begin_vertex>", "#include <begin_vertex>\nvRestPos = position;");
        shader.fragmentShader = shader.fragmentShader
          .replace("#include <common>", "#include <common>\nvarying vec3 vRestPos;")
          .replace(
            "#include <map_fragment>",
            `
            if (vRestPos.y < 0.9 && abs(vRestPos.x) < 0.3) discard; // shirt hem at the hips
            vec3 navy = vec3(0.012, 0.018, 0.05);
            vec3 offWhite = vec3(0.82, 0.8, 0.76);
            // diagonal from the wearer's right shoulder down to the left hip
            float side = dot(vRestPos.xy - vec2(-0.075, 1.5), vec2(0.897, 0.441));
            vec3 shirt = mix(navy, offWhite, smoothstep(-0.004, 0.004, side));
            // round red logo on the left chest with a white mark
            vec2 badge = vRestPos.xy - vec2(0.088, 1.385);
            if (vRestPos.z > 0.02 && length(badge) < 0.034) {
              shirt = vec3(0.66, 0.02, 0.03);
              vec2 q = vec2(badge.x + badge.y * 0.25, badge.y);
              bool stem = abs(q.x + 0.004) < 0.0045 && q.y > -0.02 && q.y < 0.02;
              bool bar = abs(q.y - 0.006) < 0.004 && q.x > -0.016 && q.x < 0.012;
              bool foot = abs(q.y + 0.018) < 0.0035 && q.x > -0.004 && q.x < 0.014;
              if (stem || bar || foot) shirt = vec3(0.9);
            }
            diffuseColor.rgb = shirt;
            `,
          );
      };
      m.needsUpdate = true;
    }
  });
}

// Hair colours: base, then the light, middle and dark strand colours drawn over it.
const HAIR_TONES = {
  black: ["#14100d", "rgba(92,74,58,0.55)", "rgba(48,37,29,0.6)", "rgba(8,6,5,0.6)"],
  brown: ["#2a1d14", "rgba(120,90,62,0.55)", "rgba(70,50,34,0.6)", "rgba(18,12,8,0.6)"],
  grey: ["#6d6a66", "rgba(200,198,194,0.6)", "rgba(140,137,132,0.6)", "rgba(40,38,36,0.55)"],
  pepper: ["#2b2826", "rgba(190,188,184,0.6)", "rgba(90,86,82,0.6)", "rgba(12,11,10,0.6)"],
};
function hairTexture(tone = "black") {
  const [base, lightC, midC, darkC] = HAIR_TONES[tone] || HAIR_TONES.black;
  const c = document.createElement("canvas");
  c.width = 256;
  c.height = 256;
  const g = c.getContext("2d");
  g.fillStyle = base;
  g.fillRect(0, 0, 256, 256);
  // fine strands running along v (the direction the hair is combed), with a few lighter ones
  for (let i = 0; i < 2600; i++) {
    const x = Math.random() * 256;
    const y = Math.random() * 256;
    const len = 10 + Math.random() * 26;
    const light = Math.random();
    g.strokeStyle = light < (tone === "pepper" ? 0.3 : 0.08) ? lightC : light < 0.4 ? midC : darkC;
    g.lineWidth = 0.6 + Math.random() * 0.8;
    g.beginPath();
    g.moveTo(x, y);
    g.quadraticCurveTo(x + (Math.random() - 0.5) * 3, y + len / 2, x + (Math.random() - 0.5) * 4, y + len);
    g.stroke();
  }
  const t = new THREE.CanvasTexture(c);
  t.colorSpace = THREE.SRGBColorSpace;
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  return t;
}
// Rest-pose hairline height for a point on the head (metres, the model stands 1.85 m tall).
// Front: high on the forehead; temples recede slightly; sideburns come down in front of the ears;
// behind the ears it drops to the nape.
function hairlineAt(x, z) {
  const ax = Math.abs(x);
  if (z > 0.055) return 1.776 + Math.max(0, ax - 0.04) * 0.3; // forehead
  if (z > 0.02) return THREE.MathUtils.lerp(1.705, 1.785, (z - 0.02) / 0.035); // temple to sideburn
  if (z > -0.045) return ax > 0.075 ? 1.755 : 1.7; // above the ear (the ear itself stays clear)
  return THREE.MathUtils.lerp(1.7, 1.625, Math.min(1, (-0.045 - z) / 0.05)); // back of the head to the nape
}
function makeHair(head) {
  const src = head.geometry;
  const P = src.attributes.position;
  const N = src.attributes.normal;
  const idx = src.index ? src.index.array : [...Array(P.count).keys()];
  const smooth = (a, b, v) => {
    const t = Math.min(1, Math.max(0, (v - a) / (b - a)));
    return t * t * (3 - 2 * t);
  };
  // how far above the hairline each vertex sits
  const above = new Float32Array(P.count);
  for (let i = 0; i < P.count; i++) above[i] = P.getY(i) - hairlineAt(P.getX(i), P.getZ(i));
  const keep = [];
  for (let f = 0; f < idx.length; f += 3) {
    const a = idx[f];
    const b = idx[f + 1];
    const c = idx[f + 2];
    // whole faces only, and not the inside of the mouth or the ears' fronts
    if (Math.max(above[a], above[b], above[c]) > -0.004 && Math.min(above[a], above[b], above[c]) > -0.012) keep.push(a, b, c);
  }
  const used = [...new Set(keep)];
  const remap = new Map(used.map((v, i) => [v, i]));
  const pos = new Float32Array(used.length * 3);
  const nor = new Float32Array(used.length * 3);
  const uv = new Float32Array(used.length * 2);
  const col = new Float32Array(used.length * 4);
  const si = new Float32Array(used.length * 4);
  const sw = new Float32Array(used.length * 4);
  const crown = new THREE.Vector3(0.008, 1.84, -0.035); // where the hair whorls
  const v = new THREE.Vector3();
  const n = new THREE.Vector3();
  used.forEach((o, i) => {
    v.fromBufferAttribute(P, o);
    n.fromBufferAttribute(N, o);
    const up = above[o];
    // fuller on top, close-cropped at the sides and the back, thinning to nothing at the hairline
    const topness = smooth(1.74, 1.83, v.y);
    const thick = (0.004 + 0.015 * topness) * smooth(-0.003, 0.014, up);
    v.addScaledVector(n, thick + 0.0008);
    pos.set([v.x, v.y, v.z], i * 3);
    nor.set([n.x, n.y, n.z], i * 3);
    // strands comb back from the forehead and fall from the crown: u around the crown, v away from it
    const d = v.clone().sub(crown);
    uv[i * 2] = (Math.atan2(d.x, d.z) / (Math.PI * 2)) * 6;
    uv[i * 2 + 1] = d.length() * 9;
    // the hairline is soft and broken: alpha rises over the first centimetre or so
    const alpha = smooth(-0.004, 0.005, up);
    col.set([1, 1, 1, alpha], i * 4);
    const sI = src.attributes.skinIndex;
    const sW = src.attributes.skinWeight;
    si.set([sI.getX(o), sI.getY(o), sI.getZ(o), sI.getW(o)], i * 4);
    sw.set([sW.getX(o), sW.getY(o), sW.getZ(o), sW.getW(o)], i * 4);
  });
  const geo = new THREE.BufferGeometry();
  geo.setAttribute("position", new THREE.BufferAttribute(pos, 3));
  geo.setAttribute("normal", new THREE.BufferAttribute(nor, 3));
  geo.setAttribute("uv", new THREE.BufferAttribute(uv, 2));
  geo.setAttribute("color", new THREE.BufferAttribute(col, 4));
  geo.setAttribute("skinIndex", new THREE.BufferAttribute(si, 4));
  geo.setAttribute("skinWeight", new THREE.BufferAttribute(sw, 4));
  geo.setIndex(keep.map((k) => remap.get(k)));
  const mat = new THREE.MeshStandardMaterial({
    map: hairTexture(),
    color: "#ffffff",
    roughness: 0.55,
    metalness: 0,
    vertexColors: true,
    alphaHash: true, // dithered soft edge: no sorting problems against the skin
  });
  mat.name = "Hair";
  const hair = new THREE.SkinnedMesh(geo, mat);
  hair.name = "Hair";
  hair.bind(head.skeleton, head.bindMatrix);
  hair.castShadow = true;
  hair.frustumCulled = false;
  hair.renderOrder = 1;
  return hair;
}

// ---------------------------------------------------------------------------------------------
// Everyone in the world, players and passers-by, is a copy of the same rigged body. The model and
// its animations are loaded and converted once (the "kit"); each person is a cheap copy with their
// own skeleton, clothes, hair, skin tone, height and build, accessories, and animation state.
// ---------------------------------------------------------------------------------------------

// Clothes on everyone else: colours and weaves drawn on the outfit from where each point sits on
// the body in its resting pose, so patterns stay put while the person moves.
//   top.pattern: solid | stripes | checks | tee | kurta | polo
//   bottom.pattern: solid | jeans | checks (lungi) | cargo
function dressInLook(model, look) {
  const top = look.top || {};
  const bottom = look.bottom || {};
  const fabric = (m, spec, isTop) => {
    m.map = null;
    m.normalMap = m.normalMap || null;
    m.color.set("#ffffff");
    m.roughness = spec.rough ?? 0.88;
    m.metalness = 0;
    const c1 = new THREE.Color(spec.color || "#cccccc");
    const c2 = new THREE.Color(spec.color2 || spec.color || "#999999");
    const pattern = { solid: 0, stripes: 1, checks: 2, tee: 3, kurta: 4, polo: 5, jeans: 6, cargo: 7 }[spec.pattern || "solid"] ?? 0;
    const hem = isTop ? (spec.pattern === "kurta" ? -1 : spec.untucked ? 0.86 : 0.9) : -1;
    m.onBeforeCompile = (shader) => {
      shader.uniforms.uC1 = { value: c1 };
      shader.uniforms.uC2 = { value: c2 };
      shader.uniforms.uPat = { value: pattern };
      shader.uniforms.uScale = { value: spec.scale || 1 };
      shader.uniforms.uHem = { value: hem };
      shader.vertexShader = shader.vertexShader
        .replace("#include <common>", "#include <common>\nvarying vec3 vRestPos;")
        .replace("#include <begin_vertex>", "#include <begin_vertex>\nvRestPos = position;");
      shader.fragmentShader = shader.fragmentShader
        .replace("#include <common>", "#include <common>\nvarying vec3 vRestPos;\nuniform vec3 uC1; uniform vec3 uC2; uniform int uPat; uniform float uScale; uniform float uHem;\nfloat hsh(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}")
        .replace(
          "#include <map_fragment>",
          `
          if (uHem > 0.0 && vRestPos.y < uHem && abs(vRestPos.x) < 0.3) discard;
          vec3 p = vRestPos * uScale;
          vec3 col = uC1;
          // a fine weave so no cloth is a flat colour
          float weave = (hsh(floor(p.xy * 900.0)) - 0.5) * 0.05 + sin(p.x * 1400.0) * sin(p.y * 1400.0) * 0.02;
          if (uPat == 1) { // shirt stripes: thin vertical lines
            float s = abs(fract(p.x * 22.0) - 0.5);
            col = mix(uC1, uC2, smoothstep(0.42, 0.46, s));
          } else if (uPat == 2) { // checks (madras shirt, lungi)
            float a = step(0.5, fract(p.x * 9.0 + p.z * 9.0));
            float b = step(0.5, fract(p.y * 9.0));
            col = mix(uC1, uC2, 0.5 * a + 0.5 * b);
            col = mix(col, uC1 * 0.55, step(0.92, fract(p.y * 18.0)) * 0.6);
          } else if (uPat == 3) { // T-shirt: a print on the chest
            vec2 q = vRestPos.xy - vec2(0.0, 1.32);
            if (vRestPos.z > 0.04 && abs(q.x) < 0.085 && abs(q.y) < 0.07) {
              col = mix(uC2, uC1, step(0.5, fract((q.x + q.y) * 18.0)) * 0.35);
            }
          } else if (uPat == 4) { // kurta: a darker placket and a soft sheen
            if (vRestPos.z > 0.05 && abs(vRestPos.x) < 0.018 && vRestPos.y > 1.25 && vRestPos.y < 1.5) col = uC2;
          } else if (uPat == 5) { // collared polo with a contrasting band
            col = mix(uC1, uC2, step(1.40, vRestPos.y) * step(vRestPos.y, 1.44));
          } else if (uPat == 6) { // denim: diagonal twill, paler down the thighs
            float tw = step(0.5, fract((p.x + p.y) * 160.0)) * 0.06;
            float fade = smoothstep(0.35, 0.0, abs(vRestPos.x) - 0.09) * smoothstep(0.55, 0.8, vRestPos.y) * smoothstep(1.0, 0.8, vRestPos.y);
            col = uC1 * (1.0 - tw) + vec3(0.14, 0.16, 0.2) * fade * 0.6;
          } else if (uPat == 7) { // cargo: side pockets
            if (abs(abs(vRestPos.x) - 0.16) < 0.05 && vRestPos.y > 0.45 && vRestPos.y < 0.6) col = uC1 * 0.82;
          }
          diffuseColor.rgb = col * (1.0 + weave);
          `,
        );
    };
    m.customProgramCacheKey = () => `look-${pattern}-${hem}`;
    m.needsUpdate = true;
  };
  model.traverse((o) => {
    if (!o.isMesh) return;
    const name = o.material.name;
    if (name === "Wolf3D_Outfit_Top") fabric(o.material, top, true);
    else if (name === "Wolf3D_Outfit_Bottom") fabric(o.material, bottom, false);
    else if (name === "Wolf3D_Outfit_Footwear") {
      o.material.map = null;
      o.material.color.set(look.shoes || "#2a2622");
      o.material.roughness = look.shoesRough ?? 0.6;
    } else if ((name === "Wolf3D_Skin" || name === "Wolf3D_Body") && look.skin) {
      o.material.color.setScalar(1).multiplyScalar(look.skin);
    } else if (name === "Wolf3D_Beard") {
      o.visible = Boolean(look.beard);
      if (look.beard) o.material.color.set(look.beard);
    }
  });
}

// Small things people carry and wear, fixed to a bone so they move with the body.
const gear = {};
function gearMat(key, make) {
  if (!gear[key]) gear[key] = make();
  return gear[key];
}
function addAccessories(model, list = []) {
  model.updateMatrixWorld(true);
  const bone = (n) => model.getObjectByName(n);
  let current = "";
  const at = (b, mesh, offset) => {
    const p = bone(b).getWorldPosition(new THREE.Vector3()).add(offset);
    mesh.position.copy(p);
    mesh.castShadow = true;
    if (!mesh.name) mesh.name = "gear-" + current;
    bone(b).attach(mesh);
    return mesh;
  };
  const std = (hex, rough = 0.7, extra = {}) => gearMat(hex + rough, () => new THREE.MeshStandardMaterial({ color: hex, roughness: rough, ...extra }));
  for (const item of list) {
    const kind = typeof item === "string" ? item : item.kind;
    const color = item.color;
    current = kind;
    if (kind === "backpack") {
      const g = new THREE.Group();
      const body = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.4, 0.14), std(color || "#24324a", 0.85));
      const pocket = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.16, 0.05), std(color || "#24324a", 0.9));
      pocket.position.set(0, -0.09, -0.08);
      const top = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.3, 10, 1, false, 0, Math.PI), std(color || "#24324a", 0.85));
      top.rotation.z = Math.PI / 2;
      top.position.y = 0.2;
      g.add(body, pocket, top);
      for (const sx of [-0.1, 0.1]) {
        const strap = new THREE.Mesh(new THREE.BoxGeometry(0.045, 0.42, 0.015), std("#15181d", 0.8));
        strap.position.set(sx, 0.02, 0.17);
        strap.rotation.x = 0.12;
        g.add(strap);
      }
      g.traverse((m) => (m.castShadow = true));
      at("Spine2", g, new THREE.Vector3(0, -0.12, -0.17));
    } else if (kind === "sling") {
      // office bag on a strap across the chest, resting on the hip
      const bag = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.26, 0.34), std(color || "#2a201a", 0.6));
      at("Hips", bag, new THREE.Vector3(-0.2, 0.02, 0.02));
      const strap = new THREE.Mesh(new THREE.BoxGeometry(0.035, 0.75, 0.012), std("#1a1a1a", 0.7));
      strap.rotation.z = 0.62;
      at("Spine2", strap, new THREE.Vector3(0.0, -0.05, 0.13));
    } else if (kind === "glasses") {
      const m = gearMat("frame", () => new THREE.MeshStandardMaterial({ color: "#151515", roughness: 0.3, metalness: 0.4 }));
      const g = new THREE.Group();
      for (const sx of [-0.033, 0.033]) {
        const ring = new THREE.Mesh(new THREE.TorusGeometry(0.022, 0.0035, 6, 18), m);
        ring.position.x = sx;
        g.add(ring);
      }
      const bridge = new THREE.Mesh(new THREE.BoxGeometry(0.022, 0.004, 0.004), m);
      g.add(bridge);
      for (const sx of [-0.056, 0.056]) {
        const arm = new THREE.Mesh(new THREE.BoxGeometry(0.004, 0.004, 0.1), m);
        arm.position.set(sx, 0, -0.05);
        g.add(arm);
      }
      at("Head", g, new THREE.Vector3(0, 0.085, 0.092));
    } else if (kind === "helmet") {
      // the open-face helmet (helmet.js), worn with the strap fastened under the chin
      const h = makeHelmet({ color: color || "#1b1d22", accent: item.accent || "#c8202a", detail: !item.lite });
      h.strap(true);
      h.group.name = "gear-helmet";
      h.group.userData.helmet = h;
      at("Head", h.group, new THREE.Vector3(0, 0.072, 0.004));
    } else if (kind === "polocollar") {
      // A polo T-shirt's knitted collar, folded down over a short stand, open at the front over a
      // two-button placket. Built round the base of the neck in the resting pose and carried by
      // the upper chest.
      const mat = std(color || "#141416", 0.9, { side: THREE.DoubleSide });
      const neck = bone("Neck").getWorldPosition(new THREE.Vector3());
      const chest = bone("Spine2").getWorldPosition(new THREE.Vector3());
      const base = neck.clone().lerp(chest, 0.18); // where the collar sits on the neck
      const g = new THREE.Group();
      const ring = (r, y, a) => new THREE.Vector3(Math.sin(a) * r * 1.05, y, Math.cos(a) * r * 0.95);
      const strip = (rows) => {
        const pos = [];
        const idx = [];
        const N = 28;
        for (let i = 0; i <= N; i++) {
          // from the front left round the back to the front right, leaving the opening at the front
          const a = 0.38 + (i / N) * (Math.PI * 2 - 0.76);
          rows.forEach(([r, y], j) => {
            // the collar points: the fall comes forward and down at the front
            const front = Math.max(0, Math.cos(a)) ** 3;
            const p = ring(r + (j > 1 ? 0.012 * front : 0), y - (j > 1 ? 0.018 * front : 0), a);
            pos.push(p.x, p.y, p.z);
          });
        }
        const R = rows.length;
        for (let i = 0; i < N; i++) for (let j = 0; j < R - 1; j++) {
          const q = i * R + j;
          idx.push(q, q + R, q + 1, q + 1, q + R, q + R + 1);
        }
        const geo = new THREE.BufferGeometry();
        geo.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
        geo.setIndex(idx);
        geo.computeVertexNormals();
        return new THREE.Mesh(geo, mat);
      };
      // stand: up the neck 3 cm; fall: folded back down and out to rest on the shirt
      g.add(strip([[0.079, -0.01], [0.081, 0.03], [0.088, 0.035], [0.125, -0.012]]));
      // placket: a strip down the front with two buttons
      const placket = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.12, 0.004), mat);
      placket.position.set(0, -0.07, 0.097);
      placket.rotation.x = -0.18;
      g.add(placket);
      const btn = std("#e8e6e0", 0.4);
      for (const y of [-0.045, -0.095]) {
        const b = new THREE.Mesh(new THREE.CylinderGeometry(0.0055, 0.0055, 0.003, 10).rotateX(Math.PI / 2), btn);
        b.position.set(0, y + 0.005, 0.1 - (y + 0.045) * 0.18);
        g.add(b);
      }
      g.traverse((m) => (m.castShadow = true));
      g.position.copy(base);
      g.name = "gear-polocollar";
      bone("Spine2").attach(g);
    } else if (kind === "cap") {
      const crown = new THREE.Mesh(new THREE.SphereGeometry(0.115, 16, 8, 0, Math.PI * 2, 0, Math.PI * 0.5), std(color || "#a52a22", 0.8));
      crown.scale.set(1, 0.7, 1.08);
      at("Head", crown, new THREE.Vector3(0, 0.135, -0.005));
      const peak = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.012, 16, 1, false, -Math.PI / 2, Math.PI), std(color || "#a52a22", 0.8));
      peak.scale.set(1, 1, 0.75);
      at("Head", peak, new THREE.Vector3(0, 0.13, 0.08));
    } else if (kind === "lanyard") {
      const card = new THREE.Mesh(new THREE.BoxGeometry(0.055, 0.085, 0.004), std("#f2f2f2", 0.5));
      at("Spine2", card, new THREE.Vector3(0, -0.12, 0.15));
      const tape = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.012, 0.004), std(color || "#1e5fb4", 0.6));
      at("Spine2", tape, new THREE.Vector3(0, -0.06, 0.145));
    } else if (kind === "cup") {
      // a small clay or paper tea cup in the right hand
      const cup = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.022, 0.07, 10), std(item.clay ? "#a4552e" : "#f1ece2", 0.8));
      cup.rotation.z = Math.PI / 2;
      at("RightHand", cup, new THREE.Vector3(-0.06, -0.035, 0.03));
    } else if (kind === "phone") {
      const ph = new THREE.Mesh(new THREE.BoxGeometry(0.075, 0.009, 0.15), std("#101114", 0.25, { metalness: 0.5 }));
      at("RightHand", ph, new THREE.Vector3(-0.08, -0.03, 0.02));
    } else if (kind === "glass") {
      // the small tea glass of a street stall, half full
      const gl = new THREE.Mesh(new THREE.CylinderGeometry(0.026, 0.02, 0.08, 10), gearMat("teaglass", () => new THREE.MeshPhysicalMaterial({ color: "#b0703a", roughness: 0.1, transmission: 0.5, thickness: 0.02, transparent: true, opacity: 0.85 })));
      gl.rotation.z = Math.PI / 2;
      at("RightHand", gl, new THREE.Vector3(-0.06, -0.035, 0.03));
    } else if (kind === "packet") {
      // a packet of crisps or biscuits
      const pk = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.15, 0.11), std(color || "#d8262c", 0.35));
      at("RightHand", pk, new THREE.Vector3(-0.07, -0.05, 0.03));
    } else if (kind === "softdrink") {
      const bt = new THREE.Group();
      const body = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.15, 10), gearMat("cola", () => new THREE.MeshStandardMaterial({ color: "#2a1208", roughness: 0.15 })));
      const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.028, 0.07, 8), gearMat("cola", () => null));
      neck.position.y = 0.11;
      const label = new THREE.Mesh(new THREE.CylinderGeometry(0.031, 0.031, 0.05, 10), std(color || "#c8151b", 0.5));
      bt.add(body, neck, label);
      bt.rotation.z = Math.PI / 2;
      at("RightHand", bt, new THREE.Vector3(-0.08, -0.04, 0.03));
    } else if (kind === "note") {
      // a folded currency note
      const nt = new THREE.Mesh(new THREE.BoxGeometry(0.004, 0.07, 0.13), std(color || "#c58aa0", 0.8));
      at("RightHand", nt, new THREE.Vector3(-0.09, -0.03, 0.02));
    } else if (kind === "carrybag") {
      // cloth shopping bag in the left hand
      const bag = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.3, 0.1), std(color || "#d9c28a", 0.95));
      at("LeftHand", bag, new THREE.Vector3(0.12, -0.22, 0.0));
    } else if (kind === "folder") {
      const f = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.02, 0.32), std(color || "#2a5aa0", 0.6));
      at("LeftHand", f, new THREE.Vector3(0.1, -0.03, 0.0));
    } else if (kind === "towel") {
      // the cloth over a shopkeeper's shoulder
      const t = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.42, 0.02), std(color || "#d24a3a", 0.95));
      at("Spine2", t, new THREE.Vector3(0.14, 0.02, 0.06));
    }
  }
}

// ---------------------------------------------------------------------------------------------
// Facial expressions for bodies with face bones. Values are millimetres of movement from rest
// (jaw: radians, lids: 0 open .. 1 shut, negative = eyes wide).
//   cornerOut/Up: mouth corners; upperLip/lowerLip: lips apart; pucker/pout: lips forward;
//   cheek: cheeks raised; puff; browIn/browOut: inner and outer brows up; browPinch: drawn together;
//   browL/browR, cornerUpL/R, cornerOutL/R: one side only; nose: wrinkled up; sneer; squint: lower lid up.
const FACE_KEYS = ["cornerOut", "cornerUp", "cornerOutL", "cornerOutR", "cornerUpL", "cornerUpR", "upperLip", "lowerLip", "pucker", "pout", "cheek", "puff", "browIn", "browOut", "browPinch", "browL", "browR", "nose", "sneer", "squint", "lids", "jaw"];
export const EXPRESSIONS = {
  neutral: {},
  softSmile: { cornerOut: 2.2, cornerUp: 1.6, cheek: 1.2, squint: 0.4 },
  smile: { cornerOut: 3.6, cornerUp: 2.8, cheek: 2.4, squint: 0.9, upperLip: 0.5 },
  grin: { cornerOut: 4.6, cornerUp: 3.4, cheek: 3, squint: 1.3, upperLip: 1.4, lowerLip: 1.2, jaw: 0.03 },
  laugh: { cornerOut: 4.8, cornerUp: 3.8, cheek: 3.4, squint: 1.8, upperLip: 1.8, lowerLip: 2, jaw: 0.13, browOut: 1, lids: 0.35 },
  smirkLeft: { cornerOutL: 3, cornerUpL: 2.6, cheek: 0.6, browL: 1 },
  smirkRight: { cornerOutR: 3, cornerUpR: 2.6, cheek: 0.6, browR: 1 },
  amused: { cornerOut: 2.6, cornerUp: 2, cheek: 1.6, browIn: 1.2, browOut: 1.6, squint: 0.5 },
  polite: { cornerOut: 1.6, cornerUp: 1, browIn: 0.8, browOut: 0.8 },
  surprised: { browIn: 4, browOut: 4.2, lids: -0.3, jaw: 0.1, lowerLip: 1.2 },
  curious: { browL: 3.2, browIn: 0.6, cornerUpR: 0.6, lids: -0.1 },
  skeptical: { browR: 3.4, browPinch: 1, cornerOutL: 1.2, cornerUp: -0.6, squint: 0.6 },
  frown: { cornerUp: -2.2, cornerOut: -0.6, browIn: -1.6, browPinch: 1.6, pout: 0.8 },
  annoyed: { browIn: -2.4, browOut: 0.4, browPinch: 2.2, cornerUp: -1.2, squint: 1, nose: 0.6 },
  angry: { browIn: -3.2, browOut: 0.8, browPinch: 2.8, cornerUp: -1.6, upperLip: 0.8, nose: 1.2, squint: 1.2, lids: -0.1 },
  sad: { browIn: 2.6, browOut: -1, browPinch: 1.4, cornerUp: -2.4, pout: 1.2, lids: 0.2 },
  worried: { browIn: 2.8, browPinch: 1.8, cornerUp: -1, cornerOut: 0.8, lids: -0.12 },
  tired: { lids: 0.42, browIn: -0.4, browOut: -0.8, cornerUp: -0.6, jaw: 0.015 },
  yawn: { jaw: 0.24, lowerLip: 2.4, upperLip: 1.4, lids: 0.8, browIn: 1.6, browOut: 1, cornerOut: -1 },
  bored: { lids: 0.3, cornerUp: -0.8, cornerOutL: 0.8, browOut: -0.5, puff: 0.6 },
  concentrating: { browIn: -1.4, browPinch: 2, squint: 1.2, pucker: 0.8, cornerOut: -0.6 },
  thinking: { browL: 1.8, browPinch: 0.8, cornerOutR: 1.8, cornerUpR: 0.6, pucker: 0.6, squint: 0.4 },
  squinting: { squint: 2.2, lids: 0.3, browIn: -1.2, browPinch: 1.2, cheek: 1.4, cornerOut: 1 },
  disgust: { nose: 2.2, sneer: 1.6, upperLip: 1.4, browIn: -1.6, browPinch: 1.4, cornerUp: -1.2, squint: 1 },
  blowing: { pucker: 3.2, cornerOut: -1.8, puff: 1.6, browIn: 0.6 },
  relief: { cornerOut: 1.6, cornerUp: 1, lids: 0.5, browIn: 1.2, browOut: 0.8, jaw: 0.03, lowerLip: 0.6 },
  pleading: { browIn: 3, browPinch: 1, cornerOut: 1.4, cornerUp: 0.6, lids: -0.1 },
  proud: { cornerOut: 1.8, cornerUp: 1.4, browOut: 1.2, lids: 0.15, pout: 0.5 },
};
export const EXPRESSION_NAMES = Object.keys(EXPRESSIONS);

let kitPromise = null;
/** Loads the body and its animations once. */
export function loadCharacterKit(renderer) {
  if (!kitPromise) kitPromise = buildKit(renderer);
  return kitPromise;
}

const gltfLoader = new GLTFLoader();
let animsPromise = null;
const CRASH_CLIPS = []; // the fall is procedural now (hero.applyTip); the Mixamo clips came out crooked on this rig
const loadAnims = () =>
  (animsPromise ||= (async () => {
    const a = await gltfLoader.loadAsync("/models/anims.glb");
    await Promise.all(
      CRASH_CLIPS.map(async (n) => {
        try {
          const g = await gltfLoader.loadAsync(`/models/crash/${n}.glb`);
          const c = g.animations[0];
          if (c) {
            c.name = n;
            a.animations.push(c);
          }
        } catch (e) {
          console.warn("crash clip missing", n, e);
        }
      }),
    );
    return a;
  })());

async function buildKit(renderer) {
  const [avatar, anims] = await Promise.all([gltfLoader.loadAsync("/models/avatar.glb"), loadAnims()]);
  const model = avatar.scene;
  const maxAniso = renderer.capabilities.getMaxAnisotropy();
  model.traverse((o) => {
    if (!o.isMesh) return;
    o.castShadow = true;
    o.receiveShadow = true;
    o.frustumCulled = false; // animated meshes move outside their resting bounds
    for (const key of ["map", "normalMap", "roughnessMap", "metalnessMap"]) if (o.material[key]) o.material[key].anisotropy = maxAniso;
    o.material.envMapIntensity = 0.8;
    if (o.material.name === "Wolf3D_Headwear" || o.material.name === "Wolf3D_Beard") o.visible = false; // the model wears a cowboy hat
    if (o.material.name === "Wolf3D_Teeth") o.castShadow = false;
  });
  return prepareBody(model, anims, { hair: true, kind: "rpm" });
}


/**
 * The TechnoVerse avatars (models/avatars/avatar_tiu.glb, avatar_sof.glb): one body with its polo, trousers,
 * shoes, hair and eyes as separate meshes, on the same Mixamo-named skeleton as the animations, with
 * eyeBlink / jawOpen / mouthSmile shape keys. The polo and its prints are part of the file.
 */
const avatarCache = {};
export function loadAvatarBody(renderer, url) {
  return (avatarCache[url] ||= (async () => {
    const [g, anims] = await Promise.all([gltfLoader.loadAsync(url), loadAnims()]);
    const model = g.scene;
    const maxAniso = Math.min(8, renderer.capabilities.getMaxAnisotropy());
    model.traverse((o) => {
      if (!o.isMesh) return;
      o.castShadow = true;
      o.receiveShadow = true;
      o.frustumCulled = false;
      // Parts nobody sees from a third-person camera cost two skinned draws each (view and sun shadow): drop them.
      if (/^(Underwear|Teeth|Tongue|EyeShadow|EyeTearLine)$/.test(o.name)) { o.visible = false; o.castShadow = false; return; }
      // The file's sheen/specular extensions make physical materials (a much heavier shader on an iGPU): plain standard ones look the same at this distance.
      if (o.material.isMeshPhysicalMaterial) {
        const p = o.material;
        const s = new THREE.MeshStandardMaterial({ name: p.name, color: p.color, map: p.map, normalMap: p.normalMap, normalScale: p.normalScale, roughness: p.roughness, roughnessMap: p.roughnessMap, metalness: 0, alphaMap: p.alphaMap, transparent: p.transparent, opacity: p.opacity, alphaTest: p.alphaTest, side: p.side, depthWrite: p.depthWrite });
        o.material = s;
      }
      const m = o.material;
      for (const key of ["map", "normalMap", "roughnessMap"]) if (m[key]) m[key].anisotropy = maxAniso;
      m.envMapIntensity = 0.7;
      if (m.name === "HairCap" || m.name === "HairStrands") {
        m.alphaTest = 0.4;
        m.transparent = false;
        m.side = THREE.DoubleSide;
        o.castShadow = false;
      }
      if (m.alphaMode === "BLEND" || m.transparent) m.depthWrite = false;
      if (!/^(Body|Polo_|Trousers|Shoes|HairCap)/.test(o.name)) o.castShadow = false;
      if (/^Decal_/.test(o.name)) { o.castShadow = false; m.polygonOffset = true; m.polygonOffsetFactor = -2; }
      if (o.name === "Teeth" || o.name === "Tongue") o.castShadow = false;
    });
    return prepareBody(model, anims, { hair: false, kind: "tv" });
  })());
}

// Rocketbox bodies (3ds Max "Biped" rig) renamed to the animation's (Mixamo) names.
const RB_NAMES = { "Bip01 Pelvis": "Hips", "Bip01 Spine": "Spine", "Bip01 Spine1": "Spine1", "Bip01 Spine2": "Spine2", "Bip01 Neck": "Neck", "Bip01 Head": "Head", "Bip01 LEye": "LeftEye", "Bip01 REye": "RightEye" };
for (const [side, S] of [["L", "Left"], ["R", "Right"]]) {
  Object.assign(RB_NAMES, {
    [`Bip01 ${side} Clavicle`]: `${S}Shoulder`,
    [`Bip01 ${side} UpperArm`]: `${S}Arm`,
    [`Bip01 ${side} Forearm`]: `${S}ForeArm`,
    [`Bip01 ${side} Hand`]: `${S}Hand`,
    [`Bip01 ${side} Thigh`]: `${S}UpLeg`,
    [`Bip01 ${side} Calf`]: `${S}Leg`,
    [`Bip01 ${side} Foot`]: `${S}Foot`,
    [`Bip01 ${side} Toe0`]: `${S}ToeBase`,
  });
  ["Thumb", "Index", "Middle", "Ring", "Pinky"].forEach((finger, i) => {
    RB_NAMES[`Bip01 ${side} Finger${i}`] = `${S}Hand${finger}1`;
    RB_NAMES[`Bip01 ${side} Finger${i}1`] = `${S}Hand${finger}2`;
    RB_NAMES[`Bip01 ${side} Finger${i}2`] = `${S}Hand${finger}3`;
  });
}
/**
 * One of the crowd's bodies: a Microsoft Rocketbox avatar (photographic textures, eyelid and jaw
 * bones), prepared by tools/rocketbox/convert.py. Bones are renamed and the legs and shoulders
 * re-hung from the hips and upper chest, as in the animations, keeping the bind pose exactly.
 */
export async function loadCrowdBody(renderer, url) {
  const [g, anims] = await Promise.all([gltfLoader.loadAsync(url), loadAnims()]);
  const model = g.scene;
  const maxAniso = renderer.capabilities.getMaxAnisotropy();
  model.traverse((o) => {
    const n = o.name.replace(/_/g, " "); // the loader writes "Bip01_Pelvis" for "Bip01 Pelvis"
    if (RB_NAMES[n]) o.name = RB_NAMES[n];
    if (!o.isMesh) return;
    o.castShadow = true;
    o.receiveShadow = true;
    o.frustumCulled = false;
    for (const key of ["map", "normalMap", "roughnessMap"]) if (o.material[key]) o.material[key].anisotropy = maxAniso;
    o.material.envMapIntensity = 0.7;
    if (o.material.name === "hair") {
      o.material.alphaTest = 0.4;
      o.material.side = THREE.DoubleSide;
      o.castShadow = false;
    }
  });
  const by = (n) => model.getObjectByName(n);
  model.updateMatrixWorld(true);
  for (const [child, parent] of [["LeftUpLeg", "Hips"], ["RightUpLeg", "Hips"], ["LeftShoulder", "Spine2"], ["RightShoulder", "Spine2"]]) by(parent).attach(by(child));
  // face +z like the other body
  model.updateMatrixWorld(true);
  const head = by("Head").getWorldPosition(new THREE.Vector3());
  const eyes = by("LeftEye").getWorldPosition(new THREE.Vector3()).add(by("RightEye").getWorldPosition(new THREE.Vector3())).multiplyScalar(0.5);
  model.rotation.y = -Math.atan2(eyes.x - head.x, eyes.z - head.z);
  model.updateMatrixWorld(true);
  return prepareBody(model, anims, { hair: false, kind: "rocketbox" });
}

/**
 * Makes one crowd person's clothes their own, so no two people in the street look the same even
 * when they share a body: the shirt or top is re-coloured (its hue turned and tinted, folds and
 * print kept), the trousers or skirt tinted separately, and skin is left untouched (skin is found
 * by its colour). v: { hue (radians), sat, top: [r, g, b], bottom: [r, g, b] }.
 */
// ---------------------------------------------------------------------------------------------
// The polo shirts (tools/polo/polo_make.py): real garments, not paint. Each is a mesh of its own, with
// a collar, placket, buttons, ribbed cuffs and hem, and the prints as separate decals, skinned to the
// same skeleton as the Rocketbox body so it moves with every animation.
//   reboot: black, Reboot Reality on the back (event edition)   sof: black, School of the Future
//   tiu:    white and navy on the diagonal, red t on the chest
const POLOS = ["reboot", "sof", "tiu"];
const poloCache = {};
export function loadPolo(variant) {
  const v = POLOS.includes(variant) ? variant : "tiu";
  return (poloCache[v] ||= gltfLoader.loadAsync(`/models/polo/polo_${v}.glb`).catch((e) => {
    console.warn("polo shirt missing", v, e);
    return null;
  }));
}
const boneKey = (n) => RB_NAMES[n.replace(/_/g, " ")] || n;
// The body's own photographed T-shirt must not show through the cloth. Where the polo covers the torso
// the body's skin is not drawn (the neck, arms and hands stay). Measured in metres from the feet, on a
// 1.75 m body, as in dressRocketboxShirt.
function hideBodyShirt(model) {
  model.traverse((o) => {
    if (!o.isSkinnedMesh || o.material.name !== "body") return;
    const bindPos = (name) => {
      const i = o.skeleton.bones.findIndex((b) => b.name === name);
      const v = new THREE.Vector3();
      if (i >= 0) new THREE.Matrix4().copy(o.skeleton.boneInverses[i]).invert().decompose(v, new THREE.Quaternion(), new THREE.Vector3());
      return v;
    };
    if (!o.geometry.boundingBox) o.geometry.computeBoundingBox();
    const head = bindPos("Head");
    const feet = bindPos("LeftFoot").add(bindPos("RightFoot")).multiplyScalar(0.5);
    const up = head.clone().sub(feet).normalize();
    const eye = bindPos("LeftEye").add(bindPos("RightEye")).multiplyScalar(0.5);
    const fwd = eye.clone().sub(head);
    fwd.addScaledVector(up, -fwd.dot(up)).normalize();
    const left = new THREE.Vector3().crossVectors(up, fwd).normalize();
    let lowest = Infinity;
    let highest = -Infinity;
    const pos = o.geometry.attributes.position;
    const t = new THREE.Vector3();
    for (let i = 0; i < pos.count; i += 7) {
      t.fromBufferAttribute(pos, i);
      const h = t.dot(up);
      lowest = Math.min(lowest, h);
      highest = Math.max(highest, h);
    }
    const scale = 1.75 / (highest - lowest);
    const centre = head.clone().addScaledVector(up, -head.dot(up));
    const m = o.material;
    m.onBeforeCompile = (sh) => {
      Object.assign(sh.uniforms, { uHUp: { value: up }, uHLeft: { value: left }, uHMid: { value: centre }, uHFloor: { value: lowest }, uHScale: { value: scale } });
      sh.vertexShader = sh.vertexShader
        .replace("#include <common>", "#include <common>\nvarying vec3 vHide;\nuniform vec3 uHUp; uniform vec3 uHLeft; uniform vec3 uHMid; uniform float uHFloor; uniform float uHScale;")
        .replace("#include <begin_vertex>", "#include <begin_vertex>\nvec3 hrel = position - uHMid;\nvHide = vec3(dot(hrel, uHLeft), dot(position, uHUp) - uHFloor, 0.0) * uHScale;");
      sh.fragmentShader = sh.fragmentShader
        .replace("#include <common>", "#include <common>\nvarying vec3 vHide;")
        .replace("#include <map_fragment>", "#include <map_fragment>\nif (vHide.y > 1.0 && vHide.y < 1.56 && abs(vHide.x) < 0.2 && !(vHide.y > 1.47 && abs(vHide.x) < 0.075)) discard;");
    };
    m.customProgramCacheKey = () => "hide-shirt";
    m.needsUpdate = true;
  });
}
function attachPolo(model, gltf) {
  hideBodyShirt(model);
  let body = null;
  model.traverse((o) => {
    if (o.isSkinnedMesh && !body && o.material.name === "body") body = o;
  });
  if (!body) return;
  const index = new Map(body.skeleton.bones.map((b, i) => [b.name, i]));
  gltf.scene.traverse((o) => {
    if (!o.isSkinnedMesh) return;
    const geo = o.geometry;
    if (!geo.userData.remapped) {
      const to = o.skeleton.bones.map((b) => index.get(boneKey(b.name)) ?? 0);
      // The garment was exported from the same body in another coordinate frame. One bone's bind pose in
      // both skeletons gives the frame change; apply it to the cloth (positions and normals).
      const gi = o.skeleton.bones.findIndex((b) => boneKey(b.name) === "Hips");
      if (gi >= 0) {
        const T = new THREE.Matrix4().copy(body.skeleton.boneInverses[to[gi]]).invert().multiply(o.skeleton.boneInverses[gi]);
        geo.applyMatrix4(T);
      }
      const si = geo.attributes.skinIndex;
      for (let i = 0; i < si.array.length; i++) si.array[i] = to[si.array[i]];
      geo.userData.remapped = true;
    }
    const mats = Array.isArray(o.material) ? o.material : [o.material];
    for (const m of mats) {
      m.envMapIntensity = 0.5;
      m.side = THREE.DoubleSide; // the collar and cuffs are single sheets folded over: seen from both sides
      if (m.name && m.name.startsWith("decal_")) {
        m.transparent = true;
        m.depthWrite = false;
        m.polygonOffset = true;
        m.polygonOffsetFactor = -2;
      }
    }
    const mesh = new THREE.SkinnedMesh(geo, o.material);
    mesh.name = "polo-" + o.name;
    mesh.position.copy(body.position);
    mesh.quaternion.copy(body.quaternion);
    mesh.scale.copy(body.scale);
    mesh.castShadow = true;
    mesh.frustumCulled = false;
    body.parent.add(mesh);
    mesh.bind(body.skeleton, body.bindMatrix);
  });
}

/**
 * The player's shirt on a photographic (Rocketbox) body that wears a short-sleeved collared shirt:
 * the shirt is re-dyed and printed, keeping the folds, collar, placket and seams of the original
 * photo texture, and leaving skin and trousers alone.
 *   "reboot": black pique, School of the Future print on the left chest, the big print on the back
 *   "tiu":    navy and off-white split on the diagonal, red TIU badge on the left chest
 * Positions are taken in the body's resting pose and measured in metres from the feet (wearer's
 * left +x, forward +z), whatever axes the model came with.
 */
function dressRocketboxShirt(model, shirt = "tiu") {
  const pr = rebootPrints();
  let axes = null;
  model.traverse((o) => {
    if (!o.isSkinnedMesh || o.material.name !== "body") return;
    const bindPos = (name) => {
      const i = o.skeleton.bones.findIndex((b) => b.name === name);
      const v = new THREE.Vector3();
      if (i >= 0) new THREE.Matrix4().copy(o.skeleton.boneInverses[i]).invert().decompose(v, new THREE.Quaternion(), new THREE.Vector3());
      return v;
    };
    if (!o.geometry.boundingBox) o.geometry.computeBoundingBox();
    const bb = o.geometry.boundingBox;
    const head = bindPos("Head");
    const feet = bindPos("LeftFoot").add(bindPos("RightFoot")).multiplyScalar(0.5);
    const up = head.clone().sub(feet).normalize();
    const eye = bindPos("LeftEye").add(bindPos("RightEye")).multiplyScalar(0.5);
    const fwd = eye.clone().sub(head);
    fwd.addScaledVector(up, -fwd.dot(up)).normalize();
    const left = new THREE.Vector3().crossVectors(up, fwd).normalize(); // wearer's left
    // the ground under the feet along `up`, and metres per model unit (the body is about 1.75 m)
    let lowest = Infinity;
    let highest = -Infinity;
    const pos = o.geometry.attributes.position;
    const tmp = new THREE.Vector3();
    for (let i = 0; i < pos.count; i += 7) {
      tmp.fromBufferAttribute(pos, i);
      const h = tmp.dot(up);
      lowest = Math.min(lowest, h);
      highest = Math.max(highest, h);
    }
    const scale = 1.75 / (highest - lowest);
    axes = { up, lowest, scale, eye: eye.dot(up) };
    const centre = head.clone().addScaledVector(up, -head.dot(up)); // the body's midline
    const m = o.material.clone();
    m.onBeforeCompile = (sh) => {
      Object.assign(sh.uniforms, {
        uUp: { value: up },
        uFwd: { value: fwd },
        uLeft: { value: left },
        uMid: { value: centre },
        uFloor: { value: lowest },
        uScale: { value: scale },
        uFront: { value: pr.front },
        uBack: { value: pr.back },
        uSleeve: { value: pr.sleeve },
        uReboot: { value: shirt === "reboot" ? 1 : 0 },
      });
      sh.vertexShader = sh.vertexShader
        .replace("#include <common>", "#include <common>\nvarying vec3 vBody;\nvarying float vSide;\nvarying float vFace;\nuniform vec3 uUp; uniform vec3 uFwd; uniform vec3 uLeft; uniform vec3 uMid; uniform float uFloor; uniform float uScale;")
        .replace("#include <begin_vertex>", "#include <begin_vertex>\nvec3 rel = position - uMid;\nvBody = vec3(dot(rel, uLeft), dot(position, uUp) - uFloor, dot(rel, uFwd)) * uScale;\nvSide = dot(normal, uLeft);\nvFace = dot(normal, uFwd);");
      sh.fragmentShader = sh.fragmentShader
        .replace("#include <common>", "#include <common>\nvarying vec3 vBody;\nvarying float vSide;\nvarying float vFace;\nuniform sampler2D uFront; uniform sampler2D uBack; uniform sampler2D uSleeve; uniform int uReboot;")
        .replace(
          "#include <map_fragment>",
          `#include <map_fragment>
          {
            vec3 c = diffuseColor.rgb;
            vec3 s = pow(max(c, vec3(0.0)), vec3(0.4545));
            float Y = dot(s, vec3(0.299, 0.587, 0.114));
            float cb = 0.5 - 0.169 * s.r - 0.331 * s.g + 0.5 * s.b;
            float cr = 0.5 + 0.5 * s.r - 0.419 * s.g - 0.081 * s.b;
            float skin = smoothstep(0.29, 0.33, cb) * (1.0 - smoothstep(0.48, 0.52, cb)) * smoothstep(0.52, 0.55, cr) * (1.0 - smoothstep(0.66, 0.7, cr)) * smoothstep(0.12, 0.2, Y);
            // the shirt: above the belt (about 1.0 m on a 1.75 m body), not skin, not the head
            float shirtK = smoothstep(0.99, 1.02, vBody.y) * (1.0 - smoothstep(1.72, 1.76, vBody.y)) * (1.0 - skin);
            if (abs(vBody.x) > 0.22 && vBody.y < 1.25) shirtK = 0.0; // forearms and wrists (a watch) are not shirt
            // the chest and back below the neckline are all shirt, whatever colour the old print was
            if (abs(vBody.x) < 0.2 && vBody.y < 1.46 && vBody.y > 1.0) shirtK = 1.0;
            // folds and seams of the original, as light and shade on the new colour
            // only a little of the photo's light and shade, so its own printed graphic does not show through
            float shade = 0.82 + 0.18 * clamp(Y / 0.12, 0.0, 1.6);
            vec3 cloth;
            if (uReboot == 1) {
              cloth = vec3(0.02, 0.02, 0.022) * shade;
              if (vBody.z > 0.02 && vFace > 0.3) {
                vec2 uv = vec2((vBody.x - 0.03) / 0.105, (vBody.y - 1.43) / 0.032);
                if (uv.x > 0.0 && uv.x < 1.0 && uv.y > 0.0 && uv.y < 1.0) { vec4 p = texture2D(uFront, uv); cloth = mix(cloth, p.rgb * 0.85, p.a); }
              }
              if (vBody.z < -0.02 && vFace < -0.3) {
                vec2 uv = vec2((0.11 - vBody.x) / 0.22, (vBody.y - 1.08) / 0.399);
                if (uv.x > 0.0 && uv.x < 1.0 && uv.y > 0.0 && uv.y < 1.0) { vec4 p = texture2D(uBack, uv); cloth = mix(cloth, p.rgb * 0.85, p.a); }
              }
              // sleeve print on the outside of the wearer's right sleeve (seen from that side, u runs forward)
              if (vBody.x < -0.16 && vSide < -0.45) {
                vec2 uv = vec2((vBody.z + 0.0375) / 0.075, (vBody.y - 1.31) / 0.04);
                if (uv.x > 0.0 && uv.x < 1.0 && uv.y > 0.0 && uv.y < 1.0) { vec4 p = texture2D(uSleeve, uv); cloth = mix(cloth, p.rgb * 0.85, p.a); }
              }
            } else {
              vec3 navy = vec3(0.012, 0.018, 0.05);
              vec3 offWhite = vec3(0.8, 0.78, 0.74);
              // diagonal from the wearer's right shoulder down to the left hip
              float side = dot(vBody.xy - vec2(-0.075, 1.45), vec2(0.897, 0.441));
              cloth = mix(navy, offWhite, smoothstep(-0.004, 0.004, side)) * shade;
              vec2 badge = vec2(vBody.x - 0.088, vBody.y - 1.38);
              if (vBody.z > 0.02 && length(badge) < 0.032) cloth = vec3(0.6, 0.02, 0.03);
            }
            // skin a shade warmer and browner, as on the reference (a Bengali student)
            vec3 tone = mix(c, c * vec3(0.84, 0.7, 0.58), skin);
            diffuseColor.rgb = mix(tone, cloth, shirtK);
          }`,
        );
    };
    m.customProgramCacheKey = () => "rb-shirt";
    o.material = m;
  });
  // black hair and a matching skin tone on the face (the student in the reference sheet)
  model.traverse((o) => {
    if (!o.isMesh) return;
    if (o.material.name === "hair") o.material.color.setRGB(0.16, 0.14, 0.13);
    if (o.material.name === "skin_head") {
      // the face and scalp share one picture: skin gets the warmer tone, the painted hair goes black
      const m = o.material.clone();
      m.onBeforeCompile = (sh) => {
        sh.uniforms.uUp = { value: axes ? axes.up : new THREE.Vector3(0, 1, 0) };
        sh.uniforms.uBrow = { value: axes ? axes.eye + 0.065 / axes.scale : 1e9 };
        sh.vertexShader = sh.vertexShader.replace("#include <common>", "#include <common>\nvarying float vH;\nuniform vec3 uUp;").replace("#include <begin_vertex>", "#include <begin_vertex>\nvH = dot(position, uUp);");
        sh.fragmentShader = sh.fragmentShader.replace("#include <common>", "#include <common>\nvarying float vH;\nuniform float uBrow;").replace(
          "#include <map_fragment>",
          `#include <map_fragment>
          {
            vec3 c = diffuseColor.rgb;
            vec3 s = pow(max(c, vec3(0.0)), vec3(0.4545));
            float Y = dot(s, vec3(0.299, 0.587, 0.114));
            float cb = 0.5 - 0.169 * s.r - 0.331 * s.g + 0.5 * s.b;
            float cr = 0.5 + 0.5 * s.r - 0.419 * s.g - 0.081 * s.b;
            float skin = smoothstep(0.29, 0.33, cb) * (1.0 - smoothstep(0.48, 0.52, cb)) * smoothstep(0.52, 0.55, cr) * (1.0 - smoothstep(0.66, 0.7, cr)) * smoothstep(0.2, 0.3, Y);
            vec3 hair = vec3(dot(c, vec3(0.333))) * vec3(0.32, 0.29, 0.27);
            // above the brow, anything darker than forehead skin is hair
            float isHair = max(1.0 - skin, step(uBrow, vH) * (1.0 - smoothstep(0.4, 0.52, Y)));
            diffuseColor.rgb = mix(c * vec3(0.84, 0.7, 0.58), hair, isHair);
          }`,
        );
      };
      m.customProgramCacheKey = () => "rb-head-student";
      o.material = m;
    }
  });
  // some of these bodies carry their T-shirt graphic on the hair layer (cut-out cards): drop
  // anything on that layer below the neck (1.5 m on a 1.75 m body, in the resting pose)
  if (!axes) return;
  model.traverse((o) => {
    if (!o.isSkinnedMesh || o.material.name !== "hair") return;
    const m = o.material.clone();
    m.onBeforeCompile = (sh) => {
      sh.uniforms.uUp = { value: axes.up };
      sh.uniforms.uNeck = { value: axes.lowest + 1.5 / axes.scale };
      sh.vertexShader = sh.vertexShader.replace("#include <common>", "#include <common>\nvarying float vH;\nuniform vec3 uUp;").replace("#include <begin_vertex>", "#include <begin_vertex>\nvH = dot(position, uUp);");
      sh.fragmentShader = sh.fragmentShader.replace("#include <common>", "#include <common>\nvarying float vH;\nuniform float uNeck;").replace("#include <alphatest_fragment>", "#include <alphatest_fragment>\nif (vH < uNeck) discard;");
    };
    m.customProgramCacheKey = () => "rb-hair-cut";
    o.material = m;
  });
}

export function varyBody(c, v) {
  const model = c.model;
  model.traverse((o) => {
    if (!o.isSkinnedMesh || o.material.name !== "body") return;
    // the waist, in the mesh's own (bind) space, which may not be y-up (the Rocketbox bodies come
    // from 3ds Max): the long axis of the body, pointing toward the head; the belt sits at about
    // 57% of the height
    if (!o.geometry.boundingBox) o.geometry.computeBoundingBox();
    const bb = o.geometry.boundingBox;
    const size = bb.getSize(new THREE.Vector3());
    const ax = size.x >= size.y && size.x >= size.z ? "x" : size.y >= size.z ? "y" : "z";
    const hi = o.skeleton.bones.findIndex((b) => b.name === "Head");
    const headAt = new THREE.Vector3();
    if (hi >= 0) new THREE.Matrix4().copy(o.skeleton.boneInverses[hi]).invert().decompose(headAt, new THREE.Quaternion(), new THREE.Vector3());
    const mid = (bb.min[ax] + bb.max[ax]) / 2;
    const sign = headAt[ax] >= mid ? 1 : -1;
    const axis = new THREE.Vector3();
    axis[ax] = sign;
    const H = size[ax];
    const waist = sign > 0 ? bb.min[ax] + 0.57 * H : -(bb.max[ax] - 0.57 * H);
    // turning the hue: a rotation about the grey axis, with the saturation scaled
    const k = Math.cos(v.hue);
    const sn = Math.sin(v.hue);
    const third = 1 / 3;
    const r3 = Math.sqrt(third);
    const rot = new THREE.Matrix3().set(
      k + (1 - k) * third, third * (1 - k) - r3 * sn, third * (1 - k) + r3 * sn,
      third * (1 - k) + r3 * sn, k + third * (1 - k), third * (1 - k) - r3 * sn,
      third * (1 - k) - r3 * sn, third * (1 - k) + r3 * sn, k + third * (1 - k),
    );
    const m = o.material.clone();
    m.onBeforeCompile = (sh) => {
      sh.uniforms.uRot = { value: rot };
      sh.uniforms.uSat = { value: v.sat ?? 1 };
      sh.uniforms.uTop = { value: new THREE.Vector3(...v.top) };
      sh.uniforms.uBot = { value: new THREE.Vector3(...v.bottom) };
      sh.uniforms.uWaist = { value: waist };
      sh.uniforms.uAxis = { value: axis };
      sh.uniforms.uBand = { value: H * 0.012 };
      sh.vertexShader = sh.vertexShader.replace("#include <common>", "#include <common>\nvarying float vRestY;\nuniform vec3 uAxis;").replace("#include <begin_vertex>", "#include <begin_vertex>\nvRestY = dot(position, uAxis);");
      sh.fragmentShader = sh.fragmentShader
        .replace("#include <common>", "#include <common>\nvarying float vRestY;\nuniform mat3 uRot; uniform float uSat; uniform vec3 uTop; uniform vec3 uBot; uniform float uWaist; uniform float uBand;")
        .replace(
          "#include <map_fragment>",
          `#include <map_fragment>
          {
            vec3 c = diffuseColor.rgb;
            vec3 s = pow(max(c, vec3(0.0)), vec3(0.4545));
            float Y = dot(s, vec3(0.299, 0.587, 0.114));
            float cb = 0.5 - 0.169 * s.r - 0.331 * s.g + 0.5 * s.b;
            float cr = 0.5 + 0.5 * s.r - 0.419 * s.g - 0.081 * s.b;
            // skin: warm and moderately saturated (Cb 0.30-0.50, Cr 0.53-0.68 in YCbCr)
            float skin = smoothstep(0.29, 0.33, cb) * (1.0 - smoothstep(0.48, 0.52, cb)) * smoothstep(0.52, 0.55, cr) * (1.0 - smoothstep(0.66, 0.7, cr)) * smoothstep(0.12, 0.2, Y);
            float grey = dot(c, vec3(0.3333));
            vec3 turned = max(vec3(0.0), uRot * c);
            turned = mix(vec3(grey), turned, uSat);
            float upper = smoothstep(uWaist - uBand, uWaist + uBand, vRestY);
            vec3 cloth = mix(c * uBot, turned * uTop, upper);
            diffuseColor.rgb = mix(cloth, c, skin);
          }`,
        );
    };
    m.customProgramCacheKey = () => "varied-body";
    o.material = m;
  });
}

function prepareBody(model, anims, { hair, kind }) {
  // ---------- convert the animations to this skeleton ----------
  model.updateMatrixWorld(true);
  anims.scene.updateMatrixWorld(true);
  const sourceBones = new Map();
  anims.scene.traverse((o) => sourceBones.set(cleanName(o.name), o));
  // Resting position and rotation of every bone, from the skin's bind pose.
  function restPose(root, fromNodes = false) {
    const pos = new Map();
    const rot = new Map();
    root.traverse((o) => {
      if (!o.isSkinnedMesh || fromNodes) return;
      o.skeleton.bones.forEach((bone, i) => {
        if (pos.has(bone)) return;
        const p = new THREE.Vector3();
        const q = new THREE.Quaternion();
        new THREE.Matrix4().copy(o.skeleton.boneInverses[i]).invert().decompose(p, q, new THREE.Vector3());
        pos.set(bone, p);
        rot.set(bone, q);
      });
    });
    return {
      rot: (o) => (rot.get(o) || o.getWorldQuaternion(new THREE.Quaternion())).clone(),
      pos: (o) => (pos.get(o) || o.getWorldPosition(new THREE.Vector3())).clone(),
    };
  }
  const src = restPose(anims.scene);
  // the crowd's bodies keep their skin in a z-up space of their own; their bones as they stand in
  // the scene are the true resting pose
  const dst = restPose(model, kind === "rocketbox");
  const childToward = (bone, lookup) => {
    const want = POINTS_AT[cleanName(bone.name)];
    const kids = bone.children.filter((c) => c.isBone);
    return want ? lookup(want) : kids.length === 1 ? kids[0] : null;
  };
  // Constant correction for one bone: undo the source's resting rotation, swing the avatar's bone to
  // point the way the source's does (arms down vs arms out), then apply the avatar's resting rotation.
  function correctionOf(source, target) {
    const c = src.rot(source).invert();
    const sChild = source.isBone && childToward(source, (n) => sourceBones.get(n));
    const tChild = target.isBone && childToward(target, (n) => model.getObjectByName(n));
    if (sChild && tChild) {
      const sDir = src.pos(sChild).sub(src.pos(source)).normalize();
      const tDir = dst.pos(tChild).sub(dst.pos(target)).normalize();
      c.multiply(new THREE.Quaternion().setFromUnitVectors(tDir, sDir));
    }
    return c.multiply(dst.rot(target));
  }
  const corrections = new Map();
  const correction = (source, target) => {
    if (!corrections.has(target)) corrections.set(target, correctionOf(source, target));
    return corrections.get(target);
  };
  const hips = model.getObjectByName("Hips");
  const hipsRest = hips.position.clone();
  const clips = {};
  let idleHipsY = null;
  for (const clip of anims.animations) {
    if (!["idle", "walk", "run", "agree", "headShake", ...CRASH_CLIPS].includes(clip.name)) continue;
    const crash = CRASH_CLIPS.includes(clip.name);
    const tracks = [];
    for (const track of clip.tracks) {
      const [boneName, prop] = track.name.split(".");
      const name = cleanName(boneName);
      const target = model.getObjectByName(name);
      const source = sourceBones.get(name);
      if (!target || !source) continue;
      if (prop === "quaternion") {
        const own = correction(source, target);
        const parentInv = correction(source.parent, target.parent).clone().invert();
        const values = new Float32Array(track.values.length);
        const q = new THREE.Quaternion();
        for (let i = 0; i < values.length; i += 4) {
          q.fromArray(track.values, i).premultiply(parentInv).multiply(own).normalize();
          q.toArray(values, i);
        }
        tracks.push(new THREE.QuaternionKeyframeTrack(`${name}.quaternion`, track.times, values));
      } else if (prop === "position" && name === "Hips") {
        // Keep the up-and-down and side-to-side sway of the hips, but not the travel forward.
        const parentQuat = source.parent.getWorldQuaternion(new THREE.Quaternion());
        const parentScale = source.parent.getWorldScale(new THREE.Vector3());
        const mean = new THREE.Vector3();
        for (let i = 0; i < track.values.length; i += 3) mean.add(new THREE.Vector3().fromArray(track.values, i));
        mean.multiplyScalar(3 / track.values.length);
        if (crash) {
          // keep the height the clip really has (lying is low), drop the travel: the game moves the body
          if (idleHipsY === null) {
            const idle = anims.animations.find((c) => c.name === "idle");
            const it = idle && idle.tracks.find((t) => /Hips\.position$/.test(t.name));
            idleHipsY = 0;
            if (it) { for (let i = 1; i < it.values.length; i += 3) idleHipsY += it.values[i]; idleHipsY /= it.values.length / 3; }
          }
          mean.set(track.values[0], idleHipsY, track.values[2]);
        }
        const v = new THREE.Vector3();
        const values = new Float32Array(track.values.length);
        const toParent = hips.parent.getWorldQuaternion(new THREE.Quaternion()).invert();
        const parentSize = hips.parent.getWorldScale(new THREE.Vector3());
        const modelTurn = model.getWorldQuaternion(new THREE.Quaternion());
        const fromModel = modelTurn.clone().invert();
        for (let i = 0; i < values.length; i += 3) {
          v.fromArray(track.values, i).sub(mean).multiply(parentScale).applyQuaternion(parentQuat);
          v.applyQuaternion(fromModel); // in the body's own frame: x sideways, y up, z forward
          v.z = 0;
          v.y -= 0.02;
          v.applyQuaternion(modelTurn).applyQuaternion(toParent).divide(parentSize);
          values[i] = hipsRest.x + v.x;
          values[i + 1] = hipsRest.y + v.y;
          values[i + 2] = hipsRest.z + v.z;
        }
        tracks.push(new THREE.VectorKeyframeTrack("Hips.position", track.times, values));
      }
    }
    clips[clip.name] = new THREE.AnimationClip(clip.name, clip.duration, tracks);
  }
  // Talking gestures (a nod, a shake of the head) should move the head and shoulders, not the legs.
  for (const name of ["agree", "headShake"]) {
    if (!clips[name]) continue;
    clips[name].tracks = clips[name].tracks.filter((t) => /^(Spine|Spine1|Spine2|Neck|Head)\./.test(t.name));
  }

  // Hair: the model ships with a cap instead of hair (hidden above). This grows a short, natural
  // cut from the scalp itself: the head's own surface above a real hairline (forehead, temples,
  // sideburns, round the ears, down to the nape) is lifted off the skin by a few millimetres, fuller
  // on top and close-cropped at the sides and back, and textured with fine strands that run back
  // from the forehead and down from the crown. The hair moves with the head because it uses the
  // same skin and bones.
  if (hair) {
    const headMesh = model.getObjectByName("Wolf3D_Head");
    if (headMesh) headMesh.parent.add(makeHair(headMesh));
  }

  // How fast each clip "walks": the speed at which the planted foot travels backward under the body.
  const saved = [];
  model.traverse((o) => o.isBone && saved.push([o, o.position.clone(), o.quaternion.clone()]));
  const mixer = new THREE.AnimationMixer(model);
  const actions = {};
  for (const [name, clip] of Object.entries(clips)) {
    actions[name] = mixer.clipAction(clip);
    actions[name].play();
  }
  const legs = ["LeftFoot", "RightFoot"].map((n) => model.getObjectByName(n));
  function strideSpeed(name) {
    const clip = clips[name];
    const action = actions[name];
    for (const a of Object.values(actions)) a.setEffectiveWeight(a === action ? 1 : 0);
    const samples = 60;
    const step = clip.duration / samples;
    const track = legs.map(() => []);
    const p = new THREE.Vector3();
    for (let i = 0; i <= samples; i++) {
      action.time = step * i;
      mixer.update(0);
      model.updateMatrixWorld(true);
      legs.forEach((foot, k) => {
        foot.getWorldPosition(p);
        track[k].push([p.y, p.z]);
      });
    }
    // a foot counts as planted while it is within a few centimetres of its lowest point
    const speeds = [];
    for (const samplesOfFoot of track) {
      const lowest = Math.min(...samplesOfFoot.map((v) => v[0]));
      for (let i = 1; i < samplesOfFoot.length; i++) {
        if (samplesOfFoot[i][0] < lowest + 0.05 && samplesOfFoot[i - 1][0] < lowest + 0.05) speeds.push(Math.abs(samplesOfFoot[i][1] - samplesOfFoot[i - 1][1]) / step);
      }
    }
    speeds.sort((x, y) => y - x);
    const top = speeds.slice(0, Math.max(2, Math.ceil(speeds.length * 0.5)));
    return Math.max(0.5, top[Math.floor(top.length / 2)] || 1);
  }
  const walkSpeed = strideSpeed("walk");
  const runSpeed = strideSpeed("run");
  mixer.stopAllAction();
  mixer.uncacheRoot(model);
  for (const [b, p, q] of saved) {
    b.position.copy(p);
    b.quaternion.copy(q);
  }
  model.updateMatrixWorld(true);
  return { template: model, clips, walkSpeed, runSpeed, hairTex: {}, kind };
}

/** The main player's character (and every other player's): the TIU polo uniform. */
export async function loadHero(renderer) {
  const kit = await loadCharacterKit(renderer);
  return makeCharacter(kit, { uniform: true });
}

/**
 * One person.
 * opts.uniform: the TIU polo (players). Otherwise opts.look:
 *   { top: {pattern, color, color2, untucked}, bottom: {pattern, color, color2}, shoes, skin (0.6..1.1),
 *     hair: black|brown|grey|pepper|none, beard: colour or null }
 * opts.gear: accessories ("backpack", "sling", "glasses", "helmet", "cap", "lanyard", "cup", "phone",
 *   "carrybag", "folder", "towel" or {kind, color}).
 * opts.height: 1 = 1.85 m tall, opts.build: width (1 = as modelled).
 * opts.lite: skips placing the feet on uneven ground (people on flat pavements).
 */
export function makeCharacter(kit, opts = {}) {
  const model = cloneSkinned(kit.template);
  const faces = []; // meshes that carry the face controls
  const lidMeshes = [];
  const jawMeshes = [];
  model.traverse((o) => {
    if (!o.isMesh) return;
    o.material = o.material.clone();
    if (o.morphTargetDictionary && "mouthSmile" in o.morphTargetDictionary) faces.push(o);
    if (o.morphTargetDictionary && "eyeBlink" in o.morphTargetDictionary) lidMeshes.push(o); // the TechnoVerse avatar: body, lashes
    if (o.morphTargetDictionary && "jawOpen" in o.morphTargetDictionary) jawMeshes.push(o); // body, teeth, tongue
  });
  const look = opts.look || {};
  const rocketbox = kit.kind === "rocketbox";
  const tv = kit.kind === "tv"; // the TechnoVerse avatar: already dressed
  if (tv) {
    // the polo is the one this avatar was made in; the swatch tints nothing here
  } else if (opts.uniform && rocketbox) {
    if (opts.polo) attachPolo(model, opts.polo);
    else dressRocketboxShirt(model, opts.shirt);
  }
  else if (opts.uniform) dressInUniform(model, opts.shirt);
  else if (!rocketbox && !tv) dressInLook(model, look);
  // hair colour, or none
  const hairMesh = rocketbox || tv ? null : model.getObjectByName("Hair");
  if (hairMesh) {
    const tone = opts.uniform ? "black" : look.hair || "black";
    if (tone === "none") hairMesh.visible = false;
    else if (tone !== "black") {
      if (!kit.hairTex[tone]) kit.hairTex[tone] = hairTexture(tone);
      hairMesh.material.map = kit.hairTex[tone];
    }
  }
  addAccessories(model, opts.gear);
  const height = opts.height || 1;
  const build = opts.build || 1;
  model.scale.set(height * build, height, height * Math.sqrt(build));

  // A holder around the model lets the whole figure lean without disturbing the skeleton. The model
  // faces +z, the game's "forward" is -z, so the holder is turned around.
  const holder = new THREE.Group();
  model.position.y = 0.03; // soles sat level with the ground layers, which sit up to 2 cm above the physics floor: lift 3 cm
  holder.add(model);
  holder.rotation.y = Math.PI;

  const clips = kit.clips;
  const mixer = new THREE.AnimationMixer(model);
  const actions = {};
  for (const [name, clip] of Object.entries(clips)) {
    actions[name] = mixer.clipAction(clip);
    actions[name].play();
    actions[name].setEffectiveWeight(name === "idle" ? 1 : 0);
  }
  actions.walk.timeScale = actions.run.timeScale = 0; // their timing is driven by ground speed below
  for (const n of CRASH_CLIPS) if (actions[n]) { actions[n].timeScale = 0; actions[n].setEffectiveWeight(0); }
  // nobody idles in step with anyone else
  actions.idle.time = Math.random() * clips.idle.duration;
  actions.idle.timeScale = 0.85 + Math.random() * 0.3;
  if (actions.agree) actions.agree.time = Math.random() * clips.agree.duration;
  if (actions.headShake) actions.headShake.time = Math.random() * clips.headShake.duration;
  const walkSpeed = kit.walkSpeed * height;
  const runSpeed = kit.runSpeed * height;

  const bone = (n) => model.getObjectByName(n);
  const hips = bone("Hips");
  const legs = [
    { up: bone("LeftUpLeg"), knee: bone("LeftLeg"), foot: bone("LeftFoot"), lift: 0 },
    { up: bone("RightUpLeg"), knee: bone("RightLeg"), foot: bone("RightFoot"), lift: 0 },
  ];
  const spine = bone("Spine");
  const chest = bone("Spine1");
  const arms = [bone("LeftArm"), bone("RightArm")];
  const forearms = [bone("LeftForeArm"), bone("RightForeArm")];
  const hands = [bone("LeftHand"), bone("RightHand")];
  const handRest = hands.map((h) => h.quaternion.clone()); // the wrist straight, as in the bind pose
  const neck = bone("Neck");
  const head = bone("Head");
  const eyes = [bone("LeftEye"), bone("RightEye")].filter(Boolean);
  const eyeRest = eyes.map((e) => e.quaternion.clone());
  // eyelids and jaw, where the body has bones for them (the crowd's bodies do)
  const lids = [["Bip01_LEyeBlinkTop", "Bip01_LEyeBlinkBottom"], ["Bip01_REyeBlinkTop", "Bip01_REyeBlinkBottom"]]
    .map(([t, b]) => [bone(t), bone(b)])
    .filter(([t, b]) => t && b)
    .map(([t, b]) => ({ top: t, rest: t.position.clone(), shut: b.position.clone().lerp(t.position, 0.3) }));
  const jaw = bone("Bip01_MJaw");
  let jawAxis = null;
  const jawRest = jaw ? jaw.quaternion.clone() : null;
  if (jaw && eyes.length === 2) {
    model.updateMatrixWorld(true);
    const left = eyes[0].getWorldPosition(new THREE.Vector3()).sub(eyes[1].getWorldPosition(new THREE.Vector3())).normalize();
    jawAxis = left.applyQuaternion(jaw.getWorldQuaternion(new THREE.Quaternion()).invert()).normalize();
  }
  let blinkT = 1 + Math.random() * 4;
  let blinkAge = 1;
  // Face bones: corners of the mouth, lips, cheeks, brows, nose. An expression moves them by a
  // few millimetres from rest, in the head's own directions (out to the side, up, forward).
  const face = {};
  const faceAxes = {};
  if (jaw && eyes.length === 2) {
    const inv = head.getWorldQuaternion(new THREE.Quaternion()).invert();
    const left = eyes[0].getWorldPosition(new THREE.Vector3()).sub(eyes[1].getWorldPosition(new THREE.Vector3())).normalize();
    const up = new THREE.Vector3(0, 1, 0);
    const fwd = new THREE.Vector3().crossVectors(left, up).normalize();
    const size = head.getWorldScale(new THREE.Vector3()).x || 1;
    faceAxes.left = left.clone().applyQuaternion(inv).divideScalar(size);
    faceAxes.up = up.clone().applyQuaternion(inv).divideScalar(size);
    faceAxes.fwd = fwd.clone().applyQuaternion(inv).divideScalar(size);
    for (const n of ["LMouthCorner", "RMouthCorner", "MUpperLip", "LUpperlip", "RUpperlip", "MBottomLip", "LMouthBottom", "RMouthBottom", "LCheek", "RCheek", "LInnerEyebrow", "RInnerEyebrow", "MMiddleEyebrow", "LOuterEyebrow", "ROuterEyebrow", "MNose", "LEyeBlinkBottom", "REyeBlinkBottom"]) {
      const bn = bone("Bip01_" + n);
      if (bn) face[n] = { bone: bn, rest: bn.position.clone() };
    }
  }
  const fx = Object.fromEntries(FACE_KEYS.map((key) => [key, 0])); // the face as it is now
  let exprName = "neutral";
  let exprBias = FACE_KEYS.map(() => (Math.random() - 0.5) * 0.25); // nobody's face is quite symmetrical or quite like another's
  const moveFace = (name, out, up, fwd = 0) => {
    const f = face[name];
    if (!f) return;
    const side = name[0] === "L" ? 1 : name[0] === "R" ? -1 : 0;
    f.bone.position.copy(f.rest).addScaledVector(faceAxes.left, out * side * 0.002).addScaledVector(faceAxes.up, up * 0.002).addScaledVector(faceAxes.fwd, fwd * 0.002);
  };
  // ---------- per-frame state ----------
  let phase = Math.random(); // position in the stride, 0..1
  let pelvisDrop = 0;
  let lean = 0;
  let lookYaw = 0;
  let lookPitch = 0;
  let smile = 0.1;
  let mouth = 0;
  let glance = { yaw: 0, pitch: 0, until: 0 };
  let clock = 0;
  // jump pose, eased toward its targets each frame (radians, except crouch)
  const jp = { spine: 0, arms: 0, elbows: 0, thigh: 0, knee: 0, toes: 0 };
  let leapPhase = null; // stride position frozen at take-off for running leaps
  let sitting = false;
  let nodW = 0;
  let shakeW = 0;
  const gw = { sip: 0, hold: 0, phone: 0, text: 0, stir: 0, wipe: 0, serve: 0, behind: 0, crossed: 0, knees: 0, scan: 0, pocket: 0, take: 0, pour: 0, wave: 0, point: 0, scratch: 0, brow: 0, eat: 0, hip: 0, watch: 0, strap: 0, chin: 0, count: 0, show: 0, namaste: 0, stretch: 0, salute: 0, bottle: 0, lean: 0, handshake: 0 };

  const v1 = new THREE.Vector3();
  const v2 = new THREE.Vector3();
  const v3 = new THREE.Vector3();
  const v4 = new THREE.Vector3();
  const qa = new THREE.Quaternion();
  const qb = new THREE.Quaternion();
  const qc = new THREE.Quaternion();
  const UP = new THREE.Vector3(0, 1, 0);

  // Turn a bone by a rotation given in world space.
  function turnInWorld(b, worldRotation) {
    b.parent.getWorldQuaternion(qa);
    b.getWorldQuaternion(qb);
    b.quaternion.copy(qa.invert()).multiply(worldRotation).multiply(qb);
    b.updateMatrixWorld(true);
  }
  // Two-bone leg solver: moves the ankle to `target` by rotating the hip and bending the knee in the
  // plane it already bends in. The knee works as a hinge and the leg never stretches past its length.
  function solveLeg(leg, target) {
    solveChain(leg.up, leg.knee, leg.foot, target);
  }
  // The same two-bone solver for any limb: root (hip/shoulder), hinge (knee/elbow), end (ankle/wrist).
  function solveChain(upBone, midBone, endBone, target, pole = null) {
    const leg = { up: upBone, knee: midBone, foot: endBone };
    const a = leg.up.getWorldPosition(new THREE.Vector3());
    const b = leg.knee.getWorldPosition(new THREE.Vector3());
    const c = leg.foot.getWorldPosition(new THREE.Vector3());
    const footWorld = leg.foot.getWorldQuaternion(new THREE.Quaternion());
    const lab = a.distanceTo(b);
    const lcb = b.distanceTo(c);
    const lat = clamp(a.distanceTo(target), 0.05, lab + lcb - 0.004);
    const ac = v1.copy(c).sub(a).normalize();
    const ab = v2.copy(b).sub(a).normalize();
    const at = v3.copy(target).sub(a).normalize();
    const hipNow = Math.acos(clamp(ac.dot(ab), -1, 1));
    const kneeNow = Math.acos(clamp(new THREE.Vector3().copy(a).sub(b).normalize().dot(new THREE.Vector3().copy(c).sub(b).normalize()), -1, 1));
    const swing = Math.acos(clamp(ac.dot(at), -1, 1));
    const hipWant = Math.acos(clamp((lcb * lcb - lab * lab - lat * lat) / (-2 * lab * lat), -1, 1));
    const kneeWant = Math.acos(clamp((lat * lat - lab * lab - lcb * lcb) / (-2 * lab * lcb), -1, 1));
    const bendAxis = new THREE.Vector3().crossVectors(ac, ab);
    if (bendAxis.lengthSq() < 1e-6) bendAxis.set(1, 0, 0).applyQuaternion(holder.getWorldQuaternion(qa));
    bendAxis.normalize();
    const swingAxis = new THREE.Vector3().crossVectors(ac, at);
    const upWorldInv = leg.up.getWorldQuaternion(new THREE.Quaternion()).invert();
    const kneeWorldInv = leg.knee.getWorldQuaternion(new THREE.Quaternion()).invert();
    const r0 = new THREE.Quaternion().setFromAxisAngle(bendAxis.clone().applyQuaternion(upWorldInv), hipWant - hipNow);
    const r1 = new THREE.Quaternion().setFromAxisAngle(bendAxis.clone().applyQuaternion(kneeWorldInv), kneeWant - kneeNow);
    leg.up.quaternion.multiply(r0);
    if (swingAxis.lengthSq() > 1e-8) leg.up.quaternion.multiply(new THREE.Quaternion().setFromAxisAngle(swingAxis.normalize().applyQuaternion(upWorldInv), swing));
    leg.knee.quaternion.multiply(r1);
    leg.up.updateMatrixWorld(true);
    if (pole) {
      // turn the whole limb about the root-to-end line until the middle joint (elbow) points toward the pole:
      // without this the elbow keeps whatever bend the walk cycle gave it, and a raised arm folds across the face
      const A = leg.up.getWorldPosition(new THREE.Vector3());
      const B = leg.knee.getWorldPosition(new THREE.Vector3());
      const E = leg.foot.getWorldPosition(new THREE.Vector3());
      const axis = E.sub(A).normalize();
      const bp = B.sub(A);
      bp.addScaledVector(axis, -bp.dot(axis));
      const pp = new THREE.Vector3().copy(pole).sub(A);
      pp.addScaledVector(axis, -pp.dot(axis));
      if (bp.lengthSq() > 1e-8 && pp.lengthSq() > 1e-8) {
        bp.normalize();
        pp.normalize();
        const ang = Math.atan2(new THREE.Vector3().crossVectors(bp, pp).dot(axis), bp.dot(pp));
        const upW = leg.up.getWorldQuaternion(new THREE.Quaternion());
        const parentW = leg.up.parent.getWorldQuaternion(new THREE.Quaternion());
        const turned = new THREE.Quaternion().setFromAxisAngle(axis, ang).multiply(upW);
        leg.up.quaternion.copy(parentW.invert().multiply(turned));
        leg.up.updateMatrixWorld(true);
      }
    }
    // keep the foot at the angle the animation gave it
    leg.foot.quaternion.copy(leg.knee.getWorldQuaternion(qa).invert()).multiply(footWorld);
    leg.foot.updateMatrixWorld(true);
  }

  // ---------- riding a bicycle ----------
  // Seated on the saddle, hands on the grips, feet on the pedals following the cranks, trunk
  // inclined forward (more when sprinting), head up to see the road. At a stop the left foot comes
  // down to the ground.
  let riding = false;
  let standHipH = null;
  const footFlat = legs.map(() => new THREE.Quaternion());
  function ride(dt, s) {
    const r = s.ride;
    riding = true;
    actions.idle.setEffectiveWeight(1);
    actions.walk.setEffectiveWeight(0);
    actions.run.setEffectiveWeight(0);
    mixer.update(dt);
    holder.rotation.set(0, Math.PI, 0);
    holder.position.set(0, 0, 0);
    holder.parent.updateMatrixWorld(true);
    // standing pose's feet: flat, pointing forward; kept to give the feet their angle on the pedals
    legs.forEach((leg, i) => leg.foot.getWorldQuaternion(footFlat[i]));
    // how high the pelvis is when standing (measured once from the standing pose)
    hips.getWorldPosition(v1);
    if (standHipH === null) standHipH = v1.y - holder.getWorldPosition(v3).y;
    // Getting on or off: r.stand (1 standing beside the machine .. 0 seated) and r.at (the point
    // on the ground under the standing pelvis) move the pelvis between standing beside it and the
    // saddle, rising over the seat on the way (r.lift, metres).
    const standK = r.stand || 0;
    // sit: move the whole figure so the pelvis rests on the saddle
    const seat = v2.copy(r.saddle).addScaledVector(r.up, 0.085).addScaledVector(r.back, 0.03);
    if (standK > 0 && r.at) seat.lerp(v4.copy(r.at).addScaledVector(UP, standHipH), standK);
    if (r.lift) seat.addScaledVector(UP, r.lift);
    const parent = holder.parent;
    holder.position.add(parent.worldToLocal(seat.clone()).sub(parent.worldToLocal(v1.clone())));
    holder.updateMatrixWorld(true);
    const turn = (b, angle, axis = r.right) => {
      if (Math.abs(angle) > 1e-4) turnInWorld(b, qc.setFromAxisAngle(axis, angle));
    };
    // trunk forward over the bars; a sprinting rider gets lower
    // trunk forward over the bars (a sprinting rider gets lower); walking the bike back, the rider
    // sits up and looks back over the right shoulder
    const back = r.backing || 0;
    const bend = (0.42 + 0.2 * r.effort) * (1 - 0.55 * back) * (r.posture ?? 1) * (1 - standK) + (r.stoop || 0); // posture: upright on a roadster or a motorcycle; stoop: bending to reach
    turn(spine, -bend * 0.55);
    turn(chest, -bend * 0.45);
    turn(neck, bend * 0.5);
    turn(head, bend * 0.35 + 0.05);
    if (back > 0.01) {
      turn(chest, -0.35 * back, r.up); // shoulders turn a little
      turn(neck, -0.45 * back, r.up);
      turn(head, -0.5 * back, r.up);
    }
    // arms: reach forward with a soft elbow, then the wrists go to the grips
    // a hand given as `false` hangs relaxed; a point puts the wrist there (taking a helmet, the key)
    arms.forEach((arm, i) => {
      const want = i === 0 ? r.handL : r.handR;
      if (want === false) return;
      turn(arm, 1.05);
      turn(forearms[i], 0.45);
      if (want) solveChain(arm, forearms[i], hands[i], want);
      else solveChain(arm, forearms[i], hands[i], v3.copy(i === 0 ? r.gripL : r.gripR).addScaledVector(r.back, 0.05).addScaledVector(r.up, 0.02));
    });
    // legs: knees forward, ankles over the pedals (ball of the foot on the pedal)
    legs.forEach((leg, i) => {
      turn(leg.up, 1.25 * (1 - standK) + 0.15);
      turn(leg.knee, -1.5 * (1 - standK) - 0.15);
      const pedal = i === 0 ? r.pedalL : r.pedalR;
      const given = i === 0 ? r.footL : r.footR; // a foot placed by the getting-on sequence
      if (given) {
        solveChain(leg.up, leg.knee, leg.foot, given);
        leg.foot.quaternion.copy(leg.knee.getWorldQuaternion(qa).invert()).multiply(footFlat[i]);
        leg.foot.updateMatrixWorld(true);
        return;
      }
      const onPedal = v3.copy(pedal).addScaledVector(r.up, 0.075).addScaledVector(r.back, 0.07);
      if (back > 0.01) {
        // walking it back: feet on the ground either side, stepping in turn
        const ph = (r.backDist || 0) * 5.5 + (i === 0 ? 0 : Math.PI);
        const g = (i === 0 ? r.groundL : r.groundR).clone().addScaledVector(r.back, 0.14 * Math.sin(ph));
        g.addScaledVector(r.up, 0.07 * Math.max(0, Math.cos(ph)));
        onPedal.lerp(g, back);
      } else if (i === 0 && r.footDown > 0.01) onPedal.lerp(r.groundL, r.footDown);
      solveChain(leg.up, leg.knee, leg.foot, onPedal);
      // foot angle: flat, with the toes dipping a little through the down-stroke (ankling)
      leg.foot.quaternion.copy(leg.knee.getWorldQuaternion(qa).invert()).multiply(footFlat[i]);
      leg.foot.updateMatrixWorld(true);
      turn(leg.foot, -0.12 - 0.12 * Math.sin(r.crank + (i === 0 ? Math.PI : 0)));
    });
    // face: concentrating a little when sprinting
    smile += (0.15 - 0.1 * r.effort - smile) * ease(dt, 3);
    for (const f of faces) f.morphTargetInfluences[f.morphTargetDictionary.mouthSmile] = clamp(smile, 0, 1);
  }

  // ---------- sitting on a bench or stool ----------
  const fwdW = new THREE.Vector3();
  const rightW = new THREE.Vector3();
  function sitDown(sit) {
    holder.rotation.set(0, Math.PI, 0);
    holder.position.set(0, 0, 0);
    holder.parent.updateMatrixWorld(true);
    legs.forEach((leg, i) => leg.foot.getWorldQuaternion(footFlat[i]));
    model.getWorldDirection(fwdW);
    fwdW.y = 0;
    fwdW.normalize();
    rightW.crossVectors(fwdW, UP);
    // lower the pelvis onto the seat, a little back from its front edge
    hips.getWorldPosition(v1);
    const want = v2.copy(sit.seat).addScaledVector(UP, 0.1 * height).addScaledVector(fwdW, -0.05);
    const parent = holder.parent;
    holder.position.add(parent.worldToLocal(want.clone()).sub(parent.worldToLocal(v1.clone())));
    holder.updateMatrixWorld(true);
    const turn = (b, angle) => turnInWorld(b, qc.setFromAxisAngle(rightW, angle));
    turn(spine, -0.08);
    legs.forEach((leg, i) => {
      turn(leg.up, 1.35);
      turn(leg.knee, -1.45);
      const foot = v3.copy(sit.seat).addScaledVector(fwdW, (sit.reach || 0.42) * height).addScaledVector(rightW, (i === 0 ? -1 : 1) * 0.12);
      foot.y = sit.floor + 0.085 * height;
      solveChain(leg.up, leg.knee, leg.foot, foot);
      leg.foot.quaternion.copy(leg.knee.getWorldQuaternion(qa).invert()).multiply(footFlat[i]);
      leg.foot.updateMatrixWorld(true);
    });
  }

  // ---------- hands: sipping tea, a phone at the ear, stirring a pot, arms folded ----------
  // Each gesture is a place for the wrist relative to the body; the arm reaches it with the same
  // two-bone solver, so it works at any height and while walking.
  const H = new THREE.Vector3();
  const C = new THREE.Vector3();
  const P = new THREE.Vector3();
  const hand = new THREE.Vector3();
  const tgt = new THREE.Vector3();
  const sum = new THREE.Vector3();
  const pole = new THREE.Vector3();
  function gestures(dt, g) {
    let any = false;
    for (const k in gw) {
      gw[k] += ((g[k] || 0) - gw[k]) * ease(dt, 4);
      if (gw[k] > 0.01) any = true;
    }
    if (!any) return;
    model.getWorldDirection(fwdW);
    fwdW.y = 0;
    fwdW.normalize();
    rightW.crossVectors(fwdW, UP);
    head.getWorldPosition(H);
    chest.getWorldPosition(C);
    hips.getWorldPosition(P);
    const t = clock;
    const k = height;
    const reach = (side, pairs) => {
      let total = 0;
      sum.set(0, 0, 0);
      for (const [w, fill] of pairs) {
        if (w < 0.01) continue;
        fill(tgt);
        sum.addScaledVector(tgt, w);
        total += w;
      }
      if (total < 0.01) return;
      hands[side].getWorldPosition(hand);
      const blend = Math.min(1, total);
      tgt.copy(sum).multiplyScalar(1 / total);
      hand.lerp(tgt, blend);
      // where the elbow should point: down and a little out and back for most actions; out to the side, at shoulder
      // height, when the hand goes up beside the head (a wave, a salute, a stretch) or onto the hip
      const s = side === 1 ? 1 : -1;
      const up = Math.min(1, gw.wave + gw.stretch);
      const out = Math.min(1, up + gw.hip + gw.lean);
      arms[side].getWorldPosition(pole);
      pole.addScaledVector(rightW, s * (0.18 + 0.32 * out) * k).addScaledVector(UP, (-0.45 + 0.1 * up) * k).addScaledVector(fwdW, (-0.12 - 0.1 * gw.hip) * k);
      solveChain(arms[side], forearms[side], hands[side], hand, pole);
      // the wrist follows the forearm instead of hanging limp at the angle the walk cycle left it
      hands[side].quaternion.slerp(handRest[side], blend);
      hands[side].updateMatrixWorld(true);
    };
    const at = g.at || P;
    const sin = Math.sin;
    const S = (o, base, f, u, r) => o.copy(base).addScaledVector(fwdW, f * k).addScaledVector(UP, u * k).addScaledVector(rightW, r * k);
    // right hand: each entry is where the wrist goes for that action
    reach(1, [
      [gw.sip, (o) => S(o, H, 0.11, -0.13, 0.05)], // cup to the lips
      [gw.bottle, (o) => S(o, H, 0.13, -0.06, 0.05)], // bottle tipped above the mouth
      [gw.eat, (o) => S(o, H, 0.1, -0.14 - 0.1 * Math.max(0, sin(t * 2.2)), 0.03)], // snack to the mouth and back
      [gw.hold, (o) => S(o, P, 0.3, 0.24, 0.1)], // holding something at waist height
      [gw.phone, (o) => S(o, H, 0.02, -0.1, 0.1)], // phone at the ear
      [gw.text, (o) => S(o, C, 0.3, -0.12, 0.06)], // phone held to read
      [gw.show, (o) => S(o, C, 0.42, 0.02, 0.08)], // screen turned to show someone
      [gw.scan, (o) => o.copy(at).addScaledVector(UP, 0.2 + 0.015 * sin(t * 3)).addScaledVector(fwdW, -0.1)], // phone over the QR code
      [gw.pocket, (o) => S(o, P, 0.02, -0.02, 0.19)], // hand into the trouser pocket
      [gw.take, (o) => o.copy(at)], // reaching for something
      [gw.pour, (o) => o.copy(at).addScaledVector(UP, 0.26 + 0.02 * sin(t * 5)).addScaledVector(rightW, 0.03)], // kettle tipped over the glass
      [gw.stir, (o) => o.copy(at).addScaledVector(fwdW, Math.cos(t * 4.5) * 0.06).addScaledVector(rightW, sin(t * 4.5) * 0.06).addScaledVector(UP, 0.16)],
      [gw.wipe, (o) => o.copy(at).addScaledVector(rightW, sin(t * 2.3) * 0.22).addScaledVector(fwdW, Math.cos(t * 1.7) * 0.06).addScaledVector(UP, 0.06)],
      [gw.serve, (o) => S(o, C, 0.48, -0.12, 0.1)], // handing something across
      [gw.count, (o) => S(o, C, 0.27, -0.2 + 0.015 * sin(t * 7), 0.03)], // thumbing through notes
      [gw.wave, (o) => S(o, H, 0.05, 0.16, 0.4 + 0.08 * sin(t * 9))], // hand up beside the head, swinging
      [gw.point, (o) => (g.at ? o.copy(C).lerp(at, 0.5).addScaledVector(UP, 0.05) : S(o, C, 0.55, 0.05, 0.2))],
      [gw.scratch, (o) => S(o, H, -0.09, 0.07 + 0.012 * sin(t * 11), 0.07)], // back of the head
      [gw.brow, (o) => S(o, H, 0.11, 0.07, 0.07 * sin(t * 2.6))], // wiping the forehead
      [gw.chin, (o) => S(o, H, 0.1, -0.2, 0.02)], // hand at the chin, thinking
      [gw.hip, (o) => S(o, P, -0.02, 0.06, 0.21)],
      [gw.strap, (o) => S(o, C, 0.13, 0.12, -0.12)], // shifting the bag strap on the left shoulder
      [gw.salute, (o) => S(o, H, 0.07, 0.03, 0.14)],
      [gw.namaste, (o) => S(o, C, 0.2, 0.02, 0.012)],
      // a handshake: the hand goes out to meet the other person's (g.at, between the two) and pumps gently
      [gw.handshake, (o) => (g.at ? o.copy(at).addScaledVector(rightW, 0.02).addScaledVector(UP, 0.03 * sin(t * 8.5)) : S(o, C, 0.42, -0.2 + 0.03 * sin(t * 8.5), 0.06))],
      [gw.stretch, (o) => S(o, H, -0.02, 0.28, 0.2)],
      [gw.lean, (o) => o.copy(at).addScaledVector(rightW, 0.18)],
      [gw.behind, (o) => S(o, P, -0.17, 0, 0.04)],
      [gw.crossed, (o) => S(o, C, 0.2, -0.13, -0.1)],
      [gw.knees, (o) => legs[1].knee.getWorldPosition(o).addScaledVector(UP, 0.07).addScaledVector(fwdW, -0.12)],
    ]);
    // left hand
    reach(0, [
      [gw.watch, (o) => S(o, C, 0.26, -0.02, -0.02)], // wrist turned up to read the time
      [gw.count, (o) => S(o, C, 0.27, -0.22, -0.05)], // the notes are held in the left hand
      [gw.pour, (o) => o.copy(at).addScaledVector(UP, 0.05).addScaledVector(rightW, -0.02)], // steadying the glass
      [gw.hip, (o) => S(o, P, -0.02, 0.06, -0.21)],
      [gw.namaste, (o) => S(o, C, 0.2, 0.02, -0.012)],
      [gw.stretch, (o) => S(o, H, -0.02, 0.28, -0.2)],
      [gw.lean, (o) => o.copy(at).addScaledVector(rightW, -0.18)],
      [gw.behind, (o) => S(o, P, -0.17, 0, -0.03)],
      [gw.crossed, (o) => S(o, C, 0.22, -0.09, 0.11)],
      [gw.knees, (o) => legs[0].knee.getWorldPosition(o).addScaledVector(UP, 0.07).addScaledVector(fwdW, -0.12)],
      [gw.text * 0.8, (o) => S(o, C, 0.3, -0.15, -0.02)],
    ]);
  }

  const gearOf = (kind) => model.getObjectByName("gear-" + kind);
  return {
    model: holder,
    height,
    hasFace: Boolean(jawAxis),
    /** show or hide something carried (added with opts.gear) */
    showGear(kind, on) {
      model.traverse((o) => {
        if (o.name === "gear-" + kind) o.visible = on;
      });
    },
    stride: { walkSpeed, runSpeed },
    /**
     * @param dt seconds since the last frame
     * @param s  speed (m/s over the ground), grounded, turnRate (radians a second), facing (radians),
     *           lookAt (world point or null), talk (0..1 mouth opening), friendly (true when someone is close),
     *           groundAt(x, z, fromY) -> height of the ground there, or null
     */
    clipDuration: (n) => (clips[n] ? clips[n].duration : 1),
    /**
     * Tip the whole body over about the hips (call after update(), every frame of a fall).
     * angle 0 = standing, PI/2 = lying; (lx, lz) = which way the head points when it is down, in the
     * parent's frame; spin = a roll about the body's long axis. The limbs stay as the idle pose has them.
     */
    applyTip({ angle, lx, lz, spin = 0, lift = 0 }) {
      const HIP = 0.95;
      const l = Math.hypot(lx, lz) || 1;
      const tilt = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(lz / l, 0, -lx / l), angle);
      holder.quaternion.copy(tilt).multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 1, 0), Math.PI + spin));
      const hipY = HIP * Math.cos(angle) + 0.21 * Math.sin(angle) + lift;
      holder.position.set(0, hipY, 0).sub(new THREE.Vector3(0, HIP, 0).applyQuaternion(tilt));
      holder.parent?.updateMatrixWorld(true);
    },
    update(dt, s) {
      clock += dt;
      if (s.pose) {
        // a scripted pose (the crash): [{ name, t (s into the clip), w }], the clips blended by weight
        if (riding || sitting) { riding = false; sitting = false; }
        for (const a of Object.values(actions)) a.setEffectiveWeight(0);
        for (const p of s.pose) {
          const a = actions[p.name];
          if (!a) continue;
          a.time = Math.min(p.t, clips[p.name].duration - 1e-3);
          a.setEffectiveWeight(p.w ?? 1);
        }
        holder.rotation.set(0, Math.PI, 0);
        holder.position.set(0, 0, 0);
        mixer.update(0);
        holder.parent?.updateMatrixWorld(true);
        return;
      }
      if (s.ride) {
        ride(dt, s);
        return;
      }
      if (riding || (sitting && !s.sit)) {
        riding = false;
        sitting = false;
        holder.position.set(0, 0, 0);
      }
      const jump = s.jump || {};
      // ---- walking and running, blended by speed ----
      const moving = smoothstep(0.1, 0.9, s.speed);
      const running = smoothstep(walkSpeed * 1.6, runSpeed * 0.85, s.speed);
      // A standing jump is two-footed: the legs come together (idle stance) rather than mid-stride.
      const together = jump.phase && jump.phase !== "land" ? 1 - (jump.run || 0) : 0;
      const stride = moving * (1 - together);
      actions.idle.setEffectiveWeight(1 - stride);
      nodW += ((s.nod || 0) - nodW) * ease(dt, 3);
      shakeW += ((s.shake || 0) - shakeW) * ease(dt, 3);
      if (actions.agree) actions.agree.setEffectiveWeight(nodW * (1 - stride));
      if (actions.headShake) actions.headShake.setEffectiveWeight(shakeW * (1 - stride));
      actions.walk.setEffectiveWeight(stride * (1 - running));
      actions.run.setEffectiveWeight(stride * running);
      const metresPerStride = THREE.MathUtils.lerp(walkSpeed * clips.walk.duration, runSpeed * clips.run.duration, running);
      const airborne = jump.phase === "air" && !s.grounded;
      let pace = s.grounded ? clamp(s.speed / metresPerStride, 0.45 / clips.walk.duration, 1.5 / clips.run.duration) : 0.25;
      if (airborne) {
        // In flight the legs hold the shape they left the ground in: a split stride off a run,
        // feet together from standing. The stride clock does not run.
        if (leapPhase === null) leapPhase = phase;
        pace = 0;
      } else leapPhase = null;
      phase = (phase + dt * pace) % 1;
      actions.walk.time = phase * clips.walk.duration;
      actions.run.time = phase * clips.run.duration;
      mixer.update(dt);

      // ---- lean into turns ----
      lean += (clamp(-s.turnRate * 0.035 * clamp(s.speed / 4, 0, 1.4), -0.16, 0.16) - lean) * ease(dt, 6);
      // body lean from the physics (leaning into speeding up and turning), a wobble while
      // staggering, and the whole body tipping about the feet when it falls
      const wob = s.stagger ? Math.sin(phase * Math.PI * 4) * 0.08 : 0;
      const down = s.down || 0;
      holder.rotation.set(-0.04 * running - (s.leanFwd || 0) * 0.6 - down, Math.PI, lean + (s.leanSide || 0) * 0.6 + wob);
      holder.position.set(0, Math.sin(down) * 0.12, 0);
      holder.parent?.updateMatrixWorld(true);
      if (s.sit) {
        sitting = true;
        sitDown(s.sit);
      }

      // ---- jumping, as a person does it ----
      // Rotations are about the body's left-right axis. Positive swings a hanging arm or thigh
      // forward; negative leans the trunk forward and points the toes.
      {
        const standing = 1 - (jump.run || 0);
        const want = { spine: 0, arms: 0, elbows: 0, thigh: 0, knee: 0, toes: 0 };
        const depth = Math.max(0.05, jump.crouch || 0);
        if (jump.phase === "prep") {
          const down = jump.t < 0.68;
          const k = clamp((jump.crouch || 0) / 0.17, 0, 1);
          want.spine = -0.5 * k * (0.4 + 0.6 * standing); // trunk folds forward over the knees
          // arms swing back on the way down, then drive forward and up with the push
          want.arms = down ? -0.85 * k * (0.3 + 0.7 * standing) : lerpN(-0.85, 1.6, smoothstep(0.68, 1, jump.t)) * (0.3 + 0.7 * standing);
          want.elbows = 0.35;
          want.toes = down ? 0 : -0.45 * smoothstep(0.75, 1, jump.t); // up onto the toes
        } else if (airborne) {
          const v0 = Math.max(0.5, jump.launchV || 3);
          const rise = clamp((s.jump.vy || 0) / v0, -1.4, 1); // 1 at take-off, 0 at the top, < 0 falling
          const nearTop = 1 - Math.min(1, Math.abs(rise));
          want.spine = -0.12;
          // arms lead the take-off forward and up, then settle lower to balance for the landing
          want.arms = (rise > 0 ? 1.2 * rise + 0.8 * nearTop : 0.8 + 0.4 * rise) * (0.35 + 0.65 * standing);
          want.elbows = 0.4;
          // knees draw up a little around the top, then the legs reach for the ground
          want.thigh = (0.55 * nearTop + (rise < 0 ? 0.25 : 0)) * standing + 0.15 * nearTop;
          want.knee = (0.95 * nearTop + (rise < 0 ? 0.35 : 0)) * standing + 0.3 * nearTop;
          want.toes = rise > 0.3 ? -0.5 * rise : 0.12; // pointed after push-off, flexed to land
        } else if (jump.phase === "land") {
          const k = clamp((jump.crouch || 0) / 0.2, 0, 1.6);
          want.spine = -0.42 * k;
          want.arms = 0.55 * k; // arms forward for balance
          want.elbows = 0.5 * k;
        }
        const rate = jump.phase === "prep" || jump.phase === "land" ? 30 : 12;
        for (const key in jp) jp[key] += (want[key] - jp[key]) * ease(dt, rate);
        const right = v1.set(1, 0, 0).applyAxisAngle(UP, s.facing).clone();
        const turn = (b, angle) => {
          if (Math.abs(angle) > 1e-3) turnInWorld(b, qc.setFromAxisAngle(right, angle));
        };
        turn(spine, jp.spine * 0.6);
        turn(chest, jp.spine * 0.4);
        arms.forEach((a, i) => {
          turn(a, jp.arms);
          turn(forearms[i], jp.elbows);
        });
        if (airborne) {
          legs.forEach((leg) => {
            turn(leg.up, jp.thigh);
            turn(leg.knee, -jp.knee);
            turn(leg.foot, jp.toes + jp.knee * 0.5);
          });
        } else if (Math.abs(jp.toes) > 0.01) legs.forEach((leg) => turn(leg.foot, jp.toes));
      }

      // ---- a scripted limb pose (the crash): rotations about the body's left-right axis, per side.
      // s.limbs = { spine, aL, aR (arms), eL, eR (elbows), tL, tR (thighs), kL, kR (knees) }; positive swings a
      // hanging arm or thigh forward, bends the knee back. Applied on top of whatever the mixer set this frame.
      if (s.limbs) {
        const L = s.limbs;
        const rightA = new THREE.Vector3(1, 0, 0).applyAxisAngle(UP, s.facing);
        const tw = (b, a) => { if (a && Math.abs(a) > 1e-3) turnInWorld(b, new THREE.Quaternion().setFromAxisAngle(rightA, a)); };
        tw(spine, (L.spine || 0) * 0.6);
        tw(chest, (L.spine || 0) * 0.4);
        tw(arms[0], L.aL); tw(arms[1], L.aR);
        tw(forearms[0], L.eL); tw(forearms[1], L.eR);
        tw(legs[0].up, L.tL); tw(legs[1].up, L.tR);
        tw(legs[0].knee, -(L.kL || 0)); tw(legs[1].knee, -(L.kR || 0));
        tw(legs[0].foot, (L.kL || 0) * 0.5); tw(legs[1].foot, (L.kR || 0) * 0.5);
        tw(neck, (L.head || 0) * 0.4); tw(head, (L.head || 0) * 0.6);
      }

      // ---- head and eyes look at people nearby ----
      let wantYaw = 0;
      let wantPitch = 0;
      let eyeYaw = 0;
      let eyePitch = 0;
      if (s.lookAt) {
        head.getWorldPosition(v1);
        const dx = s.lookAt.x - v1.x;
        const dy = s.lookAt.y - v1.y;
        const dz = s.lookAt.z - v1.z;
        const rel = wrapAngle(Math.atan2(-dx, -dz) - s.facing);
        if (Math.abs(rel) < 1.9) {
          wantYaw = clamp(rel, -1.05, 1.05); // a neck turns about 60 degrees each way
          wantPitch = clamp(Math.atan2(dy, Math.hypot(dx, dz)), -0.35, 0.4);
          eyeYaw = clamp(rel - wantYaw, -0.3, 0.3);
        }
      }
      if (clock > glance.until) glance = { yaw: (Math.random() - 0.5) * 0.24, pitch: (Math.random() - 0.5) * 0.1, until: clock + 0.7 + Math.random() * 2.2 };
      lookYaw += (wantYaw - lookYaw) * ease(dt, 4.5);
      lookPitch += (wantPitch - lookPitch) * ease(dt, 4.5);
      if (Math.abs(lookYaw) > 0.002 || Math.abs(lookPitch) > 0.002) {
        const right = v2.set(1, 0, 0).applyAxisAngle(UP, s.facing + lookYaw);
        for (const [b, share] of [[neck, 0.4], [head, 0.6]]) {
          qc.setFromAxisAngle(right, lookPitch * share).multiply(new THREE.Quaternion().setFromAxisAngle(UP, lookYaw * share));
          turnInWorld(b, qc);
        }
      }
      eyes.forEach((eye, i) => eye.quaternion.copy(eyeRest[i]));
      for (const eye of eyes) {
        const right = v2.set(1, 0, 0).applyAxisAngle(UP, s.facing + lookYaw);
        qc.setFromAxisAngle(right, eyePitch + glance.pitch).multiply(new THREE.Quaternion().setFromAxisAngle(UP, eyeYaw + glance.yaw));
        turnInWorld(eye, qc);
      }

      if (s.gesture) gestures(dt, s.gesture);
      else if (Object.values(gw).some((w) => w > 0.01)) gestures(dt, {});

      // ---- face ----
      smile += ((s.friendly ? 0.75 : 0.12) + Math.sin(clock * 0.7) * 0.04 - smile) * ease(dt, 3);
      mouth += (clamp(s.talk || 0, 0, 1) - mouth) * ease(dt, 22);
      for (const f of faces) {
        f.morphTargetInfluences[f.morphTargetDictionary.mouthSmile] = clamp(smile, 0, 1);
        if (f.morphTargetDictionary.mouthOpen !== undefined) f.morphTargetInfluences[f.morphTargetDictionary.mouthOpen] = clamp(mouth, 0, 1);
      }
      // The TechnoVerse avatar has shape keys, not face bones: blink, and a jaw that opens with speech and in yawns or surprise
      if (!jawAxis && (lidMeshes.length || jawMeshes.length)) {
        exprName = EXPRESSIONS[s.expr] ? s.expr : s.friendly ? "softSmile" : "neutral";
        const want = EXPRESSIONS[exprName];
        const kf = ease(dt, 5);
        fx.lids += ((want.lids || 0) - fx.lids) * kf;
        fx.jaw += ((want.jaw || 0) - fx.jaw) * kf;
        blinkT -= dt;
        blinkAge += dt;
        if (blinkT < 0) {
          blinkAge = 0;
          blinkT = Math.random() < 0.15 ? 0.35 : 1.8 + Math.random() * 4.5;
        }
        const blink = blinkAge < 0.07 ? blinkAge / 0.07 : blinkAge < 0.2 ? 1 - (blinkAge - 0.07) / 0.13 : 0;
        const shut = clamp(Math.max(blink, fx.lids), 0, 1);
        const open = clamp(mouth * 0.5 + fx.jaw * 3, 0, 1);
        for (const m of lidMeshes) m.morphTargetInfluences[m.morphTargetDictionary.eyeBlink] = shut;
        for (const m of jawMeshes) m.morphTargetInfluences[m.morphTargetDictionary.jawOpen] = open;
      }
      // ---- expression, blinking, and the jaw moving with speech ----
      if (jawAxis) {
        exprName = EXPRESSIONS[s.expr] ? s.expr : s.friendly ? "softSmile" : "neutral";
        const want = EXPRESSIONS[exprName];
        const kf = ease(dt, 5);
        FACE_KEYS.forEach((key, i) => {
          const target = (want[key] || 0) * (1 + exprBias[i]);
          fx[key] += (target - fx[key]) * kf;
        });
        const talkOpen = clamp(mouth, 0, 1);
        moveFace("LMouthCorner", fx.cornerOut + fx.cornerOutL, fx.cornerUp + fx.cornerUpL, -fx.cornerOut * 0.4);
        moveFace("RMouthCorner", fx.cornerOut + fx.cornerOutR, fx.cornerUp + fx.cornerUpR, -fx.cornerOut * 0.4);
        moveFace("MUpperLip", 0, fx.upperLip, fx.pucker);
        moveFace("LUpperlip", -fx.pucker * 0.6, fx.upperLip + fx.sneer * 1.2, fx.pucker * 0.5);
        moveFace("RUpperlip", -fx.pucker * 0.6, fx.upperLip, fx.pucker * 0.5);
        moveFace("MBottomLip", 0, -fx.lowerLip - talkOpen * 1.5, fx.pucker + fx.pout);
        moveFace("LMouthBottom", -fx.pucker * 0.6, -fx.lowerLip, fx.pout * 0.6);
        moveFace("RMouthBottom", -fx.pucker * 0.6, -fx.lowerLip, fx.pout * 0.6);
        moveFace("LCheek", fx.cheek * 0.4, fx.cheek, fx.puff);
        moveFace("RCheek", fx.cheek * 0.4, fx.cheek, fx.puff);
        moveFace("LInnerEyebrow", -fx.browPinch, fx.browIn + fx.browL, 0);
        moveFace("RInnerEyebrow", -fx.browPinch, fx.browIn + fx.browR, 0);
        moveFace("MMiddleEyebrow", 0, fx.browIn * 0.7 - fx.browPinch * 0.5, 0);
        moveFace("LOuterEyebrow", 0, fx.browOut + fx.browL, 0);
        moveFace("ROuterEyebrow", 0, fx.browOut + fx.browR, 0);
        moveFace("MNose", 0, fx.nose, 0);
        moveFace("LEyeBlinkBottom", 0, fx.squint, 0);
        moveFace("REyeBlinkBottom", 0, fx.squint, 0);
        blinkT -= dt;
        blinkAge += dt;
        if (blinkT < 0) {
          blinkAge = 0;
          blinkT = Math.random() < 0.15 ? 0.35 : 1.8 + Math.random() * 4.5;
        }
        const blink = blinkAge < 0.07 ? blinkAge / 0.07 : blinkAge < 0.2 ? 1 - (blinkAge - 0.07) / 0.13 : 0;
        const shut = clamp(Math.max(blink, fx.lids), -0.35, 1); // negative: eyes wide
        for (const l of lids) l.top.position.lerpVectors(l.rest, l.shut, shut);
        jaw.quaternion.copy(jawRest).multiply(qc.setFromAxisAngle(jawAxis, talkOpen * 0.2 + fx.jaw));
      }

      // ---- plant the feet on the real ground ----
      if (sitting) return;
      if (!s.grounded || !s.groundAt) {
        pelvisDrop += (0 - pelvisDrop) * ease(dt, 10);
        for (const leg of legs) leg.lift += (0 - leg.lift) * ease(dt, 10);
        return;
      }
      const baseY = holder.parent.getWorldPosition(v1).y;
      const offsets = legs.map((leg) => {
        leg.foot.getWorldPosition(v2);
        const ground = s.groundAt(v2.x, v2.z, baseY + 0.7);
        return ground === null ? 0 : clamp(ground - baseY, -0.4, 0.4);
      });
      const drop = clamp(Math.min(offsets[0], offsets[1], 0), -0.3, 0);
      pelvisDrop += (drop - pelvisDrop) * ease(dt, 12);
      // The jump's dip and landing give lower the hips; the feet stay where they stand, so the
      // knees and hips bend (solved below) instead of the whole body sinking into the ground.
      const crouch = jump.crouch || 0;
      hips.position.y += pelvisDrop - crouch;
      hips.updateMatrixWorld(true);
      legs.forEach((leg, i) => {
        const want = Math.max(0, offsets[i] - pelvisDrop + crouch);
        leg.lift += (want - leg.lift) * (crouch > 0.005 ? 1 : ease(dt, 16));
        if (leg.lift < 0.004) return;
        leg.foot.getWorldPosition(v2);
        solveLeg(leg, new THREE.Vector3(v2.x, v2.y + leg.lift, v2.z));
      });
    },
  };
}

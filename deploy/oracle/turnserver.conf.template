# coturn: relays voice when two browsers cannot connect directly.
listening-port=3478
tls-listening-port=5349
listening-ip=__PRIVATE_IP__
# Oracle VMs sit behind NAT: tell coturn its public address (public/private)
external-ip=__PUBLIC_IP__/__PRIVATE_IP__
realm=__DOMAIN__
fingerprint
lt-cred-mech
user=__TURN_USER__:__TURN_PASS__
min-port=49152
max-port=65535
# do not let the relay reach the VM itself or private networks
no-multicast-peers
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
# voice is small: cap what one session can pull
total-quota=100
bps-capacity=0
no-cli
no-tlsv1
no-tlsv1_1
